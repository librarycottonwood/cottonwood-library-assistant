# The current prototype stays local until the library creates its Sanity project.
LIBRARY_CONTENT_SOURCE=local
# Required together when LIBRARY_CONTENT_SOURCE=sanity. Never use PUBLIC_ prefixes.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2026-10-01
# Server-side read token only if the dataset is private. Never a publishing token.
SANITY_READ_TOKEN=
# Optional: validated immutable snapshot for a credential-free static build.
SANITY_SNAPSHOT_PATH=
# SANITY_WRITE_TOKEN is used only by an explicit, reviewed cms:import command.
