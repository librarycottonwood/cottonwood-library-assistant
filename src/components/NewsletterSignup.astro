---
// Old-design (SiteLayout) version of the newsletter sign-up. Same fields, endpoint, messages and
// script as src/components/site/NewsletterForm.astro, styled with the old page classes.
import TurnstileField from './TurnstileField.astro';
import { contentRepository } from '../content/repository';
import { NEWSLETTER_ENDPOINT, newsletterMailto, newsletterMessages, newsletterStatuses } from '../content/newsletter';
const { library } = await contentRepository.getHome();
const returnPath = Astro.url.pathname;
const input = 'min-h-12 w-full rounded-[3px] border border-forest bg-white px-4 py-3 text-base text-ink';
---
<section class="mt-16" aria-labelledby="newsletter-signup-heading">
  <h2 id="newsletter-signup-heading" class="card-heading">Get library news by email</h2>
  <p class="mt-3 mb-5 text-base text-muted">News, events, book sales and ways to help, delivered to your inbox. Unsubscribe at any time.</p>
  <form class="newsletter-form flex flex-col items-start gap-4" action={NEWSLETTER_ENDPOINT} method="post" aria-labelledby="newsletter-signup-heading" data-newsletter-form>
    <input type="hidden" name="return" value={returnPath} />
    <div class="grid w-full gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="newsletter-email" class="text-sm font-semibold">Email address</label>
        <input id="newsletter-email" type="email" name="email" required maxlength="254" autocomplete="email" spellcheck="false" class={input} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="newsletter-first-name" class="text-sm font-semibold">First name <span class="font-normal text-muted">(optional)</span></label>
        <input id="newsletter-first-name" type="text" name="first_name" maxlength="100" autocomplete="given-name" class={input} />
      </div>
    </div>
    <!-- Left empty by people; bots that fill it are ignored. -->
    <div class="sr-only" aria-hidden="true">
      <label for="newsletter-website">Leave this empty</label>
      <input id="newsletter-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="button button-primary">Subscribe</button>
    <div role="status">
      {newsletterStatuses.map(status => (
        <p id={`newsletter-${status}`} class="newsletter-status text-base font-semibold" data-newsletter-status={status}>
          {newsletterMessages[status]}
          {status === 'error' && <> Please <a class="text-link" href={newsletterMailto(library.email)}>email the library</a> to join.</>}
        </p>
      ))}
    </div>
    <TurnstileField />
  </form>
</section>
<script>
  import '../scripts/newsletter-form';
</script>
<style>
  /* Shown by #newsletter-<status> after a no-JavaScript submit, or by the script (data-shown). */
  .newsletter-status { display: none; }
  .newsletter-form:not([data-enhanced]) .newsletter-status:target, .newsletter-status[data-shown] { display: block; }
</style>
