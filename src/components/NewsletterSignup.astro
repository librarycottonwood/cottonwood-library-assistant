---
import signup from '../content/newsletter-signup.json';
import { checkGivebutterId } from '../content/feeds';
import { givebutterScriptSrc, sitewideGivebutterAccount } from '../content/donate';
import { contentRepository } from '../content/repository';
checkGivebutterId(signup.account, 'newsletter signup account');
checkGivebutterId(signup.widgetId, 'newsletter signup widget');
const { library } = await contentRepository.getHome();
const script = await sitewideGivebutterAccount() ? undefined : givebutterScriptSrc(signup.account);
---
<section class="mt-16" aria-labelledby="newsletter-signup-heading">
  <h2 id="newsletter-signup-heading" class="card-heading">Get library news by email</h2>
  <p class="mt-3 mb-5 text-base text-muted">News, events, book sales and ways to help, delivered to your inbox. Unsubscribe at any time.</p>
  <givebutter-widget id={signup.widgetId} account={signup.account}></givebutter-widget>
  <p class="mt-4 text-sm text-muted">Signup is handled by Givebutter. If the form does not load, <a class="text-link" href={`mailto:${library.email}?subject=Library%20newsletter`}>contact the library about its newsletter</a>.</p>
</section>
{script && <script is:inline async src={script}></script>}
<style>
  givebutter-widget { display: block; }
</style>
