---
import type { LibraryEvent } from '../content/types';
import { upcomingEvents } from '../content/feeds';
interface Props { events: LibraryEvent[]; }
const events = upcomingEvents(Astro.props.events);
const first = events[0] ? new Date(events[0].startsAt) : new Date();
const [year, month] = new Intl.DateTimeFormat('en-CA', {year:'numeric',month:'2-digit',timeZone:'America/Los_Angeles'}).format(first).split('-').map(Number);
const monthStart = new Date(Date.UTC(year, month - 1, 1));
const length = new Date(Date.UTC(year, month, 0)).getUTCDate();
const label = new Intl.DateTimeFormat('en-US', {month:'long',year:'numeric',timeZone:'UTC'}).format(monthStart);
const key = (date: Date) => new Intl.DateTimeFormat('en-CA',{year:'numeric',month:'2-digit',day:'2-digit',timeZone:'America/Los_Angeles'}).format(date);
const days = Array.from({length},(_,i)=>({number:i+1,event:events.find(e=>key(new Date(e.startsAt))===`${year}-${String(month).padStart(2,'0')}-${String(i+1).padStart(2,'0')}`)}));
---
<div class="rounded-[4px] bg-meadow p-5 sm:p-7">
  <h2 class="card-heading mb-5">{label}</h2>
  <div class="grid grid-cols-7 gap-1 text-center">
    {['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(day=><span class="py-2 text-xs font-semibold">{day}</span>)}
    {Array.from({length:monthStart.getUTCDay()},()=> <span aria-hidden="true"></span>)}
    {days.map(day=>day.event ? <a href={day.event.href} aria-label={`${label} ${day.number}: ${day.event.title}`} class="flex aspect-square items-center justify-center rounded-[3px] bg-forest font-semibold text-paper hover:bg-forest-dark">{day.number}</a> : <span class="flex aspect-square items-center justify-center text-sm">{day.number}</span>)}
  </div>
  <p class="mt-4 text-sm text-muted">Highlighted dates: upcoming book sale.</p>
</div>
