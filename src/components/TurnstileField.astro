---
// Cloudflare Turnstile bot check for the newsletter forms. Shows nothing until a site key is set in
// src/content/newsletter-signup.json (and the server only checks once TURNSTILE_SECRET_KEY is set).
// Most visitors never see it; a suspicious one gets a single checkbox.
import signup from '../content/newsletter-signup.json';
const siteKey = signup.turnstileSiteKey;
---
{siteKey && <>
  <!-- Invisible unless Cloudflare needs the checkbox, but its frame still takes several Tab stops. It stays inert (no
    Tab stops) until Turnstile says it is about to show the checkbox, and goes back to inert once that is done. -->
  <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only" data-size="flexible" data-before-interactive-callback="cottonwoodTurnstileShown" data-after-interactive-callback="cottonwoodTurnstileHidden" inert></div>
  <script is:inline>
    window.cottonwoodTurnstileShown = function () { document.querySelectorAll('.cf-turnstile').forEach(function (field) { field.inert = false; }); };
    window.cottonwoodTurnstileHidden = function () { document.querySelectorAll('.cf-turnstile').forEach(function (field) { field.inert = true; }); };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</>}
