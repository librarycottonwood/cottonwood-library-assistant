---
import ContentImage from './ContentImage.astro';
import type { LibraryImage } from '../content/types';
interface Props { title: string; href: string; image: LibraryImage; note?: string; }
const { title, href, image, note } = Astro.props;
---
<a href={href} class="card">
  <div class="card-media"><ContentImage image={image} /></div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    {note && <p class="card-text">{note}</p>}
  </div>
</a>
