---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CampaignProgress from './CampaignProgress.astro';
import { getDonateLink } from '../content/donate';
import { resolveImage } from '../content/images';
import type { HomeContent, FundraisingCampaign } from '../content/types';
interface Props { library: HomeContent['library']; campaign?: FundraisingCampaign; }
const { library, campaign } = Astro.props;
const donate = getDonateLink();
---
<aside class="flex flex-col justify-center rounded-[4px] bg-meadow p-7 sm:p-9" aria-labelledby="giving-feed-heading">
  {/* Shown here rather than replacing the page photo: every registry picture must stay rendered or the build's picture check fails. */}
  {campaign?.image ? <Image width={720} quality={70} src={resolveImage(campaign.image.key)} alt={campaign.image.alt} widths={[400, 720]} sizes="(max-width: 1023px) 100vw, 40vw" class="mb-6 aspect-[2] w-full rounded-[3px] object-cover" loading="lazy" /> : <Icon name="heart" class="mb-5 size-7" />}
  <h2 id="giving-feed-heading" class="card-heading">Make a financial gift</h2>
  {campaign ? <>
    <p class="eyebrow mt-4 text-muted">Current fundraiser</p>
    <h3 class="mt-2 text-lg font-semibold">{campaign.title}</h3>
    <p class="mt-2 text-base text-muted">{campaign.description}</p>
    <CampaignProgress campaign={campaign} />
    <a href={donate.href} class="button button-primary mt-5 self-start">{donate.label}<Icon name="external" class="size-4" /></a>
  </> : <>
    <p class="mt-3 text-base text-muted">Help keep books, programs and doors open.</p>
    {/* The fallback donate link is the library-fund page, which itself asks visitors to email; email directly from here. */}
    <a href={donate.source === 'fallback' ? `mailto:${library.email}?subject=Supporting%20the%20library` : donate.href} class="button button-primary mt-5 self-start">{donate.source === 'fallback' ? 'Email us to give' : donate.label}</a>
  </>}
  <a href={library.phoneHref} class="text-link mt-3 self-start">Call {library.phone}</a>
</aside>
