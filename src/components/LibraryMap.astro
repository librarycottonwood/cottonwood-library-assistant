---
import Icon from './Icon.astro';
import { homeContent } from '../content/seed';
const { library } = homeContent;
---
<div class="library-map" data-library-map>
  <div class="map-fallback">
    <Icon name="pin" class="size-8" />
    <p class="font-semibold">{library.address}</p>
    <p class="text-sm">{library.locality}</p>
    <a href={library.directionsUrl} class="text-link">Get directions</a>
  </div>
  <div class="map-canvas" data-map-canvas role="region" aria-label="Map showing Cottonwood Community Library on Main Street"></div>
  <span class="map-label" hidden data-map-label>Cottonwood Library</span>
</div>
<style>
.library-map{position:relative;min-height:340px;overflow:hidden;border-radius:4px;background:#e9edde}.map-fallback{min-height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}.map-canvas{position:absolute;inset:0;opacity:0;transition:opacity .3s}.map-label{position:absolute;top:18px;left:18px;background:#f8f6ef;padding:8px 12px;border-radius:3px;font-size:13px;font-weight:600;pointer-events:none}.map-canvas :global(.maplibregl-ctrl-attrib){font-size:10px}.map-canvas :global(.maplibregl-canvas){filter:saturate(.65)}
</style>
<script>
import 'maplibre-gl/dist/maplibre-gl.css';
const sections = document.querySelectorAll<HTMLElement>('[data-library-map]');
for (const section of sections) {
  const host=section.querySelector<HTMLElement>('[data-map-canvas]');
  if (!host) continue;
  const start = async () => {
    try {
      const [{Map,Marker,NavigationControl,setWorkerUrl},{default:workerUrl}] = await Promise.all([
        import('maplibre-gl'),import('maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'),
      ]);
      setWorkerUrl(workerUrl);
      const response=await fetch('https://tiles.openfreemap.org/styles/positron');
      if (!response.ok) return;
      const style=await response.json();
      const map = new Map({container:host,style,center:[-122.2805738,40.3873866],zoom:14.5,scrollZoom:false,cooperativeGestures:true,attributionControl:{compact:false}});
      new Marker({color:'#253e32'}).setLngLat([-122.2805738,40.3873866]).addTo(map);
      map.addControl(new NavigationControl({showCompass:false}),'top-right');
      map.once('idle',()=>{
        host.style.opacity='1';
        section.dataset.mapReady='true';
        const label=section.querySelector<HTMLElement>('[data-map-label]');if(label)label.hidden=false;
      });
      map.on('error',()=>{ /* Keep the address and directions available if tiles fail. */ });
    } catch { /* The address/directions fallback also works without WebGL or network access. */ }
  };
  const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){observer.disconnect();void start();}},{rootMargin:'100px'});
  observer.observe(section);
}
</script>
