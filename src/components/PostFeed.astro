---
// News list: newest first, each with a small square thumbnail. Posts without their own
// cover use the fallback (the library photo) so every row has the same layout.
import Image from './OptimizedImage.astro';
import type { LibraryImage, LibraryPost } from '../content/types';
import { newestPosts, postDate } from '../content/feeds';
interface Props { posts: LibraryPost[]; fallbackImage?: LibraryImage; }
const { posts, fallbackImage } = Astro.props;
---
<ul class="m-0 list-none divide-y divide-line p-0">
  {newestPosts(posts).map(post => { const image = post.image ?? fallbackImage; return <li class:list={['py-6 first:pt-0', image && 'agenda-item']}>
    {/* Decorative: the linked title beside it already names the post. */}
    {image && <Image width={208} quality={70} image={image} alt="" widths={[144, 208]} sizes="(max-width: 639px) 72px, 104px" class:list={['thumb', image.fit === 'contain' && 'object-contain p-1.5']} loading="lazy" />}
    <div><p class="mb-2 text-sm text-muted">{post.publishedAt ? <time datetime={post.publishedAt}>{postDate(post)}</time> : postDate(post)}{post.externalUrl && <> · {post.sourceLabel ?? 'External article'}</>}</p>
    <h3 class="card-title"><a href={post.externalUrl ?? post.href} class="underline decoration-1 hover:decoration-2">{post.title}</a></h3></div>
  </li>; })}
</ul>
