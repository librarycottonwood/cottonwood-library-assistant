---
import type { RichTextBlock } from '../content/types';
import { safeHref } from '../content/sanity.mjs';
interface Props { blocks: RichTextBlock[]; }
const { blocks } = Astro.props;
const escape = (value: string) => value.replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]!));
const html: string[] = [];
let list: 'ul' | 'ol' | undefined;
for (const block of blocks) {
  const listTag = block.listItem === 'bullet' ? 'ul' : block.listItem === 'number' ? 'ol' : undefined;
  if (list !== listTag) { if (list) html.push(`</${list}>`); if (listTag) html.push(`<${listTag}>`); list = listTag; }
  const content = block.children.map(span => {
    let value = escape(span.text).replace(/\n/g, '<br />');
    for (const mark of span.marks) {
      const tags: Record<string,string> = { strong:'strong', em:'em', underline:'u', 'strike-through':'s', code:'code' };
      if (tags[mark]) value = `<${tags[mark]}>${value}</${tags[mark]}>`;
      else { const annotation = block.markDefs.find(item => item._key === mark); if (annotation) value = `<a href="${escape(safeHref(annotation.href))}">${value}</a>`; }
    }
    return value;
  }).join('');
  const tag = listTag ? 'li' : block.style === 'normal' ? 'p' : block.style;
  html.push(`<${tag}>${content}</${tag}>`);
}
if (list) html.push(`</${list}>`);
---
<div class="rich-text" set:html={html.join('')} />
<style>
.rich-text :global(p), .rich-text :global(ul), .rich-text :global(ol), .rich-text :global(blockquote){margin:0 0 1.25rem;line-height:1.8}.rich-text :global(h2){font-size:1.75rem;margin:1.75rem 0 1rem;font-family:var(--font-display)}.rich-text :global(h3){font-size:1.35rem;margin:1.5rem 0 .75rem;font-weight:600}.rich-text :global(ul){list-style:disc;padding-left:1.5rem}.rich-text :global(ol){list-style:decimal;padding-left:1.5rem}.rich-text :global(a){text-decoration:underline}.rich-text :global(blockquote){border-left:3px solid currentColor;padding-left:1rem}.rich-text :global(code){font-size:.9em}
</style>
