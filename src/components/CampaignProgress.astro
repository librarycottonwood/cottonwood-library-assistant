---
import { formatDay } from '../content/feeds';
import type { FundraisingCampaign } from '../content/types';
interface Props { campaign: FundraisingCampaign; }
const { campaign } = Astro.props;
const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: campaign.currency, maximumFractionDigits: 0 }).format(value);
const summary = `${money(campaign.raised)} raised of ${money(campaign.goal)} goal`;
const percent = Math.min(100, Math.round((campaign.raised / campaign.goal) * 100));
const labelId = `campaign-${campaign.id}-progress`;
---
<div class="mt-4">
  <p id={labelId} class="text-sm"><strong>{money(campaign.raised)}</strong> raised of {money(campaign.goal)} goal</p>
  <div role="progressbar" aria-labelledby={labelId} aria-valuemin="0" aria-valuemax={campaign.goal} aria-valuenow={Math.min(campaign.raised, campaign.goal)} aria-valuetext={summary} class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-paper ring-1 ring-line">
    <div class="h-full rounded-full bg-forest" style={`width: ${percent}%`} />
  </div>
  <p class="mt-2 text-xs text-muted">Updated <time datetime={campaign.updatedAt}>{formatDay(campaign.updatedAt)}</time>{campaign.endsOn && <> · Ends <time datetime={campaign.endsOn}>{formatDay(campaign.endsOn)}</time></>}</p>
</div>
