---
import { services } from '../../pages/academy/_guide';
import { contentRepository } from '../../content/repository';
interface Props { print?: boolean; }
const { print = false } = Astro.props;
const { library } = await contentRepository.getHome();
const groups = ['Writing, website and communications', 'Catalog, meetings and reports', 'Website administration'];
const serviceHref = (service: typeof services[number]) => service.name === 'Facebook and Instagram' ? library.facebookUrl : service.href;
---
<section class="service-map" aria-labelledby="services-heading">
  <h2 id="services-heading">The library’s tools</h2>
  <p>{print ? 'What each service does and where to open it.' : 'Select a service for its link and a short explanation.'}</p>
  {groups.map(group => <section class="service-group">
    <h3>{group}</h3>
    {services.filter(service => service.group === group).map(service => print ? <article class="service-card">
      <h4>{service.name}</h4>
      <p>{service.purpose} {service.access}</p>
      <p>{service.connection}</p>
      <p class="service-url"><a href={serviceHref(service)}>{serviceHref(service)}</a>
        {service.name === 'Facebook and Instagram' && library.instagramUrl && <> · <a href={library.instagramUrl}>Instagram: {library.instagramUrl}</a></>}
        {service.name === 'Gmail and Google Drive' && <> · <a href="https://mail.google.com/">Gmail: mail.google.com</a></>}
      </p>
    </article> : <details class="service-card">
      <summary><span><strong>{service.name}</strong><span>{service.purpose}</span></span></summary>
      <div class="service-detail"><p>{service.access}</p><p>{service.connection}</p>
        <p><a href={serviceHref(service)}>Open {service.name === 'Facebook and Instagram' ? 'Facebook' : service.name} ↗</a>
          {service.name === 'Facebook and Instagram' && library.instagramUrl && <> · <a href={library.instagramUrl}>Instagram ↗</a></>}
          {service.name === 'Gmail and Google Drive' && <> · <a href="https://mail.google.com/">Gmail ↗</a></>}
        </p>
      </div>
    </details>)}
  </section>)}
</section>
