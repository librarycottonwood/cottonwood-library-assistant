---
import Prompt from './Prompt.astro';
import ServiceMap from './ServiceMap.astro';
import WorkflowExamples from './WorkflowExamples.astro';
import type { Lesson } from '../../pages/academy/_guide';
interface Props { lesson: Lesson; print?: boolean; }
const { lesson, print = false } = Astro.props;
const PartHeading = print ? 'h3' : 'h2';
---

{lesson.slug === 'accounts-and-tools' && <ServiceMap print={print} />}
{lesson.slug === 'practice-with-a-buddy' && !print ? <WorkflowExamples examples={lesson.parts} /> : lesson.parts.map(part => <section class="lesson-part" id={part.id}>
  <PartHeading class="part-heading">{part.title}</PartHeading>
  {part.text.map(text => <p>{text}</p>)}
  {part.steps && <ol class="steps">{part.steps.map(step => <li>{step}</li>)}</ol>}
  {part.prompt && <Prompt text={part.prompt} />}
  {part.links && <ul class="reference-links">{part.links.map(link => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul>}
</section>)}
