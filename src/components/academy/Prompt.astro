---
interface Props { text: string; }
const { text } = Astro.props;
---
<aside class="prompt" data-prompt aria-label="Example ChatGPT prompt">
  <div class="prompt-heading"><strong>Try saying</strong><button type="button" data-copy-prompt hidden>Copy prompt</button></div>
  <p data-prompt-text>{text}</p>
  <p class="copy-status" role="status" aria-live="polite"></p>
</aside>
