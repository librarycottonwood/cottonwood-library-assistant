---
import { lessons, academyGroups } from '../../pages/academy/_guide';
import LessonIcon from './LessonIcon.astro';
import ReadingHeader from '../site/ReadingHeader.astro';
import Stack from '../site/Stack.astro';
import Grid from '../site/Grid.astro';
import Heading from '../site/Heading.astro';
import LinkCard from '../site/LinkCard.astro';
---
<Stack gap="lg">
 <ReadingHeader title="Volunteer academy" summary="Use ChatGPT to update the website, prepare newsletters and get reports." />
 {academyGroups.map(group => <section aria-labelledby={`home-${group.id}`}><Stack gap="sm">
  <Heading size="reading-heading" id={`home-${group.id}`}>{group.title}</Heading>
  <Grid columns={2} gap="sm">{group.slugs.map(slug => lessons.find(lesson => lesson.slug === slug)!).map(lesson => <LinkCard href={`/academy/${lesson.slug}/`} title={lesson.title}>
    <LessonIcon slot="icon" slug={lesson.slug} size={22} />{lesson.summary}
  </LinkCard>)}</Grid>
 </Stack></section>)}
</Stack>
