---
import { lessons, academyGroups } from '../../pages/academy/_guide';
import { ArrowRight } from '@lucide/astro';
import LessonIcon from './LessonIcon.astro';
---
<header class="lesson-header">
  <h1>Volunteer academy</h1>
  <p class="lead">Use ChatGPT to update the website, prepare newsletters and get reports.</p>
</header>
{academyGroups.map(group => <section class="academy-home-group" aria-labelledby={`home-${group.id}`}>
  <h2 id={`home-${group.id}`}>{group.title}</h2>
  <ol class="lesson-list">{group.slugs.map(slug => lessons.find(lesson => lesson.slug === slug)!).map(lesson => <li><a href={`/academy/${lesson.slug}/`}>
    <span class="lesson-list-icon"><LessonIcon slug={lesson.slug} size={21} /></span>
    <div><h3>{lesson.title}</h3><p>{lesson.summary}</p></div>
    <ArrowRight size={18} aria-hidden="true" />
  </a></li>)}</ol>
</section>)}
