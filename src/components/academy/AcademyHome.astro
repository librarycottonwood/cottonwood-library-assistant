---
import { lessons } from '../../pages/academy/_guide';
import { ArrowRight } from '@lucide/astro';
import LessonIcon from './LessonIcon.astro';
---
<header class="lesson-header">
  <h1>Volunteer academy</h1>
  <p class="lead">How to use ChatGPT and the library’s websites.</p>
</header>
<section aria-labelledby="lessons-heading">
  <h2 id="lessons-heading">Guides</h2>
  <ol class="lesson-list">{lessons.map(lesson => <li><a href={`/academy/${lesson.slug}/`}>
    <span class="lesson-list-icon"><LessonIcon slug={lesson.slug} size={21} /></span>
    <div><h3>{lesson.title}</h3><p>{lesson.summary}</p></div>
    <ArrowRight size={18} aria-hidden="true" />
  </a></li>)}</ol>
</section>
<section class="print-panel" aria-labelledby="paper-heading">
  <h2 id="paper-heading">Print a copy</h2>
  <p><a href="/academy/quick-reference/">One-page quick guide</a> · <a href="/academy/print/">Complete handbook</a></p>
</section>
