---
import { Image } from 'astro:assets';
import { resolveImage } from '../../content/images';
import type { Part } from '../../pages/academy/_guide';
interface Props { image: NonNullable<Part['screenshots']>[number]; }
const { image } = Astro.props;
const source = resolveImage(image.key);
---
<figure class="lesson-screenshot" data-view={image.view} data-framing={image.framing}>
  <div class="screenshot-canvas">
    <span class="screenshot-window"><Image src={source} alt={image.alt} format={['newsletter', 'tour-plugins'].includes(image.view) ? 'webp' : 'png'} quality={95} widths={[1200, Math.min(1800, source.width)]} sizes="(max-width: 767px) 840px, 1800px" loading="lazy" /></span>
  </div>
  {image.caption && <figcaption>{image.caption}</figcaption>}
</figure>
