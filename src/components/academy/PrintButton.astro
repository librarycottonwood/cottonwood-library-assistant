---
import Button from '../site/Button.astro';
import { Printer } from '@lucide/astro';
---
<Button variant="accent" data-print hidden><Printer size={18} aria-hidden="true" />Print or save a PDF</Button>

<script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
        button.hidden = false;
        button.addEventListener('click', () => window.print());
      }
</script>
