---
import { Search } from '@lucide/astro';
---
<button class="academy-search-trigger" type="button" data-open-academy-search aria-haspopup="dialog" aria-controls="academy-search-dialog" hidden><Search size={18} aria-hidden="true" /><span>Search academy</span></button>
<style>
.academy-search-trigger { display: flex; align-items: center; gap: var(--space-xs); width: 100%; min-height: 44px; margin-block-end: var(--space-sm); padding: var(--space-xs); border: 0; border-radius: var(--radius-control); background: var(--color-surface-muted); color: var(--color-text-muted); font: var(--weight-regular) var(--text-navigation)/var(--leading-snug) var(--font-body); cursor: pointer; text-align: left; }
.academy-search-trigger:hover { color: var(--color-text); background: color-mix(in srgb, var(--color-surface-muted), var(--color-border) 30%); }
</style>
