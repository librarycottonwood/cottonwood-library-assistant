---
import { Image } from 'astro:assets';
import logo from '../../library-files/logos/cottonwood-community-library-logo.jpg';
import Icon from './Icon.astro';
import { checkoutAttributes, getDonateLink } from '../content/donate';
import type { HomeContent } from '../content/types';
interface Props { library: HomeContent['library']; navigation: HomeContent['navigation']; }
const { library, navigation } = Astro.props;
const donate = getDonateLink();
const isCurrent = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href);
---
<a href="/#visit" aria-label={`Library hours: ${library.hoursSummary}. View hours and directions.`} class="hours-banner group block bg-forest text-paper transition-colors hover:bg-forest-dark focus-visible:outline-offset-[-4px] focus-visible:outline-paper">
  <div class="container flex min-h-11 items-center justify-between gap-4 py-2 text-[0.8125rem]">
    <span class="flex items-center gap-2.5"><Icon name="clock" class="size-3.5 shrink-0 text-[#d3ddce]" /><span>{library.hoursSummary}</span></span>
    <span class="hidden shrink-0 text-[#d3ddce] sm:inline">{library.address}, Cottonwood</span>
  </div>
</a>
<header class="border-b border-line bg-paper">
  <div class="container flex min-h-20 flex-wrap items-center justify-between gap-3 py-3 lg:min-h-24">
    <a href="/" class="flex min-w-0 max-w-full items-center gap-3" aria-label="Cottonwood Community Library home">
      <Image quality={70} src={logo} alt="" width={67} densities={[1, 2]} loading="eager" class="w-[54px] shrink-0 mix-blend-multiply sm:w-[67px]" />
      <span class="min-w-0 text-[1.0625rem] leading-[1.2] font-semibold tracking-[-.025em] sm:text-xl">Cottonwood<span class="mt-1 block text-[0.6875rem] font-medium tracking-[.1em] uppercase sm:text-[0.75rem]">Community Library</span></span>
    </a>
    <nav aria-label="Main navigation" class="hidden items-center gap-5 xl:flex">
      {navigation.filter(item => item.href !== '/fundraising-events/').map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="py-3 text-[0.875rem] font-medium hover:underline">{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={library.catalogUrl} data-analytics-event="catalog_header" class="button button-outline hidden px-4 text-sm sm:inline-flex"><Icon name="book" class="size-4" />Catalog</a>
      <a href={donate.href} {...checkoutAttributes(donate)} data-analytics-event="donate_header" class="button hidden bg-gold px-4 text-sm text-forest-dark hover:bg-meadow sm:inline-flex"><Icon name="heart" class="size-4" />Donate</a>
      <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded border border-line px-3 text-sm xl:hidden" hidden>
        <span class="hidden sm:inline">Menu</span><Icon name="menu" class="menu-icon size-5" /><Icon name="close" class="close-icon hidden size-5" /><span class="sr-only sm:hidden">Menu</span>
      </button>
    </div>
  </div>
  <nav id="mobile-navigation" aria-label="Mobile navigation" class="container flex flex-col border-t border-line py-4 xl:hidden">
    {navigation.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="rounded px-2 py-3 text-base font-medium hover:bg-meadow">{item.label}</a>)}
    <a href={library.catalogUrl} data-analytics-event="catalog_mobile" class="flex items-center gap-2 rounded px-2 py-3 text-base font-semibold hover:bg-meadow">Browse the catalog <Icon name="external" class="size-4" /></a>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#mobile-navigation');
  if (button && nav) {
    button.hidden = false;
    nav.hidden = true;
    const setOpen = (open: boolean) => {
      nav.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.querySelector('.menu-icon')?.classList.toggle('hidden', open);
      button.querySelector('.close-icon')?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      setOpen(false);
      // Move keyboard focus to the destination rather than leaving it in a hidden menu.
      const destination = new URL(link.href);
      const hash = destination.hash;
      if (destination.pathname === window.location.pathname && hash) document.querySelector<HTMLElement>(hash)?.focus({ preventScroll: true });
    }));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !nav.hidden) { setOpen(false); button.focus(); }
    });
    window.matchMedia('(min-width: 1280px)').addEventListener('change', () => setOpen(false));
  }
</script>
