---
import Image from './OptimizedImage.astro';
import type { LibraryImage } from '../content/types';
interface Props { image: LibraryImage; variant?: 'card' | 'feature'; eager?: boolean; }
const { image, variant = 'card', eager = false } = Astro.props;
const contained = image.fit === 'contain';
---
<Image quality={70}
  image={image} alt={image.alt}
  width={variant === 'card' ? 800 : 1100}
  widths={variant === 'card' ? [360, 600, 800] : [500, 800, 1100]}
  sizes={variant === 'card' ? '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 380px' : '(max-width: 1023px) 100vw, 600px'}
  loading={eager ? 'eager' : 'lazy'}
  class:list={[
    'w-full',
    variant === 'card' ? 'aspect-[1.52]' : contained ? 'aspect-square max-h-[540px] rounded-[4px]' : 'rounded-[4px] aspect-[1.5]',
    contained ? 'object-contain bg-[#eee8d8] p-4' : 'object-cover',
  ]}
/>
