---
interface Props { title: string; eyebrow?: string; description?: string; back?: { label: string; href: string }; }
const { title, eyebrow, description, back } = Astro.props;
---
<div class="container pt-6 pb-8 sm:pt-8 sm:pb-10">
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-sm text-muted"><a href="/" class="hover:underline">Home</a>{back && <><span aria-hidden="true">/</span><a href={back.href} class="hover:underline">{back.label}</a></>}</nav>
  {eyebrow && <p class="eyebrow mb-3 text-muted">{eyebrow}</p>}
  <h1 class="page-heading">{title}</h1>
  {description && <p class="mt-5 max-w-2xl text-lg text-muted">{description}</p>}
  <slot />
</div>
