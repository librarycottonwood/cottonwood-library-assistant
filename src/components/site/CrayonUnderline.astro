---
/**
 * @component CrayonUnderline
 * A single, gently uneven crayon underline that stays attached to its word.
 * @use One word in an occasional section heading. Keep the rest of the heading plain.
 * @avoid Links, body copy, long phrases, or decorative marks floating beside a label.
 * @example
 * <Heading>Powered by <CrayonUnderline>Community</CrayonUnderline></Heading>
 */
---
<span class="crayon-word"><slot /><svg viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d="M1 7.4 9 5.9 24 5.5 37 5.8 55 4.9 72 5.1 90 4.6 108 4.8 126 4.4 143 4.9 160 4.6 177 5.1 194 4.9 213 5.4 231 5.2 239 6.4 235 8 218 7.7 202 8.1 182 7.6 165 8 146 7.5 129 7.9 110 7.5 94 8 75 7.6 58 8.3 39 7.9 23 8.5 8 8.3Z" />
  <path d="M11 9.3Q117 6.9 229 8.9" fill="none" stroke="currentColor" stroke-width=".6" opacity=".4" />
</svg></span>
<style>
  .crayon-word { display: inline-block; position: relative; }
  svg { position: absolute; inset-inline-start: 0; bottom: 0; width: 100%; height: .24em; transform: translateY(.18em); color: var(--color-accent-ink); fill: currentColor; opacity: .85; pointer-events: none; }
</style>
