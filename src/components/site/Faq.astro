---
/**
 * @component Faq
 * Questions that open to show their answer, with a + that turns into ×. Only one is open at a time (details name=…; with JavaScript the script does it, so both answers can slide). Works without JavaScript (details/summary).
 * @use "Frequently Asked Questions" on Visit Us, Explore Services and service pages, inside a Section with width="text". Each page asks its own questions: borrowing (Sanity) on Explore Services, visiting on Visit Us, the program on its service page.
 * @avoid Content everyone needs to see without clicking (hours, prices), or a single question (use Heading + Text).
 * @example
 * <Section title="Frequently Asked Questions" headingId="faq-heading" width="text">
 *   <Faq items={borrowing} email={library.email} />
 * </Section>
 */
import Icon from '../Icon.astro';
interface Props {
  items: { question: string; answer: string }[];
  /** Open the first question, as in Figma. */
  openFirst?: boolean;
  /** The library's email: adds "Still have a question? Email us." under the questions. */
  email?: string;
}
const { items, openFirst = true, email } = Astro.props;
// Details sharing a name form an exclusive accordion: opening one closes the others. Built from the questions so the
// build output stays the same from one build to the next.
const group = `faq-${[...items.map(item => item.question).join('')].reduce((sum, character) => (sum * 31 + character.charCodeAt(0)) % 1e6, 7)}`;
---
<div class="faq">
  {items.map((item, index) => <details name={group} open={openFirst && index === 0}>
    <summary><span>{item.question}</span><Icon name="plus" class="faq-icon" /></summary>
    <div class="faq-answer"><p>{item.answer}</p></div>
  </details>)}
  {email && <p class="faq-ask">Still have a question? <a href={`mailto:${email}`}>Email us</a>.</p>}
</div>
<script>
  // Answers slide open and shut (slide in src/scripts/motion.ts). The script takes over name=…'s one-open-at-a-time
  // rule, because the browser would close the other answer instantly instead of letting it slide.
  import { slide } from '../../scripts/motion';
  async function setOpen(details: HTMLDetailsElement, open: boolean) {
    const answer = details.querySelector<HTMLElement>('.faq-answer');
    if (!answer) return;
    if (open) { details.classList.remove('is-closing'); details.open = true; await slide(answer, true); return; }
    details.classList.add('is-closing');
    await slide(answer, false);
    if (details.classList.contains('is-closing')) { details.open = false; details.classList.remove('is-closing'); }
  }
  for (const faq of document.querySelectorAll<HTMLElement>('.faq')) {
    const items = [...faq.querySelectorAll<HTMLDetailsElement>('details')];
    items.forEach(details => details.removeAttribute('name'));
    for (const details of items) {
      details.querySelector('summary')?.addEventListener('click', event => {
        event.preventDefault();
        const opening = !details.open || details.classList.contains('is-closing');
        if (opening) items.forEach(other => { if (other !== details && other.open && !other.classList.contains('is-closing')) setOpen(other, false); });
        setOpen(details, opening);
      });
    }
  }
</script>
<style>
  .faq { display: flex; flex-direction: column; gap: var(--space-md); width: 100%; font-size: var(--fluid-lead); line-height: var(--leading-relaxed); }
  details { display: flex; flex-direction: column; }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    min-height: 2.75rem; font-weight: var(--weight-bold); cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover span { text-decoration-line: underline; }
  summary :global(svg) { width: 1.1em; height: 1.1em; flex-shrink: 0; color: var(--color-text-muted); }
  /* The + turns 45° into × as the answer opens, and back as it closes (.is-closing while the answer slides shut). */
  summary :global(.faq-icon) { transition: rotate var(--motion-smooth) var(--ease-out); }
  details[open]:not(.is-closing) :global(.faq-icon) { rotate: 45deg; }
  .faq-answer { overflow: hidden; }
  details p { padding-block-start: var(--space-sm); color: var(--color-text-muted); }
  .faq-ask { padding-block-start: var(--space-sm); color: var(--color-text-muted); text-align: center; }
  .faq-ask a { color: var(--color-text); font-weight: var(--weight-bold); text-decoration-line: underline; }
  /* Figma (1920): questions 105px apart, the answer 30px below its question. */
  @media (min-width: 64rem) {
    .faq { gap: var(--space-lg); }
    details p { padding-block-start: var(--space-md); }
  }
</style>
