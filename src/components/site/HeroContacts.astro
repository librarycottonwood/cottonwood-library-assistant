---
/**
 * @component HeroContacts
 * Directions and phone links, shown as two plain rows after the hero actions on phones and tablets.
 * @use Once in the homepage Split caption, with the complete current address, phone and original destinations.
 * @avoid Other page actions, shortening contact values, or replacing the hero's main heading with contact details.
 * @example
 * <HeroContacts slot="caption" address={`${library.address}, Cottonwood`} directionsHref={library.directionsUrl} phone={library.phone} phoneHref={library.phoneHref} />
 */
import Icon from '../Icon.astro';
interface Props { address: string; directionsHref: string; phone: string; phoneHref: string; }
const { address, directionsHref, phone, phoneHref } = Astro.props;
const contacts = [
  { title: 'Directions', value: address, href: directionsHref, icon: 'pin' as const, event: 'directions_click' },
  { title: 'Call the library', value: phone, href: phoneHref, icon: 'phone' as const, event: undefined },
];
---
{contacts.map(contact => <a class="hero-contact" href={contact.href} aria-label={`${contact.title}: ${contact.value}`} data-analytics-event={contact.event}><Icon name={contact.icon} />{' '}<span class="contact-detail">{contact.value}</span></a>)}
<style>
  .hero-contact { display: inline-flex; align-items: center; gap: var(--space-xs); max-width: 100%; text-decoration-line: none; }
  .hero-contact:hover { text-decoration-line: underline; }
  .hero-contact :global(svg) { width: 1em; height: 1em; flex-shrink: 0; }
  .contact-detail { min-width: 0; }
  @media (max-width: 63.99rem) {
    .hero-contact { width: fit-content; min-width: 0; min-height: 2.75rem; font-weight: var(--weight-medium); }
    .contact-detail { font-size: var(--text-contact-detail); color: var(--color-text-muted); line-height: 1.4; overflow-wrap: anywhere; }
  }
</style>
