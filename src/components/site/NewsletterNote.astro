---
/**
 * @component NewsletterNote
 * @internal
 * A folded-paper newsletter signup with the book-carrying child peeking over its top edge.
 * @use SiteFooter adds this once to every page, with the existing newsletter form and wording.
 * @avoid Additional forms, decoration behind text, or clipping the form's focus outlines and result messages.
 * @example
 * <NewsletterNote email={library.email} />
 */
import Heading from './Heading.astro';
import IconLink from './IconLink.astro';
import LibraryIllustration from './LibraryIllustration.astro';
import NewsletterForm from './NewsletterForm.astro';
import Text from './Text.astro';
interface Props { email: string; }
const { email } = Astro.props;
---
<section class="newsletter-section" aria-labelledby="newsletter-heading">
  <div class="newsletter-note" data-motion="rise">
    <div class="note-paper" aria-hidden="true"></div>
    <div class="note-fold" aria-hidden="true"></div>
    <LibraryIllustration scene="books" />
    <div class="note-copy">
      <Heading id="newsletter-heading">Newsletter</Heading>
      <Text tone="muted">Sign up to get all the latest library news directly in your inbox, from the director herself.</Text>
      <NewsletterForm email={email} labelledBy="newsletter-heading" />
      <IconLink href="/newsletter/" iconEnd="arrow">Read the latest newsletter</IconLink>
    </div>
  </div>
</section>
<style>
  .newsletter-section { padding: var(--section-space) var(--page-inset); }
  .newsletter-note { position: relative; isolation: isolate; display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); width: 100%; max-width: var(--width-text); margin-inline: auto; }
  .note-paper { position: absolute; z-index: -1; inset-block-start: var(--space-lg); inset-block-end: 0; inset-inline: 0; border: var(--border-thin) solid var(--color-primary-soft); border-radius: .5rem; background: var(--color-surface); clip-path: polygon(0 0, calc(100% - 3.75rem) 0, 100% 3.75rem, 100% 100%, 0 100%); pointer-events: none; }
  .note-fold { position: absolute; z-index: -1; inset-block-start: var(--space-lg); inset-inline-end: 0; width: 3.75rem; height: 3.75rem; background: var(--color-primary-soft); clip-path: polygon(0 0, 100% 100%, 0 100%); pointer-events: none; }
  .note-copy { display: flex; flex-direction: column; align-items: center; gap: var(--space-md); width: 100%; padding: 0 var(--space-lg) var(--space-lg); text-align: center; }
  .note-copy > :global(*) { max-width: var(--width-copy); }
  @media (max-width: 47.99rem) {
    .note-copy { padding: 0 var(--space-sm) var(--space-md); }
    .note-paper { clip-path: polygon(0 0, calc(100% - 2.5rem) 0, 100% 2.5rem, 100% 100%, 0 100%); }
    .note-fold { width: 2.5rem; height: 2.5rem; }
  }
</style>
