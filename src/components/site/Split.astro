---
/**
 * @component Split
 * A large photo beside a text column. On desktop the photo bleeds off the page edge; on phones the photo sits above the text.
 * @use The opening hero, a featured event, a call to give or volunteer. At most one in a row, alternating media="end"/"start".
 * @avoid Several similar items (use Grid + Card), or photos that must not be cropped.
 * @example
 * <Split media="start" image={photo} headingId="community-heading">
 *   <Heading id="community-heading">Keep your library open.</Heading>
 *   <Text tone="muted">No county or taxpayer funding.</Text>
 *   <Stack direction="row" gap="xs" wrap><Button href="/fundraising-events/" variant="accent" icon="heart">Donate</Button></Stack>
 * </Split>
 */
import Image from '../OptimizedImage.astro';
import type { LibraryImage } from '../../content/types';
interface Props {
  image: LibraryImage;
  /** Which side the photo is on from desktop width up. */
  media?: 'start' | 'end';
  /** Photo aspect ratio. */
  ratio?: '1314 / 652' | '16 / 9';
  /** id of the heading inside, which labels the section. */
  headingId?: string;
  /** The first block on the page: less space above, and the photo loads immediately. */
  first?: boolean;
  /** id on the photo wrapper, for links like /#visit. */
  mediaId?: string;
  hidden?: boolean;
  [data: `data-${string}`]: string | undefined;
}
const { image, media = 'end', ratio = '1314 / 652', headingId, first = false, mediaId, ...attributes } = Astro.props;
const hasCaption = Astro.slots.has('caption');
---
<section aria-labelledby={headingId} class:list={['split', `media-${media}`, { first, bleed: ratio === '1314 / 652' }]} {...attributes}>
  <div class="split-copy"><slot /></div>
  <div id={mediaId} tabindex={mediaId ? -1 : undefined} class:list={['split-media', { 'has-caption': hasCaption }]}>
    <Image width={1314} quality={70} image={image} alt={image.alt} widths={[600, 900, 1314]} sizes="(max-width: 63.99rem) 100vw, 68vw" loading={first ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : undefined} class:list={['split-image', image.fit === 'contain' && 'is-contained']} style={`aspect-ratio: ${ratio}`} />
    {hasCaption && <p class="split-caption"><slot name="caption" /></p>}
  </div>
</section>
<style>
  /* minmax(0, 1fr) lets the one phone column shrink below its content (large text on small phones). */
  .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-md); padding-block: var(--section-space); }
  .first { padding-block-start: var(--space-sm); }
  .split-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-inline: var(--page-inset); }
  .media-start .split-copy { order: 1; }
  .split-media { position: relative; padding-inline: var(--page-inset); }
  .has-caption { padding-block-end: var(--space-md); }
  .split-media :global(.split-image) {
    width: 100%; object-fit: cover;
    border: var(--border-thin) solid var(--border-image); border-radius: var(--radius-image);
  }
  .split-media :global(.split-image.is-contained) { object-fit: contain; background: var(--color-surface); }
  .split-caption {
    position: absolute; bottom: 0; left: var(--page-inset); right: var(--page-inset);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md);
    width: auto; max-width: fit-content;
    margin-inline-start: var(--space-sm);
    padding: var(--space-sm);
    border-radius: var(--radius-pill); background: var(--color-background); color: var(--color-primary-ink);
    font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight);
  }

  @media (min-width: 48rem) {
    .first { padding-block-start: var(--space-md); }
  }
  @media (min-width: 64rem) {
    .split { align-items: center; gap: var(--space-lg); }
    .media-end { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); padding-inline-start: var(--page-inset); }
    .media-start { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding-inline-end: var(--page-inset); }
    .media-start .split-copy { order: 0; }
    .media-start .split-media { order: -1; }
    .split-copy, .split-media { padding-inline: 0; }
    .media-end .split-media :global(.split-image) { border-right: 0; border-radius: var(--radius-image) 0 0 var(--radius-image); }
    .media-start .split-media :global(.split-image) { border-left: 0; border-radius: 0 var(--radius-image) var(--radius-image) 0; }
    .split-caption { left: 0; right: auto; margin-inline-start: var(--space-md); }
    /* The hero photo touches the header, as in the design. */
    .first { padding-block-start: 0; }
    /* The design's 1314 × 652 photo runs past the page edge, so it is cropped there, not shrunk.
       Keep it as tall as the design (652px at 1920 wide) and never shorter than its own shape. */
    .bleed .split-media { container-type: inline-size; }
    .bleed .split-media :global(.split-image) { height: max(calc(100cqi * 652 / 1314), calc(100vw * 652 / 1920)); }
    .bleed.media-end .split-media :global(.split-image) { object-position: left center; }
    .bleed.media-start .split-media :global(.split-image) { object-position: right center; }
  }
  @media (min-width: 90rem) {
    .media-end { grid-template-columns: minmax(0, var(--width-copy)) minmax(0, 1fr); }
    .media-start { grid-template-columns: minmax(0, 1fr) minmax(0, var(--width-copy)); }
  }
  @media (min-width: 100rem) {
    .split { gap: var(--space-xl); }
    .split-caption { margin-inline-start: var(--space-lg); }
  }
</style>
