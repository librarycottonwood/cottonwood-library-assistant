---
/**
 * @component Split
 * A large photo beside a text column. The photo bleeds off one page edge at every width; on phones and tablets it sits above the text, a little taller (3:2) so it isn't a thin strip. With `panel` the text sits on a pale-indigo panel that runs off the other edge (Visit Us hours). With `inset` both stay inside the content width and the photo is rounded on every corner (Explore Services).
 * @use The opening hero, a featured event, a call to give or volunteer, opening hours beside a photo (panel), one service described beside its photo (inset). At most one in a row, alternating media="end"/"start".
 * @avoid Several similar items (use Grid + Card), or photos that must not be cropped: every photo fills its frame, posters too (use Gallery to show a whole picture).
 * @example
 * <Split media="start" image={photo} headingId="community-heading">
 *   <Heading id="community-heading">Keep your library open.</Heading>
 *   <Text tone="muted">No county or taxpayer funding.</Text>
 *   <Stack direction="row" gap="xs" wrap><Button href="/donate/" variant="accent" icon="heart">Donate</Button></Stack>
 * </Split>
 */
import Image from '../OptimizedImage.astro';
import type { LibraryImage } from '../../content/types';
import { refreshPhoto } from '../../content/photography';
interface Props {
  image: LibraryImage;
  /** Which side the photo is on from desktop width up. */
  media?: 'start' | 'end';
  /** Photo aspect ratio. With `panel` the photo also grows to the panel's height. */
  ratio?: '1314 / 652' | '16 / 9' | '5 / 4';
  /** Text on a pale-indigo panel (--color-primary-soft) that runs off the page edge opposite the photo. */
  panel?: boolean;
  /** Keep photo and text inside the content width (1520px); the photo is rounded on every corner. */
  inset?: boolean;
  /** id of the heading inside, which labels the section. */
  headingId?: string;
  /** The first block on the page: less space above, and the photo loads immediately. */
  first?: boolean;
  /** id on the section, for links like /services/#computers. */
  id?: string;
  /** id on the photo wrapper, for links like /#visit. */
  mediaId?: string;
  hidden?: boolean;
  [data: `data-${string}`]: string | undefined;
}
const { image: originalImage, media = 'end', ratio: ratioProp, panel = false, inset = false, headingId, first = false, mediaId, ...attributes } = Astro.props;
const image = refreshPhoto(originalImage);
const ratio = ratioProp ?? (inset ? '5 / 4' : panel ? '16 / 9' : '1314 / 652');
const hasCaption = Astro.slots.has('caption');
// Rendered once, shown in two places: over the photo from desktop width up, and under the text on phones and tablets,
// where the photo sits above the text. So Tab and screen readers meet it after the buttons, in the order people read.
const caption = hasCaption ? await Astro.slots.render('caption') : '';
const bleed = ratio === '1314 / 652' && !panel && !inset;
// The opening photo eases out of a slight zoom inside a frame that owns its rounded corners and border (as Card's
// photos do on hover), so the corners never change shape while it moves.
const framed = first && bleed && media === 'end';
---
<section aria-labelledby={headingId} class:list={['split', `media-${media}`, { first, panel, inset, bleed }]} {...attributes}>
  <div class="split-copy" data-motion="group"><slot />{hasCaption && <p class="split-caption-inline" set:html={caption} />}</div>
  <div id={mediaId} tabindex={mediaId ? -1 : undefined} data-motion={first ? undefined : 'rise'} class:list={['split-media', { 'has-caption': hasCaption }]}>
    {framed
      ? <div class="split-frame"><Image width={1314} quality={70} image={image} alt={image.alt} widths={[600, 900, 1314]} sizes="(max-width: 63.99rem) 100vw, 68vw" loading="eager" fetchpriority="high" class="split-image" style={`--split-ratio: ${ratio}`} data-motion="settle" /></div>
      : <Image width={1314} quality={70} image={image} alt={image.alt} widths={[600, 900, 1314]} sizes="(max-width: 63.99rem) 100vw, 68vw" loading={first ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : undefined} class="split-image" style={`--split-ratio: ${ratio}`} />}
    {hasCaption && <p class="split-caption" set:html={caption} />}
  </div>
</section>
<style>
  /* minmax(0, 1fr) lets the one phone column shrink below its content (large text on small phones). */
  .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-md); padding-block: var(--section-space); }
  .first { padding-block-start: var(--space-sm); }
  .split-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-inline: var(--page-inset); }
  /* Phones: the photo always sits above the text. */
  .split-copy { order: 1; }
  .split-media { position: relative; padding-inline: var(--page-inset); }
  .has-caption { padding-block-end: var(--space-md); }
  .split-media :global(.split-image) {
    width: 100%; object-fit: cover; aspect-ratio: var(--split-ratio);
    border: var(--border-thin) solid var(--border-image); border-radius: var(--radius-image);
  }
  /* Phones and tablets: the bleed photo still runs off its page edge (the site's signature look), and is 3:2 so the
     building or room reads and the address pill doesn't cover half of it. */
  @media (max-width: 63.99rem) {
    .bleed .split-media :global(.split-image) { aspect-ratio: 3 / 2; }
    /* Cropped from the side that stays on the page, as on desktop, so the inner edge (a sign, a doorway) stays in view. */
    .bleed.media-end .split-media :global(.split-image) { object-position: left center; }
    .bleed.media-start .split-media :global(.split-image) { object-position: right center; }
    .bleed.media-end .split-media { padding-inline-end: 0; }
    .bleed.media-end .split-media :global(.split-image) { border-right: 0; border-radius: var(--radius-image) 0 0 var(--radius-image); }
    .bleed.media-start .split-media { padding-inline-start: 0; }
    .bleed.media-start .split-media :global(.split-image) { border-left: 0; border-radius: 0 var(--radius-image) var(--radius-image) 0; }
  }
  /* Phones and tablets: the address and phone sit under the text, not over the photo (see `caption` above). */
  .split-caption-inline { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); color: var(--color-primary-ink); font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight); }
  @media (max-width: 63.99rem) {
    .split .split-caption { display: none; }
    .has-caption { padding-block-end: 0; }
  }
  @media (min-width: 64rem) {
    .split .split-caption-inline { display: none; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .bleed .split-media :global(.split-image) { aspect-ratio: 16 / 9; }
  }
  .split-caption {
    position: absolute; bottom: 0; left: var(--page-inset); right: var(--page-inset);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md);
    width: auto; max-width: fit-content;
    margin-inline-start: var(--space-sm);
    padding: var(--space-sm);
    border-radius: var(--radius-pill); background: var(--color-background); color: var(--color-primary-ink);
    font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight);
  }

  /* Panel: the text column on pale indigo. On phones it is a rounded box inside the page inset. */
  .panel .split-copy {
    margin-inline: var(--page-inset); padding: var(--space-md);
    border-radius: var(--radius-image); background: var(--color-primary-soft);
  }
  /* Inset: photo and text stay inside the content width; the photo keeps all four corners. */
  .inset { max-width: var(--width-content); margin-inline: auto; box-sizing: content-box; padding-inline: var(--page-inset); }
  .inset .split-copy, .inset .split-media { padding-inline: 0; }

  @media (min-width: 48rem) {
    .first { padding-block-start: var(--space-md); }
    .panel .split-copy { padding: var(--space-lg); }
  }
  @media (min-width: 64rem) {
    .split { align-items: center; gap: var(--space-lg); }
    .split-copy { order: 0; }
    .media-end { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); padding-inline-start: var(--page-inset); }
    .media-start { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding-inline-end: var(--page-inset); }
    .media-start .split-media { order: -1; }
    .split-copy, .split-media { padding-inline: 0; }
    .media-end .split-media :global(.split-image) { border-right: 0; border-radius: var(--radius-image) 0 0 var(--radius-image); }
    .media-start .split-media :global(.split-image) { border-left: 0; border-radius: 0 var(--radius-image) var(--radius-image) 0; }
    .split-caption { left: 0; right: auto; margin-inline-start: var(--space-md); }
    /* Panel (Figma Visit Us): photo and panel share the row's height and meet with a 30px gap. */
    .panel { align-items: stretch; gap: var(--space-md); padding-inline: 0; }
    .panel.media-start { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
    .panel.media-end { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
    .panel .split-copy { justify-content: center; margin-inline: 0; }
    .panel.media-start .split-copy { border-radius: var(--radius-image) 0 0 var(--radius-image); }
    .panel.media-end .split-copy { border-radius: 0 var(--radius-image) var(--radius-image) 0; }
    .panel .split-media { container-type: inline-size; }
    .panel .split-media :global(.split-image) { height: 100%; min-height: calc(100cqi * 9 / 16); }
    /* Figma Explore Services: text 674px, photo 746px. */
    .inset.media-end { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
    .inset.media-start { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .inset.media-end, .inset.media-start { padding-inline: var(--page-inset); }
    .inset .split-media :global(.split-image) { border: var(--border-thin) solid var(--border-image); border-radius: var(--radius-image); }
    /* The hero photo touches the header, as in the design. */
    .first { padding-block-start: 0; }
    /* The design's 1314 × 652 photo runs past the page edge, so it is cropped there, not shrunk.
       Keep it as tall as the design (652px at 1920 wide) and never shorter than its own shape. */
    .bleed .split-media { container-type: inline-size; }
    .bleed .split-media :global(.split-image) { height: max(calc(100cqi * 652 / 1314), calc(100vw * 652 / 1920)); }
    .bleed.media-end .split-media :global(.split-image) { object-position: left center; }
    .bleed.media-start .split-media :global(.split-image) { object-position: right center; }
  }
  @media (min-width: 90rem) {
    .media-end:not(.panel, .inset) { grid-template-columns: minmax(0, var(--width-copy)) minmax(0, 1fr); }
    .media-start:not(.panel, .inset) { grid-template-columns: minmax(0, 1fr) minmax(0, var(--width-copy)); }
  }
  @media (min-width: 100rem) {
    .split:not(.panel) { gap: var(--space-xl); }
    .split-caption { margin-inline-start: var(--space-lg); }
  }
  /* Framed opening photo: the frame draws the rounded left corners and border and clips the zoom; the photo inside is
   * square-cornered and borderless (it is the same shape at every width: bleed, photo on the right). */
  .split-frame { overflow: hidden; border: var(--border-thin) solid var(--border-image); border-right: 0; border-radius: var(--radius-image) 0 0 var(--radius-image); }
  .first.bleed .split-media .split-frame :global(.split-image) { display: block; border: 0; border-radius: 0; }
</style>
