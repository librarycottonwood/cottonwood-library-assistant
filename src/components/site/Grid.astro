---
/**
 * @component Grid
 * Equal-width columns that collapse to one column on phones.
 * @use Rows of Cards, or any set of same-sized items.
 * @avoid A photo next to text (use Split), or rows of buttons (use Stack direction="row").
 * @example
 * <Grid as="ul" columns={3} gap="md">
 *   {services.map(service => <Card as="li" title={service.title} image={service.image}>{service.description}</Card>)}
 * </Grid>
 */
import type { Space } from '../../design-system/tokens';
interface Props {
  /** Columns from tablet width (768px) up. Phones always get one column. */
  columns?: 2 | 3 | 4;
  gap?: Space;
  /** Use "ul" when the children are a list (then give each child as="li"). */
  as?: 'div' | 'ul';
  hidden?: boolean;
  [data: `data-${string}`]: string | boolean | undefined;
}
const { columns = 3, gap = 'md', as: Tag = 'div', ...attributes } = Astro.props;
---
<Tag data-gap={gap} class:list={['grid', `grid-${columns}`]} {...attributes}><slot /></Tag>
<style>
  .grid { display: grid; width: 100%; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) {
    .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
