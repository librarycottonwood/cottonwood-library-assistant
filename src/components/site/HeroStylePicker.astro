---
/**
 * @component HeroStylePicker
 * Temporary, collapsible comparison controls for the homepage heading.
 * @use Only beside HeroHeading while reviewing its two alternatives on a preview URL.
 * @avoid Shipping the picker after choosing the final treatment; it stays hidden on live hosts.
 * @example
 * <HeroStylePicker />
 */
const choices = [
  { value: 'handwritten', label: 'Handwritten' },
  { value: 'leaves', label: 'Leaf accent' },
  { value: 'plain', label: 'Plain' },
];
---
<script is:inline>
  // Apply shared-link selections before the heading paints. Live hosts never enable this tool.
  (() => {
    const preview = /^[a-f0-9]{8}\.cottonwood-library\.pages\.dev$/.test(location.hostname)
      || ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
    const value = new URLSearchParams(location.search).get('hero-style');
    if (preview && ['handwritten', 'leaves', 'plain'].includes(value)) {
      document.documentElement.dataset.heroStyle = value;
    }
  })();
</script>
<details class="hero-style" data-hero-style-picker hidden open>
  <summary>Hero styles <span>Preview only</span></summary>
  <fieldset>
    <legend>Compare heading styles</legend>
    {choices.map(choice => <label><input type="radio" name="hero-style" value={choice.value} checked={choice.value === 'handwritten'} /><span>{choice.label}</span></label>)}
  </fieldset>
</details>
<script>
  const picker = document.querySelector<HTMLDetailsElement>('[data-hero-style-picker]');
  const selected = document.documentElement.dataset.heroStyle;
  if (picker && selected) {
    picker.hidden = false;
    const inputs = picker.querySelectorAll<HTMLInputElement>('input[name="hero-style"]');
    for (const input of inputs) {
      input.checked = input.value === selected;
      input.addEventListener('change', () => {
        if (!input.checked) return;
        document.documentElement.dataset.heroStyle = input.value;
        const url = new URL(location.href);
        url.searchParams.set('hero-style', input.value);
        history.replaceState(history.state, '', url);
      });
    }
  }
</script>
<style>
  .hero-style[hidden] { display: none; }
  .hero-style { position: fixed; inset-inline-end: var(--space-xs); bottom: env(safe-area-inset-bottom); margin-block-end: var(--space-xs); z-index: 100; max-width: calc(100% - 2 * var(--space-xs)); padding: var(--space-xs); border: 1px solid var(--color-border); border-radius: var(--radius-none); background: var(--color-surface); color: var(--color-text); font-size: var(--text-utility); box-shadow: 0 4px 24px #0002; }
  summary { cursor: pointer; font-weight: var(--weight-bold); }
  summary span { margin-inline-start: var(--space-xs); color: var(--color-text-muted); font-size: .75em; font-weight: var(--weight-regular); }
  fieldset { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: var(--space-xs) 0 0; padding: 0; border: 0; }
  legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  label { display: flex; align-items: center; gap: var(--space-xs); min-height: 44px; padding-inline: var(--space-xs); cursor: pointer; }
  input { accent-color: var(--color-primary); }
  label:has(input:checked) { border-radius: var(--radius-none); background: var(--color-primary-soft); }
  @media (max-width: 47.999rem) {
    .hero-style { width: 13rem; }
    fieldset { grid-template-columns: repeat(1, minmax(0, 1fr)); }
  }
</style>
