---
/**
 * @component Card
 * Photo card with a title and a short description. With `href` the whole card is one link: click anywhere on it, only the title underlines, and the focus ring goes around the whole card. Use inside a Grid.
 * @use A set of similar things: events, services, programs, news posts. Three per row on desktop. layout="adaptive" when a card may end up alone in a full-width row (EventCards does this). shape="page" for a printed page such as a newsletter cover: shown whole, at letter size.
 * @avoid A single highlighted item that is always on its own (use Split), text without a photo, a description longer than two lines (it is cut off), or links and buttons inside the card (the card is already one link; a badge must not have href).
 * @example
 * <Grid as="ul" columns={3}>
 *   <Card as="li" title="Computers & Wi-Fi" href="/visit/#computers" image={photo}>Public computers and Wi-Fi.</Card>
 * </Grid>
 */
import Image from '../OptimizedImage.astro';
import Icon from '../Icon.astro';
import IconLink from './IconLink.astro';
import type { LibraryImage } from '../../content/types';
import { refreshPhoto } from '../../content/photography';
interface Props {
  title: string;
  /** Makes the whole card one link (the title is the link text). */
  href?: string;
  image: LibraryImage;
  /** Use "li" when the parent Grid is as="ul". */
  as?: 'article' | 'li' | 'div';
  /** stacked (default): photo above text. adaptive: photo beside text whenever the card is at least 48rem (768px) wide, e.g. alone in a row. */
  layout?: 'stacked' | 'adaptive';
  /** photo (default): a fixed-height photo. page: a letter-size page (8.5 × 11), e.g. a newsletter cover, shown whole. */
  shape?: 'photo' | 'page';
  /** Shows the picture as a logo: smaller, centered, with white space around it (sponsor and partner logos). */
  logo?: boolean;
  /** Shows the whole description instead of cutting it at two lines. Use when the card has no page with the full text. */
  fullText?: boolean;
  hidden?: boolean;
  [data: `data-${string}`]: string | undefined;
}
const { title, href, image: originalImage, as: Tag = 'article', layout = 'stacked', shape = 'photo', logo = false, fullText = false, ...attributes } = Astro.props;
const image = refreshPhoto(originalImage);
const hasBadge = Astro.slots.has('badge');
// The arrow stays on the line with the title's last word, so a wrapping title never leaves it alone on a line.
const titleWords = title.trim().split(/\s+/);
const titleEnd = titleWords.pop();
const titleStart = titleWords.join(' ');
---
<Tag data-motion="rise" class:list={['card', { 'card-linked': Boolean(href), 'card-adaptive': layout === 'adaptive' && shape === 'photo', 'card-page': shape === 'page', 'card-logo': logo, 'card-full-text': fullText }]} {...attributes}>
  <div class="card-body">
    <div class:list={['card-media', { 'has-badge': hasBadge }]}>
      <Image width={800} quality={70} image={image} alt="" widths={[400, 600, 800]} sizes="(max-width: 47.99rem) 100vw, 33vw" loading="lazy" class:list={['card-image', image.fit === 'contain' && 'is-contained']} />
      {hasBadge && <div class="card-badge"><slot name="badge" /></div>}
    </div>
    <div class="card-copy">
      <h3>{href ? <IconLink href={href}>{titleStart && `${titleStart} `}<span class="title-end">{titleEnd}<Icon name="arrow" class="icon-end" /></span></IconLink> : title}</h3>
      <p><slot /></p>
    </div>
  </div>
</Tag>
<style>
  /* Stretched link: the title link's ::after covers the whole card, so the card has exactly one link. */
  .card { position: relative; }
  .card-body { display: flex; flex-direction: column; gap: var(--space-md); height: 100%; }
  .card-media {
    position: relative; overflow: hidden;
    height: clamp(13rem, 19vw, 22.8125rem);
    border: var(--border-thin) solid var(--border-image); border-radius: var(--radius-image);
  }
  .card-page .card-media { height: auto; aspect-ratio: 8.5 / 11; }
  .has-badge::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 36%); pointer-events: none; }
  .card-media :global(.card-image) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--motion-smooth) var(--ease-out); }
  /* Linked cards: hovering anywhere zooms the photo slightly inside its frame and nudges the title arrow. */
  @media (hover: hover) {
    .card-linked:hover .card-media :global(.card-image:not(.is-contained)) { transform: scale(1.04); }
    .card-linked:hover .card-copy h3 :global(.icon-end) { transform: translateX(0.2em); }
  }
  .card-media :global(.card-image.is-contained) { object-fit: contain; background: var(--color-surface); }
  .card-logo .card-media { display: grid; place-items: center; background: var(--color-surface); }
  .card-logo .card-media :global(.card-image) { width: 60%; height: 60%; object-fit: contain; }
  /* right keeps a long schedule badge inside the photo at large text sizes; it wraps instead. */
  .card-badge { position: absolute; z-index: 1; top: var(--space-sm); left: var(--space-sm); right: var(--space-sm); display: flex; }
  .card-badge > :global(*) { min-width: 0; overflow-wrap: anywhere; }
  .card-copy { display: flex; flex-direction: column; gap: var(--space-sm); padding: 0 var(--space-md); }
  .card-copy h3 { margin: 0; font-size: inherit; font-weight: var(--weight-bold); line-height: var(--leading-snug); }
  /* Two lines at most, ending in "…" (long Sanity event summaries), so cards side by side read evenly. The full text is
   * on the linked page and stays readable to screen readers. Page-written card texts are kept to two lines. */
  .card-copy p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; color: var(--color-text-muted); }
  .card-full-text .card-copy p { display: block; -webkit-line-clamp: unset; line-clamp: none; overflow: visible; }
  /* A title that wraps keeps its arrow right after the last word instead of floating beside the whole block. */
  .card-copy h3 :global(.icon-link) { display: inline; }
  .title-end { white-space: nowrap; }
  .card-copy h3 :global(.icon-link .icon-end) { display: inline-block; margin-inline-start: var(--space-xs); vertical-align: -0.125em; }

  /* IconLink already underlines on hover; hovering anywhere on the card hovers the link. */
  .card-copy h3 :global(.icon-link)::after { content: ''; position: absolute; z-index: 1; inset: 0; border-radius: var(--radius-image); }
  .card-copy h3 :global(.icon-link:focus-visible) { outline: none; text-decoration-line: underline; }
  .card-copy h3 :global(.icon-link:focus-visible)::after { outline: 3px solid var(--color-primary); outline-offset: 3px; }

  /* Adaptive: photo beside the text when the card itself is wide (a container query, so it follows the card's real width). */
  .card-adaptive { container: card / inline-size; }
  @container card (min-width: 48rem) {
    .card-body { flex-direction: row; align-items: center; gap: var(--space-lg); }
    .card-media { flex: 1 1 0; height: auto; aspect-ratio: 16 / 9; }
    .card-copy { flex: 1 1 0; padding: 0 var(--space-md) 0 0; }
    .card-copy h3 { font-size: var(--fluid-lead); }
  }
</style>
