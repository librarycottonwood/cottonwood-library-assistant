---
/**
 * @component IconLink
 * A text link with an icon before or after it, underlined on hover.
 * @use Contact details (address, phone, email), "Library catalog ↗" style links.
 * @avoid Main actions (use Button) or links inside a sentence (use a plain link).
 * @example
 * <IconLink href={library.phoneHref} icon="phone">{library.phone}</IconLink>
 */
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Icon from '../Icon.astro';
type IconName = ComponentProps<typeof Icon>['name'];
interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'style'> {
  href: string;
  /** Icon before the text. */
  icon?: IconName;
  /** Icon after the text, in a muted color. */
  iconEnd?: IconName;
}
const { icon, iconEnd, ...attributes } = Astro.props;
---
<a class="icon-link" {...attributes}>{icon && <Icon name={icon} />}<slot />{iconEnd && <Icon name={iconEnd} class="icon-end" />}</a>
<style>
  .icon-link { display: inline-flex; align-items: center; gap: var(--space-xs); text-decoration-line: none; }
  .icon-link:hover { text-decoration-line: underline; }
  .icon-link :global(svg) { width: 1em; height: 1em; flex-shrink: 0; }
  .icon-link :global(.icon-end) { color: var(--color-text-muted); transition: transform var(--motion-quick) var(--ease-out); }
  @media (hover: hover) { .icon-link:hover :global(.icon-end) { transform: translateX(0.2em); } }
</style>
