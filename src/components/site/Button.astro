---
/**
 * @component Button
 * Pill-shaped call to action. A link when given `href`, otherwise a button element.
 * @use Main actions in a section: directions, donate, volunteer, "Read more", "View all".
 * @avoid Links inside a sentence (use a plain link), card titles (Card links them), or menus.
 * @example
 * <Stack direction="row" gap="xs" wrap>
 *   <Button href={library.directionsUrl} variant="accent" icon="navigate">Get directions</Button>
 *   <Button href="/visit/" iconEnd="arrow" screenReaderText="about visiting">Read more</Button>
 * </Stack>
 */
import type { ComponentProps } from 'astro/types';
import type { HTMLAttributes } from 'astro/types';
import Icon from '../Icon.astro';
type IconName = ComponentProps<typeof Icon>['name'];
interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'style' | 'type'> {
  href?: string;
  size?: 'default' | 'small';
  /** outline (default): quiet. accent: pale green, supporting. primary: indigo, one per view. */
  variant?: 'outline' | 'accent' | 'primary';
  /** Icon before the label. */
  icon?: IconName;
  /** Icon after the label (usually "arrow"). */
  iconEnd?: IconName;
  /** Only for <button>. */
  type?: 'button' | 'submit';
  /** Extra words only screen readers and search engines hear, so a short label like "Read more" says where it goes. */
  screenReaderText?: string;
}
const { href, size = 'default', variant = 'outline', icon, iconEnd, type = 'button', screenReaderText, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={['button', `button-${variant}`, `button-${size}`]} {...attributes}>{icon && <Icon name={icon} class={`button-icon icon-${icon}`} />}<slot />{screenReaderText && <span class="sr-only"> {screenReaderText}</span>}{iconEnd && <Icon name={iconEnd} class={`button-icon-end icon-${iconEnd}`} />}</Tag>
<style>
  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs);
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-thin) solid var(--color-primary-ink);
    border-radius: var(--radius-pill);
    background: transparent; color: var(--color-primary-ink);
    font: inherit; font-weight: var(--weight-bold); line-height: var(--leading-relaxed);
    /* Labels stay on one line unless the screen is too narrow (large text on small phones). */
    max-width: 100%; text-align: center; text-decoration-line: none; cursor: pointer;
    /* Entrance motion owns transform. Press feedback uses the independent scale property so Motion's
       finished-style cleanup cannot start a second CSS translate transition in WebKit. */
    transition-property: background-color, border-color, color, scale;
    transition-duration: var(--motion-quick); transition-timing-function: var(--ease-out);
  }
  /* Figma's button icons are slightly larger than the text and drawn bold; match that so bold labels don't outweigh them. */
  .button :global(svg) { width: 1.1em; height: 1.1em; flex-shrink: 0; stroke-width: 2.5; }
  /* Hover tints the button in its own color, never to white: outlined buttons take the pale indigo, green deepens a little. */
  .button:hover { background: var(--color-primary-soft); }
  .button-accent { border: var(--border-strong) solid var(--color-accent); background: var(--color-accent); color: var(--color-accent-ink); }
  .button-accent:hover { --accent-hover: color-mix(in oklab, var(--color-accent), var(--color-accent-ink) 12%); background: var(--accent-hover); border-color: var(--accent-hover); }
  .button-primary { border: var(--border-strong) solid var(--color-primary); background: var(--color-primary); color: var(--color-surface); }
  .button-primary:hover { background: var(--color-primary-ink); border-color: var(--color-primary-ink); }
  /* Micro-interactions: the button presses in, an end arrow nudges the way it points, and Donate's heart beats once. */
  .button :global(svg) { transition: transform var(--motion-quick) var(--ease-out); }
  .button:active { scale: 0.97; }
  @media (hover: hover) {
    .button:hover :global(.icon-arrow) { transform: translateX(0.2em); }
    .button:hover :global(.icon-external) { transform: translate(0.15em, -0.15em); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .button:hover :global(.icon-heart) { animation: heartbeat var(--motion-entrance) var(--ease-out); }
  }
  @keyframes heartbeat { 30% { transform: scale(1.25); } 60% { transform: scale(0.95); } }
.button-small { font-size: var(--fluid-label); min-height: 44px; }
</style>
