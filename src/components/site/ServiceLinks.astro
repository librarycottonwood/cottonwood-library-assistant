---
/**
 * @component ServiceLinks
 * Three practical service links with simple icons and complete descriptions, separated by rules instead of photo cards.
 * @use The homepage's compact service overview; detailed photos and instructions stay on Services.
 * @avoid Invented prices or embedding multiple actions inside one linked service.
 * @example
 * <ServiceLinks services={home.services} catalogUrl={home.library.catalogUrl} />
 */
import Icon from '../Icon.astro';
import type { HomeContent } from '../../content/types';
interface Props { services: HomeContent['services']; catalogUrl: string; }
const { services, catalogUrl } = Astro.props;
---
<ul class="service-links">
  {services.map(service => <li data-motion="rise"><a href={service.icon === 'book' ? catalogUrl : `/services/#${service.id}`}>
    <Icon name={service.icon} class="service-symbol" /><div class="service-copy"><h3>{service.title}</h3><p>{service.description}</p></div><Icon name="arrow" class="service-arrow" />
  </a></li>)}
</ul>
<style>
  .service-links { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; margin: 0; padding: 0; list-style: none; }
  .service-links li { min-width: 0; border-top: var(--border-thin) solid var(--color-border); }
  .service-links a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: var(--space-sm); padding-block: var(--space-md); text-decoration-line: none; }
  .service-symbol { width: 1.5em; height: 1.5em; color: var(--color-primary); }
  .service-copy { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .service-copy h3 { font-family: var(--font-body); font-size: var(--fluid-body); font-weight: var(--weight-bold); line-height: var(--leading-snug); overflow-wrap: anywhere; }
  .service-copy p { color: var(--color-text-muted); font-size: var(--fluid-label); text-wrap: pretty; }
  .service-arrow { width: 1em; height: 1em; }
  .service-links a:hover h3 { text-decoration-line: underline; }
  @media (min-width: 48rem) {
    .service-links { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
    .service-links a { grid-template-columns: minmax(0, 1fr) auto; }
    .service-symbol { grid-column: 1; }
    .service-copy { grid-column: 1; }
    .service-arrow { grid-column: 2; grid-row: 1; }
  }
</style>
