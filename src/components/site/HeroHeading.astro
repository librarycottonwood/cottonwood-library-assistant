---
/**
 * @component HeroHeading
 * The complete homepage heading, with optional handwritten or leaf-accent preview treatments.
 * @use Once in the opening homepage Split, preserving both complete CMS heading lines.
 * @avoid Repeating these accents on other headings or animating them separately from the copy.
 * @example
 * <HeroHeading lines={hero.heading} id="welcome-heading" />
 */
import Heading from './Heading.astro';
import leaves from '../../assets/decorations/hero-leaves.svg?raw';
import handwriting from '../../assets/fonts/caveat-latin-variable.woff2?url';
interface Props { lines: readonly string[]; id: string; }
const { lines, id } = Astro.props;
const secondLine = lines[1] ?? '';
const words = secondLine.match(/^(.*?)(\S+)\s*$/u);
const prefix = words?.[1] ?? '';
const lastWord = words?.[2] ?? secondLine;
---
<link rel="preload" href={handwriting} as="font" type="font/woff2" crossorigin="anonymous" />
<Heading level={1} size="display" id={id}>{lines[0]}<br /><span class="hero-line">{prefix}<span class="hero-word">{lastWord}<span class="hero-leaves" aria-hidden="true" set:html={leaves} /></span></span></Heading>
<style>
  @font-face { font-family: 'Hero Caveat'; src: url('../../assets/fonts/caveat-latin-variable.woff2') format('woff2'); font-weight: 400 700; font-style: normal; font-display: swap; }
  .hero-line, .hero-word { display: inline-block; position: relative; max-width: 100%; }
  .hero-leaves { display: none; width: .85em; height: .85em; vertical-align: top; color: var(--color-primary); pointer-events: none; }
  .hero-leaves :global(svg) { display: block; width: 100%; height: 100%; }
  :global(html[data-hero-style="handwritten"]) .hero-line { line-height: 1.16; }
  :global(html[data-hero-style="handwritten"]) .hero-word { font-family: 'Hero Caveat', cursive; font-size: 1.26em; font-weight: 650; line-height: .8; color: var(--color-primary); transform: rotate(-3deg); transform-origin: 50% 70%; }
  :global(html[data-hero-style="leaves"]) .hero-leaves { display: inline-block; transform: translateY(-10%); }
</style>
