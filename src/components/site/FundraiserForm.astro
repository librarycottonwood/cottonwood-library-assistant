---
/**
 * @component FundraiserForm
 * The active fundraiser's Givebutter Form widget: live goal bar and the donation form, right on the page (at #give). Without JavaScript, or until Givebutter's script loads, a link to the fundraiser's Givebutter page shows instead.
 * @use Only on Support Us (/donate/), inside the fundraiser's Split. Pass the campaign from activeCampaign().
 * @avoid Other pages (use a Donate Button with checkoutAttributes, which opens the same checkout as a popup), or typing totals by hand: the total always comes from Givebutter.
 * @example
 * <FundraiserForm campaign={campaign} />
 */
import IconLink from './IconLink.astro';
import Text from './Text.astro';
import { formatDay } from '../../content/feeds';
import { campaignAccount, givebutterScriptSrc, sitewideGivebutterAccount } from '../../content/donate';
import type { FundraisingCampaign } from '../../content/types';
interface Props { campaign: FundraisingCampaign; }
const { campaign } = Astro.props;
// Ids are validated (letters, digits, _ and -) before any page renders. BaseLayout already loads Givebutter's
// script when the Donate buttons open its popup; otherwise this loads it, so a page never gets two copies.
// Privacy: Givebutter's widget script is functional, separate from the consent-gated Analytics.
const script = await sitewideGivebutterAccount() ? undefined : givebutterScriptSrc(await campaignAccount(campaign));
---
<div id="give" class="fundraiser-form" data-frame-title={`Donation form: ${campaign.title}`}>
  <div class="fundraiser-slot">
    <givebutter-widget id={campaign.givebutter.formWidgetId}></givebutter-widget>
    <p class="fundraiser-fallback"><IconLink href={campaign.url} iconEnd="external">See progress and give on Givebutter<span class="sr-only"> for {campaign.title}</span></IconLink></p>
  </div>
  {campaign.endsOn && <Text tone="muted">Ends <time datetime={campaign.endsOn}>{formatDay(campaign.endsOn)}</time></Text>}
</div>
{script && <script is:inline async src={script}></script>}
<script is:inline>
  // Givebutter titles its form's frame "givebutter-iframe", which is what screen readers announce. Once the form has
  // loaded (inside Givebutter's open shadow roots), give the frame a real name. Gives up after 20 seconds.
  document.querySelectorAll('[data-frame-title]').forEach(function (box) {
    var find = function (root) {
      var frame = root.querySelector('iframe');
      if (frame) return frame;
      var hosts = root.querySelectorAll('*');
      for (var i = 0; i < hosts.length; i++) if (hosts[i].shadowRoot) { frame = find(hosts[i].shadowRoot); if (frame) return frame; }
      return null;
    };
    var tries = 0;
    var timer = setInterval(function () {
      var frame = find(box);
      if (frame) frame.title = box.dataset.frameTitle;
      if (frame || ++tries > 40) clearInterval(timer);
    }, 500);
  });
</script>
<style>
  .fundraiser-form { display: flex; flex-direction: column; gap: var(--space-sm); width: 100%; scroll-margin-block-start: var(--space-xl); }
  /* The fallback link sits in the same spot as the form, so nothing moves when the form replaces it. */
  .fundraiser-slot { display: grid; container-type: inline-size; }
  .fundraiser-slot > * { grid-area: 1 / 1; align-self: start; }
  givebutter-widget { display: block; width: 100%; }
  .fundraiser-slot:has(givebutter-widget:defined) .fundraiser-fallback { display: none; }
  /* Room for Givebutter's form before it loads, so the page doesn't jump down as it appears. These are the
     form's first-step heights at each width (Givebutter's own layout, measured Nov 2026); without JavaScript
     the form never loads, so no room is kept. If Givebutter changes its form, re-measure on /donate/. */
  givebutter-widget { --form-height: 54.4375rem; }
  @container (min-width: 15rem) { givebutter-widget { --form-height: 39.6875rem; } }
  @container (min-width: 18.125rem) { givebutter-widget { --form-height: 38.1875rem; } }
  @container (min-width: 24.375rem) { givebutter-widget { --form-height: 35.4375rem; } }
  @media (scripting: enabled) { givebutter-widget { min-height: var(--form-height); } }
</style>
