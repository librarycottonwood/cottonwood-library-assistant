---
/**
 * @component SiteFooter
 * @internal
 * Newsletter sign-up, then the footer with links, contact details, social icons and the Privacy links.
 * @use Nothing on pages: BaseLayout adds it to every page.
 * @avoid Adding another newsletter form or contact block to a page.
 * @example
 * <SiteFooter library={content.library} navigation={content.navigation} />
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import Icon from '../Icon.astro';
import Section from './Section.astro';
import Text from './Text.astro';
import InstagramIcon from '../InstagramIcon.astro';
import FacebookIcon from '../FacebookIcon.astro';
import signup from '../../content/newsletter-signup.json';
import { checkGivebutterId } from '../../content/feeds';
import { givebutterScriptSrc, sitewideGivebutterAccount } from '../../content/donate';
import type { HomeContent } from '../../content/types';
interface Props { library: HomeContent['library']; navigation: HomeContent['navigation']; }
const { library, navigation } = Astro.props;
checkGivebutterId(signup.account, 'newsletter signup account');
checkGivebutterId(signup.widgetId, 'newsletter signup widget');
// BaseLayout already loads Givebutter's script when Donate buttons use it.
const signupScript = await sitewideGivebutterAccount() ? undefined : givebutterScriptSrc(signup.account);
---
<Section title="Newsletter" headingId="newsletter-heading" width="copy" gap="md">
  <Text tone="muted">Sign up to get all the latest library news directly in your inbox, from the director herself.</Text>
  <givebutter-widget id={signup.widgetId} account={signup.account} class="newsletter-widget"></givebutter-widget>
  <Text size="label">Sign-up is handled by Givebutter. If the form doesn't load, <a href={`mailto:${library.email}?subject=Library%20newsletter`}>email the library</a>.</Text>
</Section>
{signupScript && <script is:inline async src={signupScript}></script>}
<footer class="site-footer">
  <Image src={logo} alt="" width={700} widths={[400, 700]} sizes="700px" loading="lazy" class="footer-watermark" />
  <a href="/" class="footer-brand" aria-label="Cottonwood Community Library home">
    <Image src={logo} alt="" width={163} densities={[1, 2]} loading="lazy" class="footer-logo" />
    <span aria-hidden="true">Cottonwood<br />Community<br />Library</span>
  </a>
  <nav aria-labelledby="footer-explore" class="footer-column">
    <h2 id="footer-explore">Explore</h2>
    <ul>
      <li><a href="/">Home</a></li>
      {navigation.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={library.catalogUrl} data-analytics-event="catalog_footer">Library Catalog<Icon name="external" class="footer-external" /></a></li>
    </ul>
  </nav>
  <div class="footer-column">
    <h2>Get in touch</h2>
    <ul>
      <li><a href={library.phoneHref}>{library.phone}</a></li>
      <li><a href={`mailto:${library.email}`}>{library.email}</a></li>
      <li>Mailing Address:<br />{library.mailingAddress}</li>
    </ul>
    <div class="social">
      <a href={library.instagramUrl} aria-label="Cottonwood Community Library on Instagram"><InstagramIcon class="social-icon" /></a>
      <span class="social-pending" title="Facebook link coming soon"><FacebookIcon class="social-icon" /><span class="sr-only">Facebook (link coming soon)</span></span>
    </div>
    <p class="footer-legal">
      <a href="/privacy/">Privacy</a>
      <!-- Analytics.astro shows this button (by id) on the live site and opens the statistics choice. -->
      <button id="privacy-choices" type="button" hidden>Privacy choices</button>
    </p>
  </div>
</footer>
<style>
  .newsletter-widget { display: block; width: 100%; }

  .site-footer {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--section-gap);
    padding: var(--section-space) var(--page-inset) var(--space-xl);
  }
  /* The tree stands on the footer's bottom edge and is never taller than the footer, so its base and crown both show.
   * translateY(3%) drops the image's transparent strip under the ground line (36 of 1207px) below the edge. */
  .site-footer :global(.footer-watermark) {
    position: absolute; z-index: -1; right: var(--page-inset); bottom: 0;
    width: auto; height: 100%; max-width: 45vw;
    object-fit: contain; object-position: right bottom;
    transform: translateY(3%);
    opacity: 0.06; pointer-events: none;
  }
  .footer-brand {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); width: 14.0625rem;
    font-weight: var(--weight-bold); line-height: var(--leading-tight); text-align: center; text-decoration-line: none;
  }
  .footer-brand :global(.footer-logo) { width: clamp(6rem, 8.5vw, 10.1875rem); }
  .footer-column { display: flex; flex-direction: column; gap: var(--space-sm); }
  .footer-column h2 { font-family: var(--font-body); font-size: inherit; font-weight: var(--weight-bold); line-height: var(--leading-tight); }
  .footer-column ul { display: flex; flex-direction: column; gap: var(--space-sm); margin: 0; padding: 0; list-style: none; color: var(--color-text-muted); font-weight: var(--weight-semibold); line-height: var(--leading-tight); }
  .footer-column a { text-decoration-line: none; }
  .footer-column a:hover { text-decoration-line: underline; }
  .footer-column :global(.footer-external) { display: inline; width: 0.9em; height: 0.9em; margin-inline-start: var(--space-xs); vertical-align: -0.05em; }
  .social { display: flex; gap: var(--space-sm); color: var(--color-text-muted); }
  .social a, .social-pending { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; }
  .social a { justify-content: flex-start; }
  .social :global(.social-icon) { width: 1.875rem; height: 1.875rem; }
  .social-pending { opacity: 0.6; }
  .footer-legal { display: flex; flex-wrap: wrap; gap: var(--space-sm); color: var(--color-text-muted); font-size: var(--fluid-label); font-weight: var(--weight-semibold); line-height: var(--leading-tight); }
  .footer-legal a, .footer-legal button { text-decoration-line: underline; }
  .footer-legal a:hover, .footer-legal button:hover { color: var(--color-text); }
  .footer-legal button {
    padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer;
    text-decoration-thickness: var(--underline-thickness); text-underline-offset: var(--underline-offset);
  }
  @media (max-width: 40rem) {
    .footer-brand { width: 100%; }
  }
</style>
