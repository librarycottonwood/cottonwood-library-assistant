---
// Upcoming event cards (Figma 1002:381). Pages are built ahead of time, so the visitor's
// browser hides occurrences after their end time, keeps `limit` cards showing, and
// fills in "Today", "Tomorrow" and "This Friday" badges.
import Image from '../OptimizedImage.astro';
import Icon from '../Icon.astro';
import type { LibraryEvent, LibraryImage, Program } from '../../content/types';
import { upcomingEvents } from '../../content/feeds';
interface Props { events: LibraryEvent[]; fallbackImage: LibraryImage; programs?: Program[]; limit?: number; emptyMessage?: string; }
const { fallbackImage, programs = [], limit = 3, emptyMessage = 'No special events are scheduled right now.' } = Astro.props;
const zone = 'America/Los_Angeles';
const dayKey = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: zone });
const shortDay = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: zone });
const fullDay = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: zone });
// Enough spare cards to rotate in as earlier ones end, without shipping every future date.
const events = upcomingEvents(Astro.props.events).slice(0, limit + 9);
const image = (event: LibraryEvent) => event.image ?? programs.find(program => program.id === event.programId)?.image ?? fallbackImage;
---
<div data-event-list data-event-limit={limit} class="event-list">
  <ul hidden={events.length === 0} data-event-rows class="event-cards">
    {events.map((event, index) => {
      const picture = image(event);
      return <li class="event-card" data-event-expires={event.endsAt} hidden={index >= limit}>
        <div class="event-media">
          <Image width={800} quality={70} image={picture} alt="" widths={[400, 600, 800]} sizes="(max-width: 47.99rem) 100vw, 33vw" loading="lazy" class:list={['event-image', picture.fit === 'contain' && 'is-contained']} />
          <time class="event-badge" datetime={event.startsAt} data-event-day={dayKey.format(new Date(event.startsAt))}>{shortDay.format(new Date(event.startsAt))}<span class="sr-only">, {fullDay.format(new Date(event.startsAt))}</span></time>
        </div>
        <div class="event-copy">
          <h3><a href={event.href}>{event.title}<Icon name="arrow" class="event-arrow" /></a></h3>
          <p>{event.summary}</p>
        </div>
      </li>;
    })}
  </ul>
  <p data-event-empty hidden={events.length > 0} class="event-empty">{emptyMessage}</p>
</div>
<script>
  const zone = 'America/Los_Angeles';
  const dayKey = (date: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
  const weekday = (key: string) => new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'long' }).format(new Date(`${key}T12:00:00Z`));
  const refreshEvents = () => {
    const now = Date.now();
    const today = dayKey(new Date(now)), tomorrow = dayKey(new Date(now + 864e5)), week = dayKey(new Date(now + 6 * 864e5));
    for (const list of document.querySelectorAll<HTMLElement>('[data-event-list]')) {
      const maximum = Number(list.dataset.eventLimit ?? Infinity);
      let shown = 0;
      for (const card of list.querySelectorAll<HTMLElement>('[data-event-expires]')) {
        const active = Date.parse(card.dataset.eventExpires!) >= now && shown < maximum;
        card.hidden = !active;
        if (active) shown++;
      }
      for (const badge of list.querySelectorAll<HTMLElement>('[data-event-day]')) {
        const key = badge.dataset.eventDay!;
        const label = key === today ? 'Today' : key === tomorrow ? 'Tomorrow' : key > today && key <= week ? `This ${weekday(key)}` : '';
        const visible = badge.firstChild;
        if (label && visible?.nodeType === Node.TEXT_NODE) { badge.dataset.dateLabel ??= visible.textContent ?? ''; visible.textContent = label; }
        else if (!label && visible?.nodeType === Node.TEXT_NODE && badge.dataset.dateLabel) visible.textContent = badge.dataset.dateLabel;
      }
      const rows = list.querySelector<HTMLElement>('[data-event-rows]');
      const empty = list.querySelector<HTMLElement>('[data-event-empty]');
      if (rows) rows.hidden = shown === 0;
      if (empty) empty.hidden = shown > 0;
    }
    for (const feature of document.querySelectorAll<HTMLElement>('[data-event-feature-expires]')) {
      feature.hidden = Date.parse(feature.dataset.eventFeatureExpires!) < now;
    }
  };
  refreshEvents();
  window.setInterval(refreshEvents, 30000);
  document.addEventListener('visibilitychange', refreshEvents);
</script>
<style>
  .event-cards { display: grid; gap: var(--gap-content); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .event-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .event-card { display: flex; flex-direction: column; gap: var(--gap-content); }
  .event-media {
    position: relative; overflow: hidden;
    height: clamp(13rem, 19vw, 22.8125rem);
    border: var(--border-thin) solid var(--border-image); border-radius: var(--radius-image);
  }
  .event-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 36%); pointer-events: none; }
  .event-media :global(.event-image) { width: 100%; height: 100%; object-fit: cover; }
  .event-media :global(.event-image.is-contained) { object-fit: contain; background: var(--color-surface); }
  .event-badge {
    position: absolute; z-index: 1; top: var(--space-16); left: var(--space-16);
    padding: var(--padding-badge-block) var(--padding-badge-end);
    border: var(--border-thin) solid var(--color-border); border-radius: var(--radius-pill);
    background: var(--color-surface); color: var(--color-forest);
    font-family: var(--font-label); font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight);
  }
  .event-copy { display: flex; flex-direction: column; gap: var(--gap-card-copy); padding: 0 var(--padding-card-inline); }
  .event-copy h3 { margin: 0; font-size: inherit; font-weight: var(--weight-bold); line-height: var(--leading-tight); }
  .event-copy a { display: inline-flex; align-items: center; gap: var(--gap-icon); text-decoration: none; }
  .event-copy a:hover { text-decoration: underline; }
  .event-copy :global(.event-arrow) { width: 1em; height: 1em; flex-shrink: 0; color: var(--color-text-muted); }
  .event-copy p { color: var(--color-text-muted); }
  .event-empty { color: var(--color-text-muted); text-align: center; }
</style>
