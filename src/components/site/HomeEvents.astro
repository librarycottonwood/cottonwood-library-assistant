---
/**
 * @component HomeEvents
 * An editorial events section: one regular program with a large photo, beside a compact, live-updating agenda.
 * @use On the homepage, giving library activities one shared destination instead of two consecutive photo/card sections.
 * @avoid Invented dates, separate expiry logic, or turning a fundraiser into a second large homepage appeal.
 * @example
 * <HomeEvents events={events} programs={programs} />
 */
import Image from '../OptimizedImage.astro';
import Icon from '../Icon.astro';
import Heading from './Heading.astro';
import IconLink from './IconLink.astro';
import EventCards from './EventCards.astro';
import { programHref } from './navigation';
import type { LibraryEvent, Program } from '../../content/types';
interface Props { events: LibraryEvent[]; programs: Program[]; }
const { events, programs } = Astro.props;
const featured = programs.find(program => program.audience === 'children') ?? programs[0];
const agendaPrograms = programs.filter(program => program.id !== featured?.id);
---
<section class="home-events" aria-labelledby="events-heading" id="at-the-library">
  <header class="events-heading" data-motion="group"><Heading id="events-heading">At the library</Heading><IconLink href="/events/" iconEnd="arrow">All events</IconLink></header>
  <div class:list={['events-layout', { 'has-program': featured }]}>
    {featured && <article class="program-feature" data-motion="rise">
      <a href={programHref(featured.id)} aria-labelledby="home-program-title">
        <Image image={featured.image} alt="" width={900} widths={[400, 600, 900]} sizes="(max-width: 47.99rem) 100vw, 45vw" loading="lazy" class="program-photo" />
        <div class="program-caption"><p class="program-schedule">{featured.schedule}</p><h3 id="home-program-title">{featured.title}</h3><p>{featured.description}</p><span class="program-link">Explore this program <Icon name="arrow" /></span></div>
      </a>
    </article>}
    <div class="events-agenda"><p class="agenda-label">Coming up</p><EventCards events={events} programs={agendaPrograms} limit={3} layout="list" /></div>
  </div>
</section>
<style>
  .home-events { max-width: var(--width-content); margin-inline: auto; padding: var(--section-space) var(--page-inset); box-sizing: content-box; }
  .events-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-sm); margin-block-end: var(--space-md); }
  .events-heading :global(.icon-link) { min-height: 2.75rem; font-size: var(--fluid-label); font-weight: var(--weight-bold); }
  .events-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
  .program-feature { min-width: 0; }
  .program-feature > a { display: flex; flex-direction: column; gap: var(--space-sm); text-decoration-line: none; }
  .program-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-image); box-shadow: var(--shadow-photo); }
  .program-caption { display: flex; flex-direction: column; gap: var(--space-xs); }
  .program-schedule { font-size: var(--fluid-label); color: var(--color-primary); font-weight: var(--weight-bold); }
  .program-caption h3 { font-family: var(--font-display); font-size: var(--fluid-heading); font-weight: var(--weight-regular); line-height: var(--leading-snug); }
  .program-caption > p:not(.program-schedule) { color: var(--color-text-muted); font-size: var(--fluid-body); text-wrap: pretty; }
  .program-link { display: flex; align-items: center; gap: var(--space-xs); margin-block-start: var(--space-xs); font-size: var(--fluid-label); font-weight: var(--weight-bold); }
  .program-link :global(svg) { width: 1em; height: 1em; }
  .program-feature a:hover h3 { text-decoration-line: underline; }
  .events-agenda { min-width: 0; }
  .agenda-label { margin-block-end: var(--space-xs); font-size: var(--fluid-label); font-weight: var(--weight-bold); }
  @media (min-width: 48rem) { .events-layout.has-program { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-md); } }
  @media (min-width: 80rem) { .events-layout.has-program { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-lg); } }
</style>
