---
/**
 * @component LeafAccent
 * A small family of outlined leaves: an upright sprig, a paired shoot, or a horizontal branch.
 * @use A quiet accent above a plain history, gratitude or ways-to-help heading. Section places it as part of the same heading group.
 * @avoid The homepage hero, functional labels, more than one per page, or a heading that already has handwriting or a crayon scene.
 * @example
 * <Section title="A place of our own" leaf="sprig" headingId="place-heading" />
 */
import sprig from '../../assets/decorations/leaves-sprig.svg?raw';
import pair from '../../assets/decorations/leaves-pair.svg?raw';
import branch from '../../assets/decorations/leaves-branch.svg?raw';
interface Props { variant?: 'sprig' | 'pair' | 'branch'; }
const { variant = 'sprig' } = Astro.props;
const artwork = { sprig, pair, branch };
---
<span class:list={['leaf-accent', `leaf-${variant}`]} data-leaf-variant={variant} aria-hidden="true" set:html={artwork[variant]} />
<style>
  .leaf-accent { display: block; flex-shrink: 0; width: clamp(2.5rem, 3vw, 3.5rem); max-width: 100%; color: var(--color-primary); pointer-events: none; }
  .leaf-pair { width: clamp(4rem, 5vw, 5rem); }
  .leaf-branch { width: clamp(4.5rem, 7vw, 7rem); }
  .leaf-accent :global(svg) { display: block; width: 100%; height: auto; }
</style>
