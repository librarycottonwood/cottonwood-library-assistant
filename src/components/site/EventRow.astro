---
/**
 * @component EventRow
 * A compact linked event row with a date, title and summary, without a photo frame.
 * @use Through EventCards layout="list", which supplies current dates, expiry and replacement programs.
 * @avoid Maintaining a separate calendar or replacing the detailed event page.
 * @example
 * <EventCards events={events} programs={programs} layout="list" limit={3} />
 */
import Icon from '../Icon.astro';
import type { LibraryImage } from '../../content/types';
interface Props {
  title: string;
  href: string;
  /** EventCards shares its item props with Card; list rows deliberately omit the image. */
  image?: LibraryImage;
  layout?: 'stacked' | 'adaptive';
  as?: 'article' | 'li' | 'div';
  hidden?: boolean;
  [data: `data-${string}`]: string | undefined;
}
const { title, href } = Astro.props;
const attributes = Object.fromEntries(Object.entries(Astro.props).filter(([key]) => key === 'hidden' || key.startsWith('data-')));
---
<li class="event-row" data-motion="rise" {...attributes}>
  <a href={href} class="event-row-link">
    <span class="event-row-date"><slot name="badge" /></span>
    <div class="event-row-copy"><h3>{title}</h3><p><slot /></p></div>
    <Icon name="arrow" class="event-row-arrow" />
  </a>
</li>
<style>
  .event-row { min-width: 0; border-top: var(--border-thin) solid var(--color-border); }
  .event-row-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: var(--space-xs) var(--space-sm); min-height: 2.75rem; padding-block: var(--space-sm); text-decoration-line: none; }
  .event-row-date { grid-column: 1; color: var(--color-primary); }
  .event-row-date :global(.badge) { display: inline; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-size: var(--fluid-label); line-height: var(--leading-relaxed); }
  .event-row-copy { grid-column: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .event-row-copy h3 { margin: 0; font-family: var(--font-body); font-size: var(--fluid-body); font-weight: var(--weight-bold); line-height: var(--leading-snug); overflow-wrap: anywhere; }
  .event-row-copy p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; color: var(--color-text-muted); font-size: var(--fluid-label); line-height: var(--leading-relaxed); text-wrap: pretty; }
  .event-row-arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: 1.1em; height: 1.1em; color: var(--color-primary); }
  .event-row-link:hover h3 { text-decoration-line: underline; }
  @media (min-width: 64rem) {
    .event-row-link { grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: var(--space-sm); }
    .event-row-copy { grid-column: 2; }
    .event-row-arrow { grid-column: 3; grid-row: 1; }
  }
</style>
