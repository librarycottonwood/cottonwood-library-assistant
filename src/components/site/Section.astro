---
/**
 * @component Section
 * One full-width band of the page: page-edge inset, vertical rhythm, an optional heading, and its content stacked below.
 * @use Every top-level block of a page that isn't a photo-beside-text block (use Split for those).
 * @avoid Nesting Sections, or wrapping a Split in a Section. Inside a Section use Stack and Grid.
 * @example
 * <Section title="Library services" headingId="services-heading">
 *   <Grid as="ul" columns={3}>…</Grid>
 *   <Button href="/visit/" iconEnd="arrow">Read more</Button>
 * </Section>
 */
import Heading from './Heading.astro';
import LibraryIllustration from './LibraryIllustration.astro';
import LeafAccent from './LeafAccent.astro';
import type { Space } from '../../design-system/tokens';
interface Props {
  /** Section heading (h2). Leave out and put your own Heading in the slot if you need markup inside it. */
  title?: string;
  /** A centered crayon scene above the heading, kept in the layout so it cannot cover content. */
  illustration?: 'reading' | 'computers' | 'books' | 'community';
  /** Centered botanical above a history or gratitude heading, at most once per page. Practical listings stay plain. */
  leaf?: 'sprig' | 'pair' | 'branch';
  /** id for the heading; the section is labelled by it. */
  headingId?: string;
  /** center: heading and items centered (default). start: left-aligned. */
  align?: 'center' | 'start';
  /** content: up to 1520px (default). full: the whole width inside the page inset (Figma About Us gallery). article: 1120px (an event's text, a news list). text: a 920px column for FAQs and articles. copy: a 622px column. */
  width?: 'content' | 'full' | 'article' | 'text' | 'copy';
  /** Space between heading, content and actions. Defaults to the responsive section gap (20/30/60px). */
  gap?: Space;
  /** Continues the block above (Service View's line under its photo): no space on top, only the block's own space below. */
  continues?: boolean;
  id?: string;
}
const { title, illustration, leaf, headingId, align = 'center', width = 'content', gap, continues = false, id } = Astro.props;
---
<section id={id} aria-labelledby={headingId} class:list={['section', { continues }]}>
  <div data-gap={gap} data-motion="group" class:list={['section-inner', `align-${align}`, `width-${width}`]}>
    {title && (illustration || leaf
      ? <div class:list={['illustrated-heading', { 'leaf-heading': !illustration && leaf }]}>
          {illustration ? <LibraryIllustration scene={illustration} /> : leaf && <LeafAccent variant={leaf} />}
          <Heading id={headingId} relaxed={align === 'center' && !leaf}>{title}</Heading>
        </div>
      : <Heading id={headingId} relaxed={align === 'center'}>{title}</Heading>)}
    <slot />
  </div>
</section>
<style>
  .section { padding: var(--section-space) var(--page-inset); }
  .continues { padding-block-start: 0; }
  .section-inner { display: flex; flex-direction: column; margin-inline: auto; }
  .section-inner:not([data-gap]) { gap: var(--section-gap); }
  .width-content { max-width: var(--width-content); }
  .width-full { width: 100%; }
  .width-article { width: 100%; max-width: var(--width-article); }
  .width-text { max-width: var(--width-text); }
  .width-copy { max-width: var(--width-copy); }
  /* Text and FAQ columns fill their width even when their lines are short. */
  .width-text { width: 100%; }
  .align-center { align-items: center; }
  .align-center > :global(:is(h2, p)) { text-align: center; }
  .align-start { align-items: flex-start; }
  .illustrated-heading { display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); width: 100%; }
  .leaf-heading { gap: var(--space-xs); }
  .illustrated-heading :global(h2) { min-width: 0; text-align: center; }
  .align-start .illustrated-heading { align-items: flex-start; }
  .align-start .illustrated-heading :global(.illustration) { align-self: flex-start; }
  .align-start .illustrated-heading :global(h2) { text-align: start; }
  .leaf-heading, .align-start .leaf-heading { align-items: center; }
  .leaf-heading :global(h2), .align-start .leaf-heading :global(h2) { text-align: center; }
</style>
