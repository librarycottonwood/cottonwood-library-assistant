---
/**
 * @component NewsletterForm
 * @internal
 * The library's own newsletter sign-up form, as in Figma: an email field with a Sign up button beside it. It posts to /api/newsletter, which adds the person to the library's Givebutter mailing list; it works with or without JavaScript and offers an email link if sign-up fails.
 * @use Nothing on pages: SiteFooter shows it on every page.
 * @avoid A second sign-up form on the same page (the result messages use fixed ids), or Givebutter's signup widget.
 * @example
 * <NewsletterForm email={library.email} labelledBy="newsletter-heading" />
 */
import Button from './Button.astro';
import { NEWSLETTER_ENDPOINT, newsletterMailto, newsletterMessages, newsletterStatuses } from '../../content/newsletter';
interface Props {
  /** The library's email address, for the fallback link when sign-up fails. */
  email: string;
  /** id of the heading that names the form. */
  labelledBy?: string;
}
const { email, labelledBy } = Astro.props;
// Without JavaScript the server sends the visitor back to this page.
const returnPath = Astro.url.pathname;
---
<form class="newsletter-form" action={NEWSLETTER_ENDPOINT} method="post" aria-labelledby={labelledBy} data-newsletter-form>
  <input type="hidden" name="return" value={returnPath} />
  <div class="newsletter-row">
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input id="newsletter-email" type="email" name="email" required maxlength="254" autocomplete="email" spellcheck="false" placeholder="Email" />
    <Button type="submit" variant="primary">Sign up</Button>
  </div>
  <!-- Left empty by people; bots that fill it are ignored. -->
  <div class="sr-only" aria-hidden="true">
    <label for="newsletter-website">Leave this empty</label>
    <input id="newsletter-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div role="status">
    {newsletterStatuses.map(status => (
      <p id={`newsletter-${status}`} class="newsletter-status" data-newsletter-status={status}>
        {newsletterMessages[status]}
        {status === 'error' && <> Please <a href={newsletterMailto(email)}>email the library</a> to join.</>}
      </p>
    ))}
  </div>
</form>
<script>
  import '../../scripts/newsletter-form';
</script>
<style>
  .newsletter-form { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); width: 100%; text-align: center; container-type: inline-size; }
  .newsletter-row { display: flex; gap: var(--space-xs); width: 100%; }
  .newsletter-row input {
    flex: 1; min-width: 0; min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-strong) solid var(--color-text-muted); border-radius: var(--radius-pill);
    background: transparent; color: var(--color-text);
    font: inherit; font-weight: var(--weight-medium);
  }
  .newsletter-row input::placeholder { color: var(--color-text-muted); opacity: 1; }
  .newsletter-row input:focus-visible { border-color: var(--color-primary); }
  /* Very narrow: field above, button full width below. */
  @container (max-width: 17rem) {
    .newsletter-row { flex-direction: column; }
  }
  /* Result messages: shown by #newsletter-<status> after a no-JavaScript submit, or by the script (data-shown). */
  .newsletter-status { display: none; font-weight: var(--weight-semibold); }
  .newsletter-form:not([data-enhanced]) .newsletter-status:target, .newsletter-status[data-shown] { display: block; }
  .newsletter-status a { text-decoration-line: underline; }
</style>
