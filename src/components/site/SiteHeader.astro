---
/**
 * @component SiteHeader
 * @internal
 * Opening-hours strip, then the header bar (logo, main navigation, Donate button, phone menu), which sticks to the top while the strip scrolls away.
 * @use Nothing on pages: BaseLayout adds it to every page.
 * @avoid Adding a second header or navigation to a page.
 * @example
 * <SiteHeader library={content.library} />
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import Icon from '../Icon.astro';
import Button from './Button.astro';
import { isCurrentPage, mainNavigation as links, supportLink } from './navigation';
import type { HomeContent } from '../../content/types';
interface Props { library: HomeContent['library']; }
const { library } = Astro.props;
const isCurrent = (href: string) => isCurrentPage(href, Astro.url.pathname);
---
<div class="hours-strip">
  <p><Icon name="clock" class="hours-icon" /><span><span class="sr-only">Library hours: </span>{library.hoursSummary}</span></p>
</div>
<header class="site-header">
  <a href="/" class="brand" aria-label="Cottonwood Community Library home">
    <Image src={logo} alt="" width={129} densities={[1, 2]} loading="eager" class="brand-logo" />
    <span class="brand-name" aria-hidden="true">Cottonwood<br />Community<br />Library</span>
  </a>
  <nav aria-label="Main navigation" class="site-nav">
    {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <!-- Goes to the Support Us page (its button opens Givebutter's popup). The click still counts as donate_header. -->
    <Button href={supportLink.href} aria-current={isCurrent(supportLink.href) ? 'page' : undefined} data-analytics-event="donate_header" variant="primary" icon="heart">Donate</Button>
    <button id="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-mobile-nav" class="menu-toggle">
      <Icon name="menu" class="menu-open" /><Icon name="close" class="menu-close" /><span class="sr-only">Menu</span>
    </button>
  </div>
  <nav id="site-mobile-nav" aria-label="Mobile navigation" class="mobile-nav">
    {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    <a href={library.catalogUrl} data-analytics-event="catalog_mobile">Library catalog <Icon name="external" class="mobile-external" /></a>
  </nav>
</header>
<script>
  // Sticky header: a line under it only once the hours strip has scrolled away, and anchor
  // targets (#give, #visit…) land below it. The header height is measured, so it isn't a spacing value.
  const header = document.querySelector<HTMLElement>('.site-header');
  const strip = document.querySelector<HTMLElement>('.hours-strip');
  if (header) {
    const root = document.documentElement;
    new ResizeObserver(() => { root.style.scrollPaddingTop = `${header.offsetHeight}px`; }).observe(header);
    if (strip) new IntersectionObserver(([entry]) => { header.toggleAttribute('data-stuck', !entry!.isIntersecting); }).observe(strip);
  }
  const toggle = document.querySelector<HTMLButtonElement>('#site-menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-mobile-nav');
  if (toggle && menu) {
    toggle.hidden = false;
    menu.hidden = true;
    const setOpen = (open: boolean) => { menu.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); } });
    window.matchMedia('(min-width: 90rem)').addEventListener('change', () => setOpen(false));
  }
</script>
<style>
  .hours-strip {
    display: flex; justify-content: center;
    padding: var(--space-xs) var(--page-inset);
    background: var(--color-primary); color: var(--color-surface);
    font-family: var(--font-body); font-size: var(--fluid-label); font-weight: var(--weight-medium); line-height: var(--leading-tight);
    text-align: center;
  }
  .hours-strip p { display: flex; align-items: center; gap: var(--space-xs); }
  .hours-strip :global(.hours-icon) { width: 1em; height: 1em; flex-shrink: 0; color: var(--color-icon-muted); }

  /* Above page content (z-index 1 inside cards), below the statistics panel (60), the skip link (100) and Givebutter's popup. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-xs);
    padding: var(--space-xs) var(--page-inset);
    border-bottom: var(--border-thin) solid transparent;
    background: var(--color-background);
    transition: border-color 0.15s;
    container: site-header / inline-size;
  }
  .site-header[data-stuck] { border-bottom-color: var(--color-border); }
  /* An open phone menu can be taller than a landscape or zoomed-in screen; let it scroll so every link is reachable. */
  .site-header:has(.menu-toggle[aria-expanded='true']) { max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain; }
  /* Below desktop the logo, wordmark, Donate and menu share one row. The brand takes the space Donate and the menu
   * leave; it is a container so the wordmark hides when that space is too narrow for it (screens under about 380px). */
  .brand { display: flex; align-items: center; gap: var(--space-xs); min-width: 2.75rem; flex: 1 1 0; container: brand / inline-size; text-decoration-line: none; }
  .brand :global(.brand-logo) { width: 2.75rem; flex-shrink: 0; }
  .brand-name { font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight); white-space: nowrap; }
  @container brand (width < 9rem) { .brand-name { display: none; } }
  /* Very narrow or zoomed-in phones: Donate keeps its heart and drops the word (still read out as "Donate"),
   * so the logo, Donate and menu stay on one row. */
  @container site-header (width < 15rem) {
    .header-actions :global(.button) { font-size: 0; gap: 0; width: 2.75rem; padding: 0; }
    .header-actions :global(.button svg) { width: 1.25rem; height: 1.25rem; }
    .brand { min-width: 2.25rem; }
    .brand :global(.brand-logo) { width: 2.25rem; }
  }
  .site-nav { display: none; gap: var(--space-md); font-weight: var(--weight-semibold); }
  .site-nav a, .mobile-nav a { text-decoration-line: none; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { text-decoration-line: underline; }
  .header-actions { display: flex; flex: 0 0 auto; justify-content: flex-end; align-items: center; gap: var(--space-xs); }
  .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem;
    border: var(--border-thin) solid var(--color-primary-ink); border-radius: var(--radius-pill);
    background: transparent; color: var(--color-primary-ink); cursor: pointer;
  }
  .menu-toggle :global(svg) { width: 1.25rem; height: 1.25rem; }
  .menu-toggle[aria-expanded='true'] :global(.menu-open), .menu-toggle[aria-expanded='false'] :global(.menu-close) { display: none; }
  .mobile-nav { display: flex; flex-direction: column; flex-basis: 100%; padding-top: var(--space-xs); font-weight: var(--weight-semibold); }
  .mobile-nav a { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-xs) 0; border-top: var(--border-thin) solid var(--color-border); }
  .mobile-nav :global(.mobile-external) { width: 1em; height: 1em; }
  /* The phone menu starts closed before the script runs, so pages don't open with the menu showing and then jump
   * up. Without JavaScript the links simply stay listed and there is no menu button. */
  @media (scripting: enabled) { .site-header:has(.menu-toggle[aria-expanded='false']) .mobile-nav { display: none; } }
  @media (scripting: none) { .menu-toggle { display: none; } }

  @media (min-width: 48rem) {
    .hours-strip, .site-header { padding-block: var(--space-sm); }
    .site-header, .brand { gap: var(--space-sm); }
    .brand :global(.brand-logo) { width: clamp(3.5rem, 6.7vw, 8.0625rem); }
    .brand-name { font-size: clamp(1.125rem, 0.8rem + 0.9vw, var(--text-lead)); }
  }
  @media (min-width: 90rem) {
    .site-header { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-md); }
    .brand { justify-self: start; container-type: normal; }
    .header-actions { justify-self: end; }
    .site-nav { display: flex; }
    .menu-toggle, .mobile-nav { display: none; }
  }
  @media (min-width: 100rem) {
    .hours-strip, .site-header { padding-block: var(--space-md); }
    .site-nav { gap: var(--space-lg); }
  }
</style>
