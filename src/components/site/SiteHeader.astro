---
// Hours strip and header (Figma 1006:227, 1006:228).
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import Icon from '../Icon.astro';
import { checkoutAttributes, getDonateLink } from '../../content/donate';
import type { HomeContent } from '../../content/types';
interface Props { library: HomeContent['library']; navigation: HomeContent['navigation']; }
const { library, navigation } = Astro.props;
const donate = await getDonateLink();
// The Donate button covers the giving page, so it isn't repeated as a menu link.
const links = navigation.filter(item => item.href !== '/fundraising-events/');
const isCurrent = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href);
---
<div class="hours-strip">
  <p><Icon name="clock" class="hours-icon" /><span><span class="sr-only">Library hours: </span>{library.hoursSummary}</span></p>
</div>
<header class="site-header">
  <a href="/" class="brand" aria-label="Cottonwood Community Library home">
    <Image src={logo} alt="" width={129} densities={[1, 2]} loading="eager" class="brand-logo" />
    <span class="brand-name" aria-hidden="true">Cottonwood<br />Community<br />Library</span>
  </a>
  <nav aria-label="Main navigation" class="site-nav">
    {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <a href={donate.href} {...checkoutAttributes(donate)} data-analytics-event="donate_header" class="action action-primary donate"><Icon name="heart" />Donate</a>
    <button id="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-mobile-nav" class="menu-toggle" hidden>
      <Icon name="menu" class="menu-open" /><Icon name="close" class="menu-close" /><span class="sr-only">Menu</span>
    </button>
  </div>
  <nav id="site-mobile-nav" aria-label="Mobile navigation" class="mobile-nav">
    {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    <a href={library.catalogUrl} data-analytics-event="catalog_mobile">Library catalog <Icon name="external" class="mobile-external" /></a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#site-menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-mobile-nav');
  if (toggle && menu) {
    toggle.hidden = false;
    menu.hidden = true;
    const setOpen = (open: boolean) => { menu.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); } });
    window.matchMedia('(min-width: 90rem)').addEventListener('change', () => setOpen(false));
  }
</script>
<style>
  .hours-strip {
    display: flex; justify-content: center;
    padding: clamp(0.75rem, 1.6vw, var(--space-30)) var(--page-inline);
    background: var(--color-primary); color: var(--color-surface);
    font-family: var(--font-label); font-size: var(--fluid-label); font-weight: var(--weight-medium); line-height: var(--leading-tight);
    text-align: center;
  }
  .hours-strip p { display: flex; align-items: center; gap: var(--gap-icon); }
  .hours-strip :global(.hours-icon) { width: 1em; height: 1em; flex-shrink: 0; color: var(--color-icon-muted); }

  .site-header {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-20);
    padding: clamp(1rem, 1.6vw, var(--space-30)) var(--page-inline);
    background: var(--color-background);
  }
  .brand { display: flex; align-items: center; gap: var(--space-16); text-decoration: none; flex: 0 1 31.25rem; }
  .brand :global(.brand-logo) { width: clamp(3.5rem, 6.7vw, 8.0625rem); }
  .brand-name { font-size: clamp(1.125rem, 0.8rem + 0.9vw, var(--text-lead)); font-weight: var(--weight-bold); line-height: var(--leading-tight); }
  .site-nav { display: none; gap: var(--gap-navigation); font-weight: var(--weight-semibold); }
  .site-nav a, .mobile-nav a { text-decoration: none; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.3em; }
  .header-actions { display: flex; flex: 0 1 31.25rem; justify-content: flex-end; align-items: center; gap: var(--space-10); }
  .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem;
    border: var(--border-thin) solid var(--color-primary-ink); border-radius: var(--radius-pill);
    background: transparent; color: var(--color-primary-ink); cursor: pointer;
  }
  .menu-toggle :global(svg) { width: 1.25rem; height: 1.25rem; }
  .menu-toggle[aria-expanded='true'] :global(.menu-open), .menu-toggle[aria-expanded='false'] :global(.menu-close) { display: none; }
  .mobile-nav { display: flex; flex-direction: column; flex-basis: 100%; padding-top: var(--space-10); font-weight: var(--weight-semibold); }
  .mobile-nav a { display: flex; align-items: center; gap: var(--space-10); padding: var(--space-10) 0; border-top: var(--border-thin) solid var(--color-border); }
  .mobile-nav :global(.mobile-external) { width: 1em; height: 1em; }

  @media (max-width: 40rem) {
    .donate { padding-inline: var(--space-16); }
  }
  @media (min-width: 90rem) {
    .site-header { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-30); }
    .brand { justify-self: start; }
    .header-actions { justify-self: end; }
    .site-nav { display: flex; gap: clamp(var(--space-24), 3.1vw, var(--gap-navigation)); }
    .menu-toggle, .mobile-nav { display: none; }
  }
</style>
