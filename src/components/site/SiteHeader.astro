---
/**
 * @component SiteHeader
 * @internal
 * Opening-hours strip, then the header bar (logo, main navigation, Donate button, phone menu), which sticks to the top while the strip scrolls away.
 * @use Layouts only. Layouts supply link data and optional action slots. The public site uses this header; reading layouts share its menu primitives and behavior.
 * @avoid Adding a second header or navigation to a page.
 * @example
 * <SiteHeader library={content.library} />
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import Icon from '../Icon.astro';
import HeaderMenu from './HeaderMenu.astro';
import MenuToggle from './MenuToggle.astro';
import Button from './Button.astro';
import { isCurrentSection, mainNavigation as links, supportLink } from './navigation';
import type { HomeContent } from '../../content/types';
interface MenuLink { label: string; href: string; external?: boolean; }
interface Props { library?: HomeContent['library']; navigation?: MenuLink[]; mobileNavigation?: MenuLink[]; activeHref?: string; homeHref?: string; }
const { library, navigation = links as MenuLink[], mobileNavigation = navigation, activeHref, homeHref = '/' } = Astro.props;
const isCurrent = (href: string) => { if (activeHref) return href === activeHref; const link = [...links, supportLink].find(item => item.href === href); return link ? isCurrentSection(link, Astro.url.pathname) : false; };
// Keep the canonical CMS hours intact. Phones use two centered rows with short days and unchanged times.
const openHours = (library?.hours ?? []).filter(row => !/^closed$/i.test(row.hours));
const hoursParts = openHours.length ? openHours : [{ days: '', hours: library?.hoursSummary ?? '' }];
const shortDays: Record<string, string> = { Monday: 'Mon', Tuesday: 'Tue', Wednesday: 'Wed', Thursday: 'Thu', Friday: 'Fri', Saturday: 'Sat', Sunday: 'Sun' };
const compactDays = (days: string) => days.replace(/\b(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\b/g, day => shortDays[day]!);
---
{library && <div class="toolbar-tint" aria-hidden="true"></div>}
<!-- Opening hours have their own landmark for screen-reader navigation. -->
{library && <aside class="hours-strip" aria-label="Opening hours">
  <p>
    <Icon name="clock" class="hours-icon" />
    <span class="sr-only" data-nosnippet>Library hours: {library?.hoursSummary}</span>
    <span class="hours-groups" aria-hidden="true" data-nosnippet>{hoursParts.map(part => <span class="hours-part">
      {part.days && <><span class="hours-day"><span class="hours-full">{part.days}</span><span class="hours-short" aria-hidden="true">{compactDays(part.days)}</span></span>{' '}</>}
      <span class:list={['hours-time', { 'hours-only': !part.days }]}>{part.hours}</span>
    </span>)}</span>
  </p>
</aside>}
<header class="site-header">
 <div class="header-inner">
  <a href={homeHref} class="brand" aria-label="Cottonwood Community Library home">
    <Image src={logo} alt="" width={129} densities={[1, 2]} loading="eager" class="brand-logo" />
    <span class="brand-name" aria-hidden="true" data-nosnippet>Cottonwood<br />Community<br />Library</span>
  </a>
  <nav aria-label="Main navigation" class="site-nav">
    {navigation.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span data-nosnippet>{item.label}</span>{item.external && <Icon name="external" />}</a>)}
    <slot name="navigation-actions" />
  </nav>
  <div class="header-actions">
    <!-- Goes to the Support Us page (its button opens Givebutter's popup). The click still counts as donate_header. -->
    <slot name="action"><Button href={supportLink.href} aria-current={isCurrent(supportLink.href) ? 'page' : undefined} data-analytics-event="donate_header" variant="primary" icon="heart"><span data-nosnippet>Donate</span></Button></slot>
    <MenuToggle />
  </div>
 </div>
</header>
<!-- Outside the header: the header is a container (for its narrow-phone rules), which would trap a fixed panel inside it. -->
<HeaderMenu links={[
  ...mobileNavigation.map(item => ({ ...item, current: isCurrent(item.href) })),
  ...(library ? [{ label: 'Library catalog', href: library.catalogUrl, external: true, analytics: 'catalog_mobile' }] : []),
]} />
<style>
  /* Safari 26 ignores <meta name="theme-color"> and colors its toolbar from a fixed or sticky element touching the top
   * of the page. At the top that is this strip (the hours bar's color, or the notices' green when they show);
   * once the page scrolls it slides away and Safari takes the sticky header's color. Browsers without scroll-driven
   * animations never show it. */
  .toolbar-tint { display: none; }
  @supports (animation-timeline: scroll()) {
    .toolbar-tint {
      display: block; position: fixed; top: 0; right: 0; left: 0; z-index: 40;
      height: 0.375rem; background: var(--color-primary); pointer-events: none;
      animation: toolbar-tint-away linear both; animation-timeline: scroll(); animation-range: 0.625rem 0.6875rem;
    }
    :global(body:has(.library-notices:not([hidden]))) .toolbar-tint { background: var(--color-accent); }
  }
  @keyframes toolbar-tint-away { to { transform: translateY(-200%); } }
  .hours-strip {
    display: flex; justify-content: center;
    padding: var(--space-xs) var(--page-inset);
    background: var(--color-primary); color: var(--color-surface);
    font-family: var(--font-body); font-size: var(--text-utility); font-weight: var(--weight-medium); line-height: var(--leading-relaxed);
    text-align: center;
  }
  .hours-strip p { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
  .hours-groups { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-xs) var(--space-sm); min-width: 0; }
  /* Schedules stay separate; their text can reflow when enlarged or on very narrow screens. */
  .hours-part { max-width: 100%; }
  .hours-short { display: none; }
  .hours-strip :global(.hours-icon) { width: 1em; height: 1em; flex-shrink: 0; color: inherit; opacity: .8; }
  @media (max-width: 47.99rem) {
    .hours-strip { line-height: var(--leading-relaxed); }
    .hours-strip p { width: 100%; }
    .hours-strip :global(.hours-icon) { display: none; }
    .hours-groups { width: 100%; flex-direction: column; align-items: center; gap: 0; }
    .hours-part { display: flex; flex: 0 0 auto; flex-direction: row; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0 var(--space-xs); min-width: 0; }
    .hours-day, .hours-time { overflow-wrap: anywhere; }
    .hours-day { font-weight: var(--weight-semibold); }
    .hours-full { display: none; }
    .hours-short { display: inline; }
  }

  /* Above page content (z-index 1 inside cards), below the statistics panel (60), the skip link (100) and Givebutter's popup. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: block; font-size: var(--fluid-label);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: var(--border-thin) solid transparent;
    background: var(--page-background, var(--color-background));
    transition: border-color var(--motion-quick) var(--ease-out);
    container: site-header / inline-size;
  }
  .header-inner { display: flex; align-items: center; gap: var(--space-xs); width: 100%; max-width: var(--width-content); margin-inline: auto; }
  .site-header { border-bottom-color: var(--color-border); }
  /* Below desktop the logo, wordmark, Donate and menu share one row. The brand takes the space Donate and the menu
   * leave; it is a container so the wordmark hides when that space is too narrow for it (screens under about 380px). */
  .brand { display: flex; align-items: center; gap: var(--space-xs); min-width: 2.75rem; flex: 1 1 0; container: brand / inline-size; text-decoration-line: none; }
  .brand :global(.brand-logo) { width: 2.75rem; flex-shrink: 0; }
  .brand-name { font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight); white-space: nowrap; }
  @container brand (width < 9rem) { .brand-name { display: none; } }
  /* Very narrow or zoomed-in phones: Donate keeps its heart and drops the word (still read out as "Donate"),
   * so the logo, Donate and menu stay on one row. */
  @container site-header (width < 15rem) {
    .header-actions :global(.button) { font-size: 0; gap: 0; width: 2.75rem; padding: 0; }
    .header-actions :global(.button svg) { width: 1.25rem; height: 1.25rem; }
    .brand { min-width: 2.25rem; }
    .brand :global(.brand-logo) { width: 2.25rem; }
  }
  .site-nav { display: none; align-items: center; gap: var(--space-md); font-weight: var(--weight-semibold); }
  .site-nav > a { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .site-nav > a :global(svg) { width: 1em; height: 1em; }
  .site-nav a, .mobile-nav a { text-decoration-line: none; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { text-decoration-line: underline; }
  .header-actions { display: flex; flex: 0 0 auto; justify-content: flex-end; align-items: center; gap: var(--space-xs); }
  @media (min-width: 48rem) {
    .hours-strip { font-size: var(--fluid-label); line-height: var(--leading-tight); }
    .hours-strip { padding-block: var(--space-sm); }
    .header-inner, .brand { gap: var(--space-sm); }
    .brand :global(.brand-logo) { width: 2.75rem; }
    .brand-name { font-size: var(--fluid-label); }
  }
  @media (min-width: 90rem) {
    .header-inner { gap: var(--space-sm); }
    .brand { justify-self: start; container-type: normal; }
    .header-actions { justify-self: end; }
    .site-nav { display: flex; }
  }
  @media (min-width: 100rem) {
    .hours-strip { padding-block: var(--space-md); }
    .site-nav { gap: var(--space-lg); }
  }
</style>
