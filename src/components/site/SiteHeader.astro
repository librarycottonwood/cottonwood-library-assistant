---
/**
 * @component SiteHeader
 * @internal
 * Opening-hours strip, then the header bar (logo, main navigation, Donate button, phone menu), which sticks to the top while the strip scrolls away.
 * @use Nothing on pages: BaseLayout adds it to every page.
 * @avoid Adding a second header or navigation to a page.
 * @example
 * <SiteHeader library={content.library} />
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import Icon from '../Icon.astro';
import Button from './Button.astro';
import { isCurrentSection, mainNavigation as links, supportLink } from './navigation';
import type { HomeContent } from '../../content/types';
interface Props { library: HomeContent['library']; }
const { library } = Astro.props;
const isCurrent = (href: string) => { const link = [...links, supportLink].find(item => item.href === href); return link ? isCurrentSection(link, Astro.url.pathname) : false; };
// Render the same open-hours rows as the CMS summary. Phones align short day labels with the full hours.
const openHours = library.hours.filter(row => !/^closed$/i.test(row.hours));
const hoursParts = openHours.length ? openHours : [{ days: '', hours: library.hoursSummary }];
const shortDays: Record<string, string> = { Monday: 'Mon', Tuesday: 'Tue', Wednesday: 'Wed', Thursday: 'Thu', Friday: 'Fri', Saturday: 'Sat', Sunday: 'Sun' };
const compactDays = (days: string) => days.replace(/\b(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\b/g, day => shortDays[day]!);
---
<div class="toolbar-tint" aria-hidden="true"></div>
<div class="hours-strip">
  <p>
    <Icon name="clock" class="hours-icon" />
    <span class="sr-only">Library hours: {library.hoursSummary}</span>
    <span class="hours-groups" aria-hidden="true">{hoursParts.map(part => <span class="hours-part">
      {part.days && <><span class="hours-day"><span class="hours-full">{part.days}</span><span class="hours-short" aria-hidden="true">{compactDays(part.days)}</span></span>{' '}</>}
      <span class:list={['hours-time', { 'hours-only': !part.days }]}>{part.hours}</span>
    </span>)}</span>
  </p>
</div>
<header class="site-header">
  <a href="/" class="brand" aria-label="Cottonwood Community Library home">
    <Image src={logo} alt="" width={129} densities={[1, 2]} loading="eager" class="brand-logo" />
    <span class="brand-name" aria-hidden="true">Cottonwood<br />Community<br />Library</span>
  </a>
  <nav aria-label="Main navigation" class="site-nav">
    {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <!-- Goes to the Support Us page (its button opens Givebutter's popup). The click still counts as donate_header. -->
    <Button href={supportLink.href} aria-current={isCurrent(supportLink.href) ? 'page' : undefined} data-analytics-event="donate_header" variant="primary" icon="heart">Donate</Button>
    <button id="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-mobile-nav" class="menu-toggle">
      <Icon name="menu" class="menu-open" /><Icon name="close" class="menu-close" /><span class="sr-only">Menu</span>
    </button>
  </div>
</header>
<!-- Outside the header: the header is a container (for its narrow-phone rules), which would trap a fixed panel inside it. -->
<nav id="site-mobile-nav" aria-label="Mobile navigation" class="mobile-nav">
  {links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
  <a href={library.catalogUrl} data-analytics-event="catalog_mobile">Library catalog <Icon name="external" class="mobile-external" /></a>
</nav>
<script>
  import { menu as animateMenu } from '../../scripts/motion';
  // Sticky header: a line under it only once the hours strip has scrolled away, and anchor
  // targets (#give, #visit…) land below it. The header height is measured, so it isn't a spacing value.
  const header = document.querySelector<HTMLElement>('.site-header');
  const strip = document.querySelector<HTMLElement>('.hours-strip');
  if (header) {
    const root = document.documentElement;
    new ResizeObserver(() => { root.style.scrollPaddingTop = `${header.offsetHeight}px`; }).observe(header);
    if (strip) new IntersectionObserver(([entry]) => { header.toggleAttribute('data-stuck', !entry!.isIntersecting); }).observe(strip);
  }
  // Phone menu: a panel filling the screen under the header (logo, Donate and the × stay in reach). While it is open
  // the page behind can't scroll or take focus. Opening and closing animate through menu() in src/scripts/motion.ts.
  const toggle = document.querySelector<HTMLButtonElement>('#site-menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-mobile-nav');
  if (header && toggle && menu) {
    const behind = () => document.querySelectorAll<HTMLElement>('body > main, body > footer');
    const place = () => { menu.style.top = `${Math.max(0, header.getBoundingClientRect().bottom)}px`; };
    let isOpen = false;
    const setOpen = async (open: boolean, instant = false) => {
      if (open === isOpen) return;
      isOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.toggleAttribute('data-menu-open', open);
      for (const element of behind()) element.inert = open;
      if (open) { place(); menu.toggleAttribute('data-open', true); }
      if (!instant) await animateMenu(menu, open);
      if (!isOpen) menu.removeAttribute('data-open');
    };
    toggle.addEventListener('click', () => setOpen(!isOpen));
    menu.addEventListener('click', event => { if (event.target instanceof Element && event.target.closest('a')) setOpen(false, true); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && isOpen) { setOpen(false); toggle.focus(); } });
    window.matchMedia('(min-width: 90rem)').addEventListener('change', () => setOpen(false, true));
    // The header can still move after opening (a scroll still gliding to a stop, a rotated phone), so follow it.
    for (const event of ['resize', 'scroll']) window.addEventListener(event, () => { if (isOpen) place(); }, { passive: true });
    // Coming back with the Back button can restore the page with the menu still open.
    window.addEventListener('pageshow', event => { if (event.persisted) setOpen(false, true); });
  }
</script>
<style>
  /* Safari 26 ignores <meta name="theme-color"> and colors its toolbar from a fixed or sticky element touching the top
   * of the page. At the top that is this strip (the hours bar's color, or the notices' green when they show);
   * once the page scrolls it slides away and Safari takes the sticky header's color. Browsers without scroll-driven
   * animations never show it. */
  .toolbar-tint { display: none; }
  @supports (animation-timeline: scroll()) {
    .toolbar-tint {
      display: block; position: fixed; top: 0; right: 0; left: 0; z-index: 40;
      height: 0.375rem; background: var(--color-primary); pointer-events: none;
      animation: toolbar-tint-away linear both; animation-timeline: scroll(); animation-range: 0.625rem 0.6875rem;
    }
    :global(body:has(.library-notices:not([hidden]))) .toolbar-tint { background: var(--color-accent); }
  }
  @keyframes toolbar-tint-away { to { transform: translateY(-200%); } }
  .hours-strip {
    display: flex; justify-content: center;
    padding: var(--space-xs) var(--page-inset);
    background: var(--color-primary); color: var(--color-surface);
    font-family: var(--font-body); font-size: var(--text-utility); font-weight: var(--weight-medium); line-height: var(--leading-relaxed);
    text-align: center;
  }
  .hours-strip p { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
  .hours-groups { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-xs) var(--space-sm); min-width: 0; }
  /* Schedules stay separate; their text can reflow when enlarged or on very narrow screens. */
  .hours-part { max-width: 100%; }
  .hours-short { display: none; }
  .hours-strip :global(.hours-icon) { width: 1em; height: 1em; flex-shrink: 0; color: inherit; opacity: .8; }
  @media (max-width: 47.99rem) {
    .hours-strip { background: var(--color-background); color: var(--color-primary-ink); border-bottom: var(--border-thin) solid var(--color-border); line-height: var(--leading-snug); }
    .hours-strip p { align-items: flex-start; }
    .hours-strip :global(.hours-icon) { height: 1.35em; }
    .hours-groups { display: grid; grid-template-columns: minmax(0, max-content) minmax(0, max-content); gap: 0 var(--space-sm); justify-content: start; text-align: start; }
    .hours-part { display: contents; }
    .hours-day, .hours-time { overflow-wrap: anywhere; }
    .hours-full { display: none; }
    .hours-short { display: inline; }
    .hours-only { grid-column: 1 / -1; }
    .toolbar-tint { background: var(--color-background); }
  }

  /* Above page content (z-index 1 inside cards), below the statistics panel (60), the skip link (100) and Givebutter's popup. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-xs);
    padding: var(--space-xs) var(--page-inset);
    border-bottom: var(--border-thin) solid transparent;
    background: var(--color-background);
    transition: border-color var(--motion-quick) var(--ease-out);
    container: site-header / inline-size;
  }
  .site-header[data-stuck] { border-bottom-color: var(--color-border); }
  /* Below desktop the logo, wordmark, Donate and menu share one row. The brand takes the space Donate and the menu
   * leave; it is a container so the wordmark hides when that space is too narrow for it (screens under about 380px). */
  .brand { display: flex; align-items: center; gap: var(--space-xs); min-width: 2.75rem; flex: 1 1 0; container: brand / inline-size; text-decoration-line: none; }
  .brand :global(.brand-logo) { width: 2.75rem; flex-shrink: 0; }
  .brand-name { font-size: var(--fluid-label); font-weight: var(--weight-bold); line-height: var(--leading-tight); white-space: nowrap; }
  @container brand (width < 9rem) { .brand-name { display: none; } }
  /* Very narrow or zoomed-in phones: Donate keeps its heart and drops the word (still read out as "Donate"),
   * so the logo, Donate and menu stay on one row. */
  @container site-header (width < 15rem) {
    .header-actions :global(.button) { font-size: 0; gap: 0; width: 2.75rem; padding: 0; }
    .header-actions :global(.button svg) { width: 1.25rem; height: 1.25rem; }
    .brand { min-width: 2.25rem; }
    .brand :global(.brand-logo) { width: 2.25rem; }
  }
  .site-nav { display: none; gap: var(--space-md); font-weight: var(--weight-semibold); }
  .site-nav a, .mobile-nav a { text-decoration-line: none; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { text-decoration-line: underline; }
  .header-actions { display: flex; flex: 0 0 auto; justify-content: flex-end; align-items: center; gap: var(--space-xs); }
  .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem;
    border: var(--border-thin) solid var(--color-primary-ink); border-radius: var(--radius-pill);
    background: transparent; color: var(--color-primary-ink); cursor: pointer;
  }
  .menu-toggle :global(svg) { width: 1.25rem; height: 1.25rem; }
  .menu-toggle[aria-expanded='true'] :global(.menu-open), .menu-toggle[aria-expanded='false'] :global(.menu-close) { display: none; }
  /* Without JavaScript there is no menu button and the links are simply listed under the header. With it, the menu is a
   * panel filling the screen below the header (the script sets its top to the header's bottom edge, which it measures)
   * that scrolls by itself if its links don't fit (landscape, zoomed in). The page behind stays put. */
  .mobile-nav { display: flex; flex-direction: column; padding: 0 var(--page-inset) var(--space-sm); font-weight: var(--weight-semibold); }
  @media (scripting: enabled) {
    .mobile-nav {
      position: fixed; inset: 0; z-index: 49;
      padding: var(--space-sm) var(--page-inset) var(--space-lg);
      overflow-y: auto; overscroll-behavior: contain;
      background: var(--color-background);
      font-size: var(--fluid-lead); line-height: var(--leading-snug);
    }
    .mobile-nav:not([data-open]) { display: none; }
  }
  .mobile-nav a { display: flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding: var(--space-xs) 0; border-bottom: var(--border-thin) solid var(--color-border); }
  @media (scripting: enabled) { .mobile-nav a { padding-block: var(--space-sm); } }
  .mobile-nav a[aria-current='page'] { color: var(--color-primary); }
  .mobile-nav a:hover { text-decoration-line: underline; }
  .mobile-nav :global(.mobile-external) { width: 0.75em; height: 0.75em; color: var(--color-text-muted); }
  :global(html[data-menu-open]) { overflow: hidden; scrollbar-gutter: stable; }
  :global(html[data-menu-open]) .site-header { border-bottom-color: var(--color-border); }
  .site-nav a, .mobile-nav a { transition: text-decoration-color var(--motion-quick) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    .menu-toggle :global(svg) { animation: icon-turn var(--motion-smooth) var(--ease-out); }
  }
  @keyframes icon-turn { from { transform: rotate(-90deg); opacity: 0; } }
  @media (scripting: none) { .menu-toggle { display: none; } }

  @media (min-width: 48rem) {
    .hours-strip { font-size: var(--fluid-label); line-height: var(--leading-tight); }
    .hours-strip, .site-header { padding-block: var(--space-sm); }
    .site-header, .brand { gap: var(--space-sm); }
    .brand :global(.brand-logo) { width: clamp(3.5rem, 6.7vw, 8.0625rem); }
    .brand-name { font-size: clamp(1.125rem, 0.8rem + 0.9vw, var(--text-lead)); }
  }
  @media (min-width: 90rem) {
    .site-header { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-md); }
    .brand { justify-self: start; container-type: normal; }
    .header-actions { justify-self: end; }
    .site-nav { display: flex; }
    .menu-toggle, .mobile-nav, .mobile-nav[data-open] { display: none; }
  }
  @media (min-width: 100rem) {
    .hours-strip, .site-header { padding-block: var(--space-md); }
    .site-nav { gap: var(--space-lg); }
  }
</style>
