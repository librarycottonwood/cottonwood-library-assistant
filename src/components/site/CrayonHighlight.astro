---
/**
 * @component CrayonHighlight
 * A textured indigo crayon accent below the last word of a short heading, with clear space around the letters.
 * @use The hero and an occasional supporting heading, using the full original text.
 * @avoid Body text, links, or every heading on a page.
 * @example
 * <Heading><CrayonHighlight text="Powered by Community" /></Heading>
 */
interface Props { text: string; }
const { text } = Astro.props;
// Keep the CMS wording and whitespace intact while emphasizing the final word.
const match = text.match(/^(.*?)(\S+)(\s*)$/s);
const [prefix, word, suffix] = match ? [match[1], match[2], match[3]] : ['', text, ''];
---
{prefix}<span class="highlight-word"><span class="accent-text">{word}</span><svg class="highlight-swipe" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="swipe-paper" d="M1 9Q79 0 150 4T299 7L294 13Q222 17 150 12T6 16Z" />
  <path class="swipe-color" d="M5 7Q80 1 151 5T295 6L291 11Q222 14 150 10T8 13Z" />
  <path class="swipe-grain" d="m21 9 21-1m19-1 18 0m24 0 24 1m22 0 19 1m23 0 22 0m19-1 23-1m15 1 12-1" />
</svg></span>{suffix}
<style>
  .highlight-word { display: inline-block; position: relative; max-width: 100%; padding-bottom: var(--space-sm); }
  .accent-text { display: block; }
  .highlight-swipe { position: absolute; inset-inline-start: 0; bottom: 0; width: 100%; height: .18em; pointer-events: none; }
  .swipe-paper { fill: var(--color-primary-soft); }
  .swipe-color { fill: var(--color-primary); opacity: .7; }
  .swipe-grain { fill: none; stroke: var(--color-background); stroke-width: .7; stroke-linecap: round; opacity: .5; }
</style>
