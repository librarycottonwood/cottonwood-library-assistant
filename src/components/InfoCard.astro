---
// The site's one content card: photo, title, one line, and a link pinned to the bottom.
import ContentImage from './ContentImage.astro';
import Icon from './Icon.astro';
import type { LibraryImage } from '../content/types';
interface Props { title: string; note: string; image: LibraryImage; action: { label: string; href: string; external?: boolean }; id?: string; }
const { title, note, image, action, id } = Astro.props;
---
<div id={id} tabindex={id ? -1 : undefined} class="card">
  <div class="card-media"><ContentImage image={image} /></div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-text">{note}</p>
    <div class="card-action"><a href={action.href} class="text-link">{action.label}<Icon name={action.external ? 'external' : 'arrow'} class="size-4" /></a></div>
  </div>
</div>
