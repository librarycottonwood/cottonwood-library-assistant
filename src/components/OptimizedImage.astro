---
import { Image } from 'astro:assets';
import type { ComponentProps } from 'astro/types';
import type { ImageMetadata } from 'astro';
import type { LibraryImage } from '../content/types';
import { resolveImage } from '../content/images';
type Props = Omit<ComponentProps<typeof Image>, 'src' | 'inferSize' | 'densities'> & { image?: LibraryImage; src?: string | ImageMetadata };
const { image, src, ...attributes } = Astro.props;
const source = image ? image.url ?? resolveImage(image.key!) : src;
if (!source) throw new Error('A content image needs a validated image source');
const width = typeof attributes.width === 'number' ? attributes.width : Number(attributes.width);
// Do not read dimensions from Astro's local image proxy: that marks the original
// as publicly referenced. Astro already knows local dimensions during optimization.
const height = attributes.height ? Number(attributes.height) : image?.url && image.width && image.height ? Math.round(width * image.height / image.width) : undefined;
if (!Number.isFinite(width) || (typeof source === 'string' && !height)) throw new Error('Content images require known width and height');
---
{typeof source === 'string' ? <Image {...attributes} src={source} alt={attributes.alt ?? image?.alt ?? ''} width={width} height={height!} inferSize={false} /> : <Image {...attributes} src={source} alt={attributes.alt ?? image?.alt ?? ''} width={width} />}
