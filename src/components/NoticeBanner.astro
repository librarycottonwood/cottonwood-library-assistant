---
import Icon from './Icon.astro';
import { unexpiredNotices } from '../content/feeds';
import type { LibraryNotice } from '../content/types';
interface Props { notices: LibraryNotice[]; }
const notices = unexpiredNotices(Astro.props.notices);
---
{notices.length > 0 && <section aria-label="Library notices" hidden={!notices.some(notice => notice.started)} class="library-notices bg-gold text-forest-dark">
  {notices.map(notice => <div data-notice-starts={notice.startsOn} data-notice-ends={notice.endsOn} hidden={!notice.started} class="border-b border-forest/15 last:border-b-0">
    <div class="container flex flex-wrap items-center gap-x-4 gap-y-1 py-3 text-[0.9375rem]">
      <p class="flex items-start gap-2.5 font-medium"><Icon name="calendar" class="mt-1 size-4 shrink-0" /><span>{notice.message}</span></p>
      {notice.link && <a href={notice.link.href} class="inline-flex min-h-11 items-center gap-1.5 font-semibold underline decoration-1 hover:decoration-2">{notice.link.label}<Icon name="arrow" class="size-4" /></a>}
    </div>
  </div>)}
</section>}
{notices.length > 0 && <script is:inline>
  // Pages are built ahead of time, so re-check dates in the visitor's browser
  // (Pacific time): hide notices after endsOn and reveal ones once startsOn arrives.
  (function () {
    var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
    var part = function (type) { return parts.find(function (item) { return item.type === type; }).value; };
    var today = part('year') + '-' + part('month') + '-' + part('day');
    var banner = document.currentScript && document.currentScript.previousElementSibling;
    if (!banner || !banner.classList.contains('library-notices')) return;
    var shown = 0;
    banner.querySelectorAll('[data-notice-ends]').forEach(function (notice) {
      var active = notice.dataset.noticeStarts <= today && today <= notice.dataset.noticeEnds;
      notice.hidden = !active;
      if (active) shown++;
    });
    banner.hidden = shown === 0;
  })();
</script>}
