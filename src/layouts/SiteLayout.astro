---
import PageLayout from './PageLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import { contentRepository } from '../content/repository';
interface Props { title?: string; description?: string; }
const [content, notices] = await Promise.all([contentRepository.getHome(), contentRepository.getNotices()]);
---
<PageLayout {...Astro.props}>
  <NoticeBanner notices={notices} />
  <Header library={content.library} navigation={content.navigation} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer library={content.library} navigation={content.navigation} />
  <BackToTop />
</PageLayout>
