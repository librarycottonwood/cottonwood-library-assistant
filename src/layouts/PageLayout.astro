---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Cottonwood Community Library | Your community, your library',
  description = 'Visit your community-supported library in Cottonwood, California. Find hours, books, Story Time, reading groups, and ways to support your local library.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f8f6ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="fixed top-3 left-3 z-50 -translate-y-24 rounded bg-white px-5 py-3 font-semibold focus:translate-y-0">Skip to content</a>
    <slot />
  </body>
</html>
