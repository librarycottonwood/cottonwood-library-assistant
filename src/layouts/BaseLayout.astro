---
/**
 * @component BaseLayout
 * The page shell for every page: fonts, tokens, notices, header, footer, analytics and the skip link.
 * @use Wrapping every page. Put Splits and Sections directly inside it. Every page passes its own `title`
 * ("<Page> | Cottonwood Community Library") and `description` (1–2 sentences from facts on the page), and an
 * `image` when it has its own photo. Canonical address, share card, schema.org data and the sitemap entry are
 * automatic (docs/design-rules.md, "Search and sharing").
 * @avoid Page-level styles or spacing: build from src/components/site instead. Reusing another page's title or description.
 * @example
 * <BaseLayout title="Visit | Cottonwood Community Library" description="Hours, directions and services.">
 *   <Section title="Visit us" headingId="visit-heading">…</Section>
 * </BaseLayout>
 */
import FoundationStyles from '../components/catalog/FoundationStyles.astro';
import Analytics from '../components/Analytics.astro';
import SiteNotices from '../components/site/SiteNotices.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { contentRepository } from '../content/repository';
import { givebutterScriptSrc, sitewideGivebutterAccount } from '../content/donate';
import CampaignExpiry from '../components/CampaignExpiry.astro';
import SeoMeta from '../components/SeoMeta.astro';
import type { LibraryImage } from '../content/types';
import '../styles/base.css';
interface Props {
  /** Browser tab, search and share-card title, unique to this page: "<Page> | Cottonwood Community Library". */
  title: string;
  /** 1–2 sentences for search results and share cards, from facts on this page. Unique to this page. */
  description: string;
  /** Photo for the link preview on Facebook and in texts; the homepage photo when absent. Pass the page's own photo. */
  image?: LibraryImage;
  /** 'article' for a news post. */
  type?: 'website' | 'article';
  /** Extra schema.org data for search engines and AI answers (src/content/seo.mjs). */
  schema?: Record<string, unknown>[];
  /** Keep this page out of search results (the "page not found" page). */
  noindex?: boolean;
}
const {
  title,
  description,
  image,
  type,
  schema,
  noindex,
} = Astro.props;
const [content, notices] = await Promise.all([contentRepository.getHome(), contentRepository.getNotices()]);
// Donate buttons are on every page, so once they open Givebutter's popup its script loads once per page here.
const givebutterAccount = await sitewideGivebutterAccount();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <SeoMeta title={title} description={description} library={content.library} image={image} defaultImage={content.hero.image} type={type} schema={schema} noindex={noindex} />
    <meta name="theme-color" content="#4956a7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <FoundationStyles />
    <script is:inline>
      // Motion (src/scripts/motion.ts) only when the visitor allows it. If that script hasn't started within 3 seconds
      // (blocked or failed), drop the flag so nothing stays hidden.
      if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () { if (!('motionReady' in document.documentElement.dataset)) document.documentElement.classList.remove('motion'); }, 3000);
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteNotices notices={notices} />
    <SiteHeader library={content.library} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter library={content.library} />
    <Analytics privacyLinks={false} />
    <CampaignExpiry />
    <!-- Read out after a link's name (aria-describedby), so screen-reader users know before they follow it. -->
    <span id="link-note-new-tab" hidden>Opens in a new tab</span>
    <span id="link-note-pdf-new-tab" hidden>PDF, opens in a new tab</span>
    <span id="link-note-pdf" hidden>PDF</span>
    <script is:inline>
      // Links to other websites (catalog, maps, Givebutter, Facebook) open in a new tab, so the library site stays open.
      // Decided at click time, so links that scripts change later (CampaignExpiry) are covered too. Each such link (and
      // each PDF) is described to screen readers once the page has loaded; Givebutter's Donate buttons open a popup on
      // this page instead, so they are left alone.
      document.querySelectorAll('a[href]').forEach(function (link) {
        if (link.hasAttribute('data-gb-campaign') || link.hasAttribute('data-gb-account')) return;
        var external = /^https?:$/.test(link.protocol) && link.origin !== location.origin;
        var pdf = /\.pdf$/i.test(link.pathname);
        var note = external ? (pdf ? 'link-note-pdf-new-tab' : 'link-note-new-tab') : pdf ? 'link-note-pdf' : '';
        if (note) link.setAttribute('aria-describedby', ((link.getAttribute('aria-describedby') || '') + ' ' + note).trim());
      });
      document.addEventListener('click', function (event) {
        var link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!link || link.target || !/^https?:$/.test(link.protocol) || link.origin === location.origin) return;
        link.target = '_blank';
        link.rel = 'noopener';
      });
    </script>
    <script>import '../scripts/motion';</script>
    {givebutterAccount && <script is:inline async src={givebutterScriptSrc(givebutterAccount)}></script>}
  </body>
</html>
