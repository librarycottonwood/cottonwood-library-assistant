---
import FoundationStyles from '../components/catalog/FoundationStyles.astro';
import { lessons, reviewed } from '../pages/academy/_guide';
import '../styles/academy.css';
interface Props { title: string; active?: string; print?: boolean; }
const { title, active, print = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Practical lessons and a printable desk guide for Cottonwood Community Library volunteers." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cottonwood Volunteer Academy</title>
    <FoundationStyles />
  </head>
  <body class:list={[{ 'print-edition': print }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="academy-header">
      <a class="academy-brand" href="/academy/">Cottonwood <span>Volunteer Academy</span></a>
      <nav aria-label="Quick links"><a href="/academy/when-something-goes-wrong/">Need help?</a><a href="/academy/quick-reference/">Desk guide</a><a href="/">Library website ↗</a></nav>
    </header>
    <div class="academy-shell">
      <nav class="academy-nav" aria-label="Academy lessons">
        <p class="eyebrow">Your field guide</p>
        <a href="/academy/" aria-current={active === 'home' ? 'page' : undefined}>Welcome</a>
        <ol class="desktop-lessons">{lessons.map(lesson => <li><a href={`/academy/${lesson.slug}/`} aria-current={active === lesson.slug ? 'page' : undefined}>{lesson.title}</a></li>)}</ol>
        <details class="mobile-lessons"><summary>Browse all six lessons</summary><ol>{lessons.map(lesson => <li><a href={`/academy/${lesson.slug}/`} aria-current={active === lesson.slug ? 'page' : undefined}>{lesson.title}</a></li>)}</ol></details>
        <a href="/academy/print/">Print the handbook</a>
        <p class="small">Work at your own pace.<br />Keep ChatGPT open beside this guide.</p>
      </nav>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <footer class="academy-footer">Cottonwood Community Library · Guidance reviewed {reviewed}.<br />This guide is public. Account access details stay with the board.</footer>
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          const box = button.closest('[data-prompt]');
          const prompt = box?.querySelector<HTMLElement>('[data-prompt-text]');
          const status = box?.querySelector<HTMLElement>('[role="status"]');
          if (!prompt || !status) return;
          try {
            await navigator.clipboard.writeText(prompt.innerText);
            status.textContent = 'Copied. Paste this into your library chat.';
          } catch {
            status.textContent = 'Select the prompt text and copy it, then paste it into your library chat.';
          }
        });
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
        button.hidden = false;
        button.addEventListener('click', () => window.print());
      }
    </script>
  </body>
</html>
