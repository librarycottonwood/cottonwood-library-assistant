---
import FoundationStyles from '../components/catalog/FoundationStyles.astro';
import { ArrowUpRight, House, BookOpen, Printer } from '@lucide/astro';
import LessonIcon from '../components/academy/LessonIcon.astro';
import { lessons } from '../pages/academy/_guide';
import '../styles/academy.css';
interface Props { title: string; active?: string; print?: boolean; withPageIndex?: boolean; }
const { title, active, print = false, withPageIndex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Practical lessons and a printable desk guide for Cottonwood Community Library volunteers." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cottonwood Volunteer Academy</title>
    <FoundationStyles />
  </head>
  <body class:list={[{ 'print-edition': print }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="academy-header">
      <a class="academy-brand" href="/academy/">Cottonwood <span>Volunteer academy</span></a>
      <a class="library-link" href="/">Library website <ArrowUpRight size={15} aria-hidden="true" /></a>
    </header>
    <div class="academy-shell">
      <aside class="academy-sidebar">
        <details class="lesson-menu" open>
          <summary>Browse lessons</summary>
          <nav aria-label="Academy lessons">
            <a href="/academy/" aria-current={active === 'home' ? 'page' : undefined}><House size={18} aria-hidden="true" /><span>Overview</span></a>
            <p class="nav-label">Learn</p>
            <ol>{lessons.map(lesson => <li><a href={`/academy/${lesson.slug}/`} aria-current={active === lesson.slug ? 'page' : undefined}><LessonIcon slug={lesson.slug} /><span>{lesson.title}</span></a></li>)}</ol>
            <p class="nav-label">Print a guide</p>
            <a href="/academy/quick-reference/" aria-current={Astro.url.pathname.includes('quick-reference') ? 'page' : undefined}><BookOpen size={18} aria-hidden="true" /><span>Quick guide</span></a>
            <a href="/academy/print/" aria-current={Astro.url.pathname.includes('/print') ? 'page' : undefined}><Printer size={18} aria-hidden="true" /><span>Printable handbook</span></a>
          </nav>
        </details>
      </aside>
      <div class:list={['academy-content', { 'with-page-index': withPageIndex }]}>
        <main id="main" tabindex="-1"><slot /></main>
      </div>
    </div>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.lesson-menu');
      const narrow = window.matchMedia('(max-width: 767px)');
      const syncMenu = () => { if (menu) menu.open = !narrow.matches; };
      syncMenu();
      narrow.addEventListener('change', syncMenu);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          const box = button.closest('[data-prompt]');
          const prompt = box?.querySelector<HTMLElement>('[data-prompt-text]');
          const status = box?.querySelector<HTMLElement>('[role="status"]');
          if (!prompt || !status) return;
          try {
            await navigator.clipboard.writeText(prompt.innerText);
            status.textContent = 'Copied. Paste it into ChatGPT.';
          } catch {
            status.textContent = 'Select and copy the message, then paste it into ChatGPT.';
          }
        });
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
        button.hidden = false;
        button.addEventListener('click', () => window.print());
      }
    </script>
  </body>
</html>
