---
import Image from '../components/OptimizedImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { contentRepository } from '../content/repository';
import { DONATE_PAGE_HREF } from '../content/donate';
const { story, support } = await contentRepository.getHome();
---
<SiteLayout title="Our story | Cottonwood Community Library">
  <PageIntro title="Our story" width="prose" />
  <article id="our-story" tabindex="-1" aria-labelledby="story-heading" class="container-prose section pt-0">
    <figure class="m-0"><Image width={1100} quality={70} image={story.image} alt={story.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 767px) 100vw, 640px" class="aspect-[1.5] w-full rounded-[4px] object-cover" loading="eager" />{story.image.caption && <figcaption class="mt-3 text-sm text-muted">{story.image.caption}</figcaption>}</figure>
    <h2 id="story-heading" class="section-heading mt-12">{story.heading}</h2>
    <div class="prose-flow mt-6">{story.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
    <a href={DONATE_PAGE_HREF} class="button button-primary mt-10">Support the library</a>
    <figure class="m-0 mt-20"><Image width={1100} quality={70} image={support.image} alt={support.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 767px) 100vw, 640px" class="h-auto w-full rounded-[4px]" loading="lazy" /></figure>
  </article>
</SiteLayout>
