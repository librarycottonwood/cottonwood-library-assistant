---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Disclosure from '../components/Disclosure.astro';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
const { story } = await contentRepository.getHome();
---
<SiteLayout title="Our story | Cottonwood Community Library">
  <PageIntro title="Our story" />
  <section id="our-story" tabindex="-1" aria-labelledby="story-heading" class="container pb-12">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <figure class="m-0"><Image src={resolveImage(story.image.key)} alt={story.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 50vw" class="aspect-[1.3] w-full rounded-[4px] object-cover" loading="eager" />{story.image.caption && <figcaption class="mt-3 text-sm text-muted">{story.image.caption}</figcaption>}</figure>
      <div><h2 id="story-heading" class="section-heading">Built by neighbors.<br />Here for you.</h2><p class="mt-4 text-lg text-muted">Independent since 1996. Your donations keep us going.</p><div class="mt-5"><Disclosure title="How Cottonwood built its library">{story.paragraphs.map(paragraph => <p class="mt-3">{paragraph}</p>)}</Disclosure></div><a href="/fundraising-events/" class="button button-primary mt-5">Support your library</a></div>
    </div>
  </section>
</SiteLayout>
