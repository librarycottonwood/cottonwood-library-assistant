---
import SiteLayout from '../layouts/SiteLayout.astro';
const styles = [
  { id: 'storybook', name: '1. Storybook drawings', description: 'Soft pencil and painted details, with friendly woodland readers. Warm and playful.' },
  { id: 'paper', name: '2. Paper cutouts', description: 'Layered paper shapes with a handmade craft-table feel. Bright and cheerful.' },
  { id: 'folk', name: '3. Folk-art stamps', description: 'Textured ink, simple shapes, and wildflowers. A cozy, locally made feel.' },
];
const labels = ['Upcoming events', 'Kids & families', 'Find a book', 'Donate'];
const tones = ['action-sun', 'action-meadow', 'action-gold', 'action-forest'];
---
<SiteLayout title="Button style options">
  <section class="container py-10">
    <p class="eyebrow">Design options · draft</p>
    <h1 class="page-heading mt-3">A little more color.</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">Warm amber, clear blue, coral red, and leaf green bring color to the page while letting the transparent illustrations stand out. Dark green lettering ties everything to the library’s warm theme. Choose a style below to see it on the home page.</p>
    {styles.map(style => <section data-button-style={style.id} class="mt-10" aria-labelledby={`${style.id}-heading`}>
      <h2 id={`${style.id}-heading`} class="section-heading">{style.name}</h2>
      <p class="mt-3 text-muted">{style.description}</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {labels.map((label, column) => <div class:list={['action-tile', tones[column]]}>
          <span class="action-label">{label}</span>
          <span aria-hidden="true" class="button-concept-art" style={`--art-column: ${column}`} />
        </div>)}
      </div>
      <a class="button button-primary mt-4" href={`/?button-style=${style.id}`}>Try {style.name.slice(3).toLowerCase()} on the home page</a>
    </section>)}
  </section>
</SiteLayout>
