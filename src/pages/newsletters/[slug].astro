---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentImage from '../../components/ContentImage.astro';
import { contentRepository } from '../../content/repository';
import type { LibraryNewsletter } from '../../content/types';
export async function getStaticPaths() {
  return (await contentRepository.getNewsletters()).map(newsletter => ({ params: { slug: newsletter.id }, props: { newsletter } }));
}
interface Props { newsletter: LibraryNewsletter; }
const { newsletter } = Astro.props;
---
<SiteLayout title={`${newsletter.issue} newsletter | Cottonwood Community Library`} description={newsletter.summary}>
  <PageIntro title={`${newsletter.issue} newsletter`} back={{ href: '/librarynews/newsletter/', label: 'Current newsletter' }} />
  <article class="container grid items-start gap-8 pb-12 md:grid-cols-2"><ContentImage image={newsletter.cover} variant="feature" eager /><div><h2 class="card-heading">{newsletter.title}</h2><p class="mt-5 text-base text-muted">{newsletter.summary}</p><a href={newsletter.fileUrl} class="button button-primary mt-6">Read the newsletter (PDF)</a></div></article>
</SiteLayout>
