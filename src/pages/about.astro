---
// About Us (Figma 1012:122): the library painting, then the library's story beside the founders plaque.
// Built only from src/components/site (see docs/design-system.md); text and photos come from Sanity.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/site/Button.astro';
import Heading from '../components/site/Heading.astro';
import PageTitle from '../components/site/PageTitle.astro';
import Prose from '../components/site/Prose.astro';
import Split from '../components/site/Split.astro';
import Text from '../components/site/Text.astro';
import WideImage from '../components/site/WideImage.astro';
import { mainNavigation, supportLink } from '../components/site/navigation';
import { contentRepository } from '../content/repository';
const { story, support } = await contentRepository.getHome();
const title = mainNavigation.find(link => link.href === '/about/')!.label;
---
<BaseLayout title={`${title} | Cottonwood Community Library`} description={story.paragraphs[0]}>
  <PageTitle title={title} />
  {/* The painting fills the wide frame (cropped top and bottom) instead of sitting small inside it. */}
  <WideImage image={{ ...support.image, fit: 'cover' }} bleed first />
  <Split media="start" inset image={story.image} headingId="story-heading">
    <Heading id="story-heading">{story.heading}</Heading>
    <Prose paragraphs={story.paragraphs} />
    {story.image.caption && <Text tone="muted">{story.image.caption}</Text>}
    <Button href={supportLink.href} variant="primary" icon="heart">Donate</Button>
  </Split>
</BaseLayout>
