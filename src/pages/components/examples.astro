---
// Live examples of the page blocks with real Sanity content, for reviewing them before pages use them.
// Not linked from the site (noindex; robots.txt disallows /components). Usage notes: /components/ui/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/site/Button.astro';
import DetailList from '../../components/site/DetailList.astro';
import Faq from '../../components/site/Faq.astro';
import Gallery from '../../components/site/Gallery.astro';
import Heading from '../../components/site/Heading.astro';
import MapCard from '../../components/site/MapCard.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import PostList from '../../components/site/PostList.astro';
import Prose from '../../components/site/Prose.astro';
import Section from '../../components/site/Section.astro';
import Signature from '../../components/site/Signature.astro';
import TopicList from '../../components/site/TopicList.astro';
import Split from '../../components/site/Split.astro';
import Stack from '../../components/site/Stack.astro';
import Text from '../../components/site/Text.astro';
import WideImage from '../../components/site/WideImage.astro';
import { contentRepository } from '../../content/repository';
import type { LibraryImage } from '../../content/types';
const [home, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getPosts()]);
const { library, borrowing, services, programs, story } = home;
const service = services[0]!;
const servicePhoto: LibraryImage = { key: 'interior', alt: '' };
const entrance: LibraryImage = { key: 'entrance', alt: 'Inside the library entrance, with the tree logo on the wall.' };
---
<BaseLayout title="Block examples · Cottonwood design system" description="Live examples of the page blocks.">
  <PageTitle title="Block examples" trail={[{ label: 'Design system', href: '/components/ui/' }]}>Every block below uses real content from Sanity.</PageTitle>

  <Split media="start" panel image={entrance} headingId="panel-heading">
    <Stack gap="xs">
      <Heading id="panel-heading">{library.address}</Heading>
      <Text tone="muted" size="lead">{library.locality}</Text>
    </Stack>
    <DetailList label="Opening hours" items={library.hours.map(row => ({ label: row.days, value: row.hours, muted: /^closed$/i.test(row.hours) }))} />
    <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
  </Split>

  <Split media="end" inset image={servicePhoto} headingId="inset-heading">
    <Stack gap="xs">
      <Heading id="inset-heading">{service.title}</Heading>
      <Text tone="muted">{service.description}</Text>
    </Stack>
    <TopicList items={[{ title: 'Getting started', text: 'Bring photo ID and proof of residence.' }, { title: 'Renewals & returns', text: 'Renew items up to two times, in person or by phone.' }]} />
    <Text tone="muted" note>An italic side note.</Text>
    <Button href={library.catalogUrl} variant="accent" iconEnd="arrow">Browse the catalog</Button>
  </Split>

  <Section title="Find us" headingId="map-heading">
    <MapCard library={library} />
  </Section>

  <Section title="Frequently Asked Questions" headingId="faq-heading" width="text">
    <Faq items={borrowing} />
  </Section>

  <WideImage image={story.image} bleed />
  <Section width="text" align="start" title={story.heading} headingId="story-heading">
    <Prose paragraphs={story.paragraphs} />
    <Signature>Thank you for your support!</Signature>
  </Section>

  <Section title="Gallery" headingId="gallery-heading">
    <Gallery images={programs.map(program => program.image)} />
  </Section>

  <Section title="Latest News" headingId="news-heading">
    <PostList posts={posts} initial={1} />
  </Section>
</BaseLayout>
