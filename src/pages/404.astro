---
// Page not found, on the new design. Built only from src/components/site.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/site/Button.astro';
import PageTitle from '../components/site/PageTitle.astro';
import Section from '../components/site/Section.astro';
import Stack from '../components/site/Stack.astro';
import { mainNavigation } from '../components/site/navigation';
---
<BaseLayout title="Page not found | Cottonwood Community Library" noindex>
  <PageTitle title="This page isn’t on the shelf">Let’s get you back to library hours, books, and what’s happening in our community.</PageTitle>
  <Section align="start">
    <Stack direction="row" gap="xs" wrap>
      <Button href="/" variant="primary" iconEnd="arrow">Back to the library</Button>
      {mainNavigation.map(link => <Button href={link.href}>{link.label}</Button>)}
    </Stack>
  </Section>
</BaseLayout>
