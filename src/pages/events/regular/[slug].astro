---
// Service View (Figma 1012:1243): one regular program (Story Time, reading groups) beside its photo, the map and
// questions about the program. Programs are listed on Events & News ("Regular Events"), so their pages live under
// /events/regular/ and the header highlights Events & News. There is no /services/<id>/ redirect; astro.config.mjs `redirects` lists the real ones. Built only from src/components/site. Programs and questions come from Sanity.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/site/Button.astro';
import DetailList from '../../../components/site/DetailList.astro';
import Faq from '../../../components/site/Faq.astro';
import Gallery from '../../../components/site/Gallery.astro';
import MapCard from '../../../components/site/MapCard.astro';
import PageTitle from '../../../components/site/PageTitle.astro';
import Section from '../../../components/site/Section.astro';
import Split from '../../../components/site/Split.astro';
import Stack from '../../../components/site/Stack.astro';
import Text from '../../../components/site/Text.astro';
import { mainNavigation } from '../../../components/site/navigation';
import { contentRepository } from '../../../content/repository';
import type { LibraryImage, Program } from '../../../content/types';
import { SITE_URL, programEventNodes, programSessions } from '../../../content/seo.mjs';
import { sessionPhrase } from '../../../content/schedule.mjs';
export async function getStaticPaths() {
  const { programs } = await contentRepository.getHome();
  return programs.map(program => ({ params: { slug: program.id }, props: { program } }));
}
interface Props { program: Program; }
const { program } = Astro.props;
const [{ library }, notices, events] = await Promise.all([contentRepository.getHome(), contentRepository.getNotices(), contentRepository.getEvents()]);
const eventsLink = mainNavigation.find(link => link.href === '/events/')!;
const regularLink = { label: 'Regular Events', href: '/events/#regular' };
// More photos from the program, shown under the panel.
const galleries: Record<string, LibraryImage[]> = {
  'story-time': [
    { key: 'storyTimeBeeColoring', alt: 'Bee coloring pages and craft supplies laid out for a Story Time craft.' },
    { key: 'storyTimeSnailCraft', alt: 'A clay snail made at Story Time, beside a tank with a real snail.' },
    { key: 'storyTimeButterflyCraft', alt: 'A child colors a butterfly craft with pencils at the craft table.' },
  ],
};
const gallery = galleries[program.id] ?? [];
// Use the same program image as the cards, including restored reading-group illustrations.
const photo = { ...program.image, fit: 'cover' as const };
// Questions about this program, written from the program's Sanity details (staff-provided). A program listed here
// shows its details as these questions; a new program without questions shows its details in the panel instead.
const questions: Record<string, { question: string; answer: string }[]> = {
  'story-time': [
    { question: 'Who is Story Time for?', answer: 'Preschoolers, during the school year. Older children are welcome in the summer.' },
    { question: 'What happens at Story Time?', answer: 'Stories, songs, crafts and a snack. First 5 Shasta helps provide books for children to take home.' },
  ],
  'book-club': [
    { question: 'How do I get the book?', answer: 'Book Club titles are held at the front desk for members a month ahead.' },
    { question: 'The library is closed on Thursdays. How do I get in?', answer: 'Please enter through the back door by the book drop.' },
  ],
  'main-street-readers': [
    { question: 'What do we talk about?', answer: 'Recent reads and recommendations. Bring your thoughts about a book you loved, or one you wish you hadn’t picked up.' },
    { question: 'Is it a formal club?', answer: 'No. Main Street Readers is an informal group that meets at the library.' },
  ],
};
const faq = questions[program.id] ?? [];
// Dated sessions for the next ~90 days, worked out from the schedule when the site is built (src/content/seo.mjs).
// The page lists them so the search-engine event data matches what visitors see.
const sessions = programSessions(program, { notices, events });
const schema = programEventNodes(program, sessions, { url: new URL(Astro.url.pathname, SITE_URL).href });
---
<BaseLayout title={`${program.title} | Cottonwood Community Library`} description={`${program.description} ${program.schedule}`} image={photo} schema={schema}>
  <PageTitle title={program.title} trail={[eventsLink, regularLink]} />
  {/* Figma leaves this panel empty; it holds the program's introduction, When/Where and the next steps. */}
  <Split media="start" panel ratio="16 / 9" image={photo}>
    <Text size="lead">{program.description}</Text>
    <DetailList label={`${program.title} schedule`} items={[{ label: 'When', value: program.schedule }, { label: 'Where', value: library.address }]} />
    {sessions.length > 0 && <Text tone="muted">Next sessions: <span data-sessions={JSON.stringify(sessions)}>{sessionPhrase(sessions).map(piece => piece.session ? <time id={`session-${piece.session.day}`} datetime={piece.session.startsAt}>{piece.text}</time> : piece.text)}</span>.</Text>}
    {faq.length === 0 && program.details && <Text tone="muted">{program.details}</Text>}
    <Stack direction="row" gap="xs" wrap>
      <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
      <Button href={library.catalogUrl} icon="book">Browse the catalog</Button>
    </Stack>
  </Split>
  {gallery.length > 0 && <Section title="Photos" headingId="photos-heading">
    <Gallery images={gallery} />
  </Section>}
  <Section title="Find us" headingId="map-heading">
    <MapCard library={library} />
  </Section>
  {faq.length > 0 && <Section title="Frequently Asked Questions" headingId="questions-heading" width="text" id="questions">
    <Faq items={faq} email={library.email} />
  </Section>}
</BaseLayout>
<script>
  // The site is only rebuilt when a change is saved, so drop sessions that have started since then.
  import { sessionPhrase } from '../../../content/schedule.mjs';
  for (const dates of document.querySelectorAll<HTMLElement>('[data-sessions]')) {
    const all: { day: string; startsAt: string }[] = JSON.parse(dates.dataset.sessions!);
    const upcoming = all.filter(session => Date.parse(session.startsAt) > Date.now());
    if (upcoming.length === all.length) continue;
    if (!upcoming.length) { dates.parentElement!.hidden = true; continue; }
    dates.replaceChildren(...sessionPhrase(upcoming).map(piece => {
      if (!piece.session) return piece.text;
      const time = document.createElement('time');
      time.id = `session-${piece.session.day}`;
      time.dateTime = piece.session.startsAt;
      time.textContent = piece.text;
      return time;
    }));
  }
</script>
