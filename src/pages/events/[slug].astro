---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentImage from '../../components/ContentImage.astro';
import { contentRepository } from '../../content/repository';
import type { LibraryEvent } from '../../content/types';
export async function getStaticPaths() {
  const events = await contentRepository.getEvents();
  return [...new Set(events.flatMap(event => event.slug ? [event.slug] : []))].map(slug => ({ params: { slug }, props: { sessions: events.filter(event => event.slug === slug) } }));
}
interface Props { sessions: LibraryEvent[]; }
const { sessions } = Astro.props;
const event = sessions[0]!;
const { library, programs } = await contentRepository.getHome();
const program = programs.find(program => program.id === event.programId);
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'full', timeStyle: 'short', timeZone: 'America/Los_Angeles' });
const time = new Intl.DateTimeFormat('en-US', { timeStyle: 'short', timeZone: 'America/Los_Angeles' });
---
<SiteLayout title={`${event.title} | ${library.name}`} description={event.summary}>
  <PageIntro title={event.title} description={event.summary} back={{ href: '/librarynews/', label: 'Events & news' }} width={event.image ? 'wide' : 'prose'} />
  <section class:list={[event.image ? 'container' : 'container-prose', 'section pt-0']} aria-labelledby="event-when-heading">
    <div class:list={[event.image && 'split-equal']}>
      {event.image && <div class="split-media"><ContentImage image={event.image} variant="feature" eager /></div>}
      <div class="panel flex flex-col">
        <h2 id="event-when-heading" class="card-heading">When</h2>
        <ul class="mt-3 list-none space-y-2 p-0 text-base">{sessions.map(session => <li><time datetime={session.startsAt}>{date.format(new Date(session.startsAt))}</time> – <time datetime={session.endsAt}>{time.format(new Date(session.endsAt))}</time> Pacific</li>)}</ul>
        <h2 class="card-heading mt-6">Where</h2>
        <p class="mt-3 text-base">{event.location ?? `${library.address}, ${library.locality}`}</p>
        {program && <a href={`/librarynews/${program.id}/`} class="text-link mt-4 self-start">About {program.title}</a>}
        <a href={library.directionsUrl} data-analytics-event="directions_click" class="button button-primary mt-6 self-start">Get directions</a>
      </div>
    </div>
  </section>
</SiteLayout>
