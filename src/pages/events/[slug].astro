---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentImage from '../../components/ContentImage.astro';
import { contentRepository } from '../../content/repository';
import type { LibraryEvent } from '../../content/types';
export async function getStaticPaths() {
  const events = await contentRepository.getEvents();
  return [...new Set(events.flatMap(event => event.slug ? [event.slug] : []))].map(slug => ({ params: { slug }, props: { sessions: events.filter(event => event.slug === slug) } }));
}
interface Props { sessions: LibraryEvent[]; }
const { sessions } = Astro.props;
const event = sessions[0]!;
const { library, programs } = await contentRepository.getHome();
const program = programs.find(program => program.id === event.programId);
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'full', timeStyle: 'short', timeZone: 'America/Los_Angeles' });
---
<SiteLayout title={`${event.title} | ${library.name}`} description={event.summary}>
  <PageIntro title={event.title} back={{ href: '/librarynews/', label: 'Events & news' }} />
  <article class="container grid items-start gap-8 pb-12 lg:grid-cols-2">
    {event.image && <ContentImage image={event.image} variant="feature" eager />}
    <div><p class="text-lg text-muted">{event.summary}</p><p class="mt-5">{event.location ?? `${library.address}, ${library.locality}`}</p>
      <h2 class="card-heading mt-6">When</h2>
      <ul class="mt-3 space-y-3">{sessions.map(session => <li><time datetime={session.startsAt}>{date.format(new Date(session.startsAt))}</time>{session.endsAt && <> – <time datetime={session.endsAt}>{date.format(new Date(session.endsAt))}</time></>} Pacific</li>)}</ul>
      {program && <a href={`/librarynews/${program.id}/`} class="text-link mt-5">About {program.title}</a>}
      <a href={library.directionsUrl} class="button button-primary mt-6">Get directions</a>
    </div>
  </article>
</SiteLayout>
