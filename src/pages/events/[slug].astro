---
// Event View (Figma 1021:1494): one event with its photo, every session, where it is, and the map.
// Built only from src/components/site (see docs/design-system.md); everything comes from Sanity.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/site/Button.astro';
import DetailList from '../../components/site/DetailList.astro';
import MapCard from '../../components/site/MapCard.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import Section from '../../components/site/Section.astro';
import Stack from '../../components/site/Stack.astro';
import Text from '../../components/site/Text.astro';
import WideImage from '../../components/site/WideImage.astro';
import { mainNavigation } from '../../components/site/navigation';
import { contentRepository } from '../../content/repository';
import type { LibraryEvent } from '../../content/types';
import { checkoutAttributes, getDonateLink } from '../../content/donate';
import { fallbackPhoto } from '../_photos';
export async function getStaticPaths() {
  const events = await contentRepository.getEvents();
  return [...new Set(events.flatMap(event => event.slug ? [event.slug] : []))].map(slug => ({ params: { slug }, props: { sessions: events.filter(event => event.slug === slug) } }));
}
interface Props { sessions: LibraryEvent[]; }
const { sessions } = Astro.props;
const event = sessions[0]!;
const [{ library, programs }, donate] = await Promise.all([contentRepository.getHome(), getDonateLink()]);
const program = programs.find(program => program.id === event.programId);
// No photo in Sanity: the program's photo, or a fitting library photo (never an empty box).
const image = event.image ?? program?.image ?? fallbackPhoto(event.title, event.summary);
const inPerson = !/online/i.test(event.location ?? '');
const eventsLink = mainNavigation.find(link => link.href === '/events/')!;
const zone = 'America/Los_Angeles';
const day = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: zone });
const clock = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: zone });
// The library writes times as "10 a.m." and "2:30 p.m.".
const time = { format: (date: Date) => clock.format(date).replace(':00', '').replace(' AM', ' a.m.').replace(' PM', ' p.m.') };
const when = sessions.map(session => ({ label: day.format(new Date(session.startsAt)), value: `${time.format(new Date(session.startsAt))} – ${time.format(new Date(session.endsAt))}` }));
---
<BaseLayout title={`${event.title} | ${library.name}`} description={event.summary}>
  <PageTitle title={event.title} trail={[eventsLink]}>
    {sessions.map((session, index) => <>{index > 0 && ' · '}<time datetime={session.startsAt}>{day.format(new Date(session.startsAt))}</time></>)}
  </PageTitle>
  <WideImage image={image} first />
  <Section width="text" align="start">
    <Text size="lead">{event.summary}</Text>
    <DetailList label="Dates and times" items={[...when, { label: 'Where', value: event.location ?? `${library.address}, ${library.locality}` }]} />
    <Stack direction="row" gap="xs" wrap>
      {inPerson && <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>}
      {program && <Button href={`/services/${program.id}/`} icon="book">About {program.title}</Button>}
      <Button href={donate.href} {...checkoutAttributes(donate)} variant="primary" icon="heart">Support your library</Button>
    </Stack>
  </Section>
  {inPerson && <Section title="Find us" headingId="map-heading" width="text">
    <MapCard library={library} />
  </Section>}
</BaseLayout>
