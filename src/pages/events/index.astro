---
// Events & News (Figma alt frame 1026:2163): the next event with a photo, upcoming events, regular programs, and news.
// Built only from src/components/site (see docs/design-system.md); everything comes from Sanity.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/site/Badge.astro';
import Button from '../../components/site/Button.astro';
import Card from '../../components/site/Card.astro';
import EventCards from '../../components/site/EventCards.astro';
import Grid from '../../components/site/Grid.astro';
import Heading from '../../components/site/Heading.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import PostList from '../../components/site/PostList.astro';
import Section from '../../components/site/Section.astro';
import Split from '../../components/site/Split.astro';
import Stack from '../../components/site/Stack.astro';
import Text from '../../components/site/Text.astro';
import { mainNavigation, programHref } from '../../components/site/navigation';
import { newestPosts, postDate, upcomingEvents } from '../../content/feeds';
import { contentRepository } from '../../content/repository';
import { eventPhoto, fallbackPhoto, postsWithPhotos } from '../_photos';
import { refreshPhoto } from '../../content/photography';
import type { LibraryImage } from '../../content/types';
const [{ library, programs }, allEvents, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getEvents(), contentRepository.getPosts()]);
const title = mainNavigation.find(link => link.href === '/events/')!.label;
const events = upcomingEvents(allEvents);
// The next event leads the page (Figma's photo-and-panel block); the browser hides it once it ends.
const featured = events[0];
// With no upcoming event the newest post leads instead, so the page never opens without a focus. When the event ends
// in the visitor's browser, that same post block shows in its place (src/scripts/event-refresh.ts).
const newsWithPhotos = postsWithPhotos(newestPosts(posts));
// A post with no photo of its own borrows a library photo; if that's a program photo shown just below, use another.
const pictureId = (picture: LibraryImage) => { const shown = refreshPhoto(picture); return shown.url ?? shown.key; };
const programPictures = new Set(programs.flatMap(program => program.image ? [pictureId(program.image)] : []));
const newestPost = newsWithPhotos[0];
const leadPost = newestPost && !posts.find(post => post.id === newestPost.id)?.image && programPictures.has(pictureId(newestPost.image!))
  ? { ...newestPost, image: fallbackPhoto() }
  : newestPost;
// This page previews the latest four posts (not repeating one that leads the page); All news opens the complete archive.
const latestPosts = newsWithPhotos.slice(featured ? 0 : 1).slice(0, 4);
const featuredImage = featured && eventPhoto(featured, programs);
// Events and posts without a photo in Sanity get the same library photo here as on their own page.
const laterEvents = events.slice(1).map(event => ({ ...event, image: eventPhoto(event, programs) }));
const featuredInPerson = featured && !/online/i.test(featured.location ?? '');
const featuredDate = featured && new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' }).format(new Date(featured.startsAt));
---
<BaseLayout title={`${title} | Cottonwood Community Library`} description="Upcoming events, regular programs and news from the Cottonwood Community Library.">
  <PageTitle title={title} illustration="reading" />
  {featured && featuredImage && <Split media="start" panel image={featuredImage} headingId="featured-heading" data-event-feature-expires={featured.endsAt}>
    <Text tone="muted"><time datetime={featured.startsAt}>{featuredDate}</time></Text>
    <Heading id="featured-heading">{featured.title}</Heading>
    <Text tone="muted">{featured.summary}</Text>
    <Stack direction="row" gap="xs" wrap>
      {featuredInPerson && <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>}
      <Button href={featured.href} variant={featuredInPerson ? 'outline' : 'accent'} iconEnd="arrow" screenReaderText={`about ${featured.title}`}>Read more</Button>
    </Stack>
  </Split>}
  {leadPost && <Split media="start" panel image={leadPost.image!} headingId="lead-post-heading" data-event-feature-fallback hidden={Boolean(featured && featuredImage)}>
    <Text tone="muted">Latest news{postDate(leadPost) && <> · <time datetime={leadPost.publishedAt ?? undefined}>{postDate(leadPost)}</time></>}</Text>
    <Heading id="lead-post-heading">{leadPost.title}</Heading>
    <Text tone="muted">{leadPost.summary}</Text>
    <Button href={leadPost.href} variant="accent" iconEnd="arrow" screenReaderText={`about ${leadPost.title}`}>Read more</Button>
  </Split>}
  {laterEvents.length > 0 && <Section title="Upcoming Events" headingId="events-heading" id="upcoming">
    <EventCards events={laterEvents} programs={programs} fill={false} limit={9} />
  </Section>}
  {programs.length > 0 && <Section title="Regular Events" headingId="regular-heading" id="regular">
    <Grid as="ul" columns={3}>
      {programs.map(program => <Card as="li" title={program.title} href={programHref(program.id)} image={program.image}>
        <Badge slot="badge" surface>{program.schedule}</Badge>
        {program.description}
      </Card>)}
    </Grid>
  </Section>}
  {latestPosts.length > 0 && <Section title="Latest News" headingId="news-heading" id="news">
    <PostList posts={latestPosts} />
    <Button href="/news/" iconEnd="arrow">All news</Button>
  </Section>}
</BaseLayout>
<script>
  // Hides the featured event once it ends (showing the latest news in its place), even when no event cards are on the page.
  import '../../scripts/event-refresh';
</script>
