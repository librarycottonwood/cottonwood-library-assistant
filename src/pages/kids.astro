---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
const { programs, library } = await contentRepository.getHome();
const storyTime = programs.find(program => program.id === 'story-time')!;
---
<SiteLayout title="Kids & families | Cottonwood Community Library">
  <PageIntro title="Kids & families" />
  <section class="container grid items-center gap-7 pb-10 lg:grid-cols-2" aria-labelledby="storytime-heading">
    <div class="overflow-hidden rounded-[4px]"><Image width={1100} quality={70} src={resolveImage(storyTime.image.key)} alt={storyTime.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 50vw" class="aspect-[1.5] w-full object-cover" loading="eager" /></div>
    <div><h2 id="storytime-heading" class="section-heading">Story Time</h2><p class="mt-3 font-semibold">{storyTime.schedule}</p><p class="mt-3 text-base text-muted">Stories, songs, crafts & a snack.</p><a href="/librarynews/story-time/" class="button button-primary mt-5">Come to Story Time</a></div>
  </section>
  <section class="container grid gap-4 pb-12 sm:grid-cols-2" aria-label="More for young readers">
    <a href={library.catalogUrl} class="action-tile action-gold"><Icon name="book" class="size-8 shrink-0" /><h2 class="text-xl font-bold">Find a book</h2></a>
    <a href="/visit/#borrowing" class="action-tile action-meadow"><Icon name="pin" class="size-8 shrink-0" /><h2 class="text-xl font-bold">Visit with your family</h2></a>
  </section>
</SiteLayout>
