---
import Image from '../components/OptimizedImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import InfoCard from '../components/InfoCard.astro';
import { contentRepository } from '../content/repository';
const { programs, library } = await contentRepository.getHome();
const storyTime = programs.find(program => program.id === 'story-time') ?? programs.find(program => program.audience === 'children');
// Real content only: the catalog, family accounts (borrowing questions) and the children's shelf of the ongoing book sale.
const cards = [
  { title: 'Find a book', note: 'Search our shelves for picture books and chapter books.', image: { key: 'readingNook', alt: 'A sunny reading nook inside the library, with a large window, wooden chairs, a patterned armchair and a bookcase.' }, action: { label: 'Browse the catalog', href: library.catalogUrl, external: true } },
  { title: 'Borrow as a family', note: 'Kids can borrow on a grown-up’s family account.', image: { key: 'newReads', alt: 'A table display of new chapter books for junior readers in front of library shelves.' }, action: { label: 'How borrowing works', href: '/visit/#questions' } },
  { title: 'Kids’ books for sale', note: 'Children’s and young-adult books in our ongoing book sale.', image: { key: 'childrensBookSale', alt: 'Children’s and young-adult books in the library’s ongoing book sale.' }, action: { label: 'Shop the book sale', href: '/fundraising-events/book-sale/' } },
];
---
<SiteLayout title="Kids & families | Cottonwood Community Library">
  <PageIntro title="Kids & families" />
  {storyTime && <section class="container section pt-0" aria-labelledby="storytime-heading">
    <div class="split">
      <Image width={1100} quality={70} image={storyTime.image} alt={storyTime.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 600px" class="feature-shape aspect-[1.4] w-full object-cover" loading="eager" />
      <div class="measure">
        <h2 id="storytime-heading" class="section-heading">{storyTime.title}</h2>
        <p class="mt-4 text-lg font-semibold">{storyTime.schedule}</p>
        <p class="mt-3 text-lg text-muted">{storyTime.details}</p>
        <a href={`/librarynews/${storyTime.id}/`} class="button button-primary mt-7">{storyTime.title} details</a>
      </div>
    </div>
  </section>}
  <section class="section section-tint" aria-labelledby="young-readers-heading">
    <div class="container">
      <h2 id="young-readers-heading" class="section-heading section-header">More for young readers</h2>
      <div class="card-grid">{cards.map(card => <InfoCard {...card} />)}</div>
    </div>
  </section>
</SiteLayout>
