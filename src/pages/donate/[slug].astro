---
// One way to help (volunteer, book sale, book donations, WOW points), in the Support Us layout:
// photo beside what it is and how to help (said once, in the panel), photos, other ways to help. Built only from src/components/site; text from Sanity.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/site/Button.astro';
import Card from '../../components/site/Card.astro';
import Gallery from '../../components/site/Gallery.astro';
import Grid from '../../components/site/Grid.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import Prose from '../../components/site/Prose.astro';
import Section from '../../components/site/Section.astro';
import Split from '../../components/site/Split.astro';
import Text from '../../components/site/Text.astro';
import { supportLink } from '../../components/site/navigation';
import { upcomingEvents } from '../../content/feeds';
import { contentRepository } from '../../content/repository';
import { DONATE_INITIATIVE_ID } from '../../content/donate';
import type { SupportInitiative } from '../../content/types';
import { otherWaysToHelp } from './_other-ways';
export async function getStaticPaths() {
  const { initiatives } = await contentRepository.getSupport();
  // The general giving initiative has no page of its own: Support Us is the donation page.
  return initiatives.filter(initiative => initiative.id !== DONATE_INITIATIVE_ID).map(initiative => ({ params: { slug: initiative.id }, props: { initiative } }));
}
interface Props { initiative: SupportInitiative; }
const { initiative } = Astro.props;
const [{ initiatives }, events] = await Promise.all([contentRepository.getSupport(), contentRepository.getEvents()]);
const action = initiative.action;
// The panel says it once: the first paragraph (what this is), then the steps. The summary is the card text on
// Support Us, and later paragraphs repeat the steps, so neither is shown again here.
const intro = initiative.paragraphs[0] ?? initiative.summary;
// Search titles name the task directly; the page keeps the library's invitation as its heading.
const searchTitles: Record<string, string> = {
  'volunteer': 'Volunteer at the library',
  'book-sale': 'Library book sales',
  'donate-books': 'Donate books and DVDs',
  'wow-points': 'Donate Holiday Market WOW points',
};
const searchTitle = searchTitles[initiative.id] ?? initiative.title;
const others = otherWaysToHelp(initiatives, initiative.id);
// The book-sale page names the next dated sale from the event records, if one is scheduled.
const nextSale = initiative.id === 'book-sale' ? upcomingEvents(events).find(event => /book sale/i.test(event.title)) : undefined;
const saleDate = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' });
---
<BaseLayout title={`${searchTitle} | Cottonwood Community Library`} description={initiative.summary} image={initiative.image}>
  <PageTitle title={initiative.title} trail={[supportLink]} />
  <Split media="start" panel image={initiative.image}>
    <Text size="lead">{intro}</Text>
    {nextSale && <Text>Next sale: <a href={nextSale.href}><time datetime={nextSale.startsAt}>{saleDate.format(new Date(nextSale.startsAt))}</time></a></Text>}
    <Prose steps={initiative.steps} />
    <Button href={action.href} download={action.download || undefined} variant="accent" icon={action.download ? 'download' : undefined} iconEnd={action.download ? undefined : 'arrow'}>{action.label}</Button>
  </Split>
  {initiative.gallery && initiative.gallery.length > 0 && <Section title="Photos" headingId="photos-heading">
    <Gallery images={initiative.gallery} />
  </Section>}
  {others.length > 0 && <Section title="Other ways to help" headingId="other-ways-heading">
    <Grid as="ul" columns={3}>
      {others.map(item => <Card as="li" title={item.title} href={`/donate/${item.id}/`} image={item.image}>{item.summary}</Card>)}
    </Grid>
  </Section>}
</BaseLayout>
