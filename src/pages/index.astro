---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import VisitPanel from '../components/VisitPanel.astro';
import { bookSaleDateLabel } from '../content/editorial';
import eventsArt from '../assets/actions/action-upcoming-events-foreground.png';
import kidsArt from '../assets/actions/action-kids-families-foreground.png';
import catalogArt from '../assets/actions/action-find-a-book-foreground.png';
import donateArt from '../assets/actions/action-donate-foreground.png';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
const { library, hero, programs } = await contentRepository.getHome();
const { initiatives } = await contentRepository.getSupport();
const bookSale = initiatives.find(item => item.id === 'book-sale')!;
const actions = [
  { label: 'Upcoming events', href: '/librarynews/', art: eventsArt, tone: 'action-sun' },
  { label: 'Kids & families', href: '/kids/', art: kidsArt, tone: 'action-meadow' },
  { label: 'Find a book', href: library.catalogUrl, art: catalogArt, tone: 'action-gold', event: 'catalog_quick' },
  { label: 'Donate', href: '/fundraising-events/', art: donateArt, tone: 'action-forest', event: 'donate_quick' },
];
const resources = [
  { label: 'Find your next read', note: 'Browse the library catalog', href: library.catalogUrl, icon: 'book' as const },
  { label: 'Computers & Wi-Fi', note: 'Get connected at the library', href: '/visit/#computers', icon: 'computer' as const },
  { label: 'Printing & copying', note: 'Ask for help at the front desk', href: '/visit/#printing', icon: 'printer' as const },
];
---
<SiteLayout>
  <section class="container py-8 sm:py-10" aria-labelledby="welcome-heading">
    <div class="grid items-center gap-6 lg:grid-cols-[.85fr_1.15fr] lg:gap-10">
      <div>
        <h1 id="welcome-heading" class="page-heading">{hero.heading[0]}<br /><em class="font-normal">{hero.heading[1]}</em></h1>
        <p class="mt-4 text-lg text-muted">Come read, play and connect.</p>
        <a href="#visit" class="button button-primary mt-6"><Icon name="pin" class="size-5" />Get directions</a>
      </div>
      <div class="feature-shape"><Image src={resolveImage(hero.image.key)} alt={hero.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 58vw" loading="eager" fetchpriority="high" class="aspect-[1.45] w-full object-cover object-left" /></div>
    </div>
  </section>

  <div class="container pb-10">
    <nav aria-label="Library quick links" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {actions.map(action => <a href={action.href} data-analytics-event={action.event} class:list={['action-tile', action.tone]}>
        <span class="action-label">{action.label}</span>
        <Image src={action.art} alt="" widths={[160, 260, 360]} sizes="150px" class="action-art" />
      </a>)}
    </nav>
  </div>

  <section id="programs" tabindex="-1" class="container pb-10 sm:pb-12" aria-labelledby="happening-heading">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <h2 id="happening-heading" class="section-heading">At your library</h2>
      <a href="/librarynews/" class="text-link">All events & news</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map(program => <ProgramCard program={program} />)}
      <FeatureCard title="Book sales" image={bookSale.image} href="/fundraising-events/book-sale/" note={bookSaleDateLabel} />
    </div>
  </section>

  <section class="container py-6 sm:py-10" aria-labelledby="independent-heading">
    <div class="support-home">
      <div class="support-home-copy">
        <h2 id="independent-heading" class="section-heading">Powered by<br /><em class="font-normal">our neighbors.</em></h2>
        <p class="mt-4 text-lg">No county or taxpayer funding.<br />Your support keeps the library open.</p>
        <a href="/fundraising-events/" class="button button-primary mt-6"><Icon name="heart" class="size-5" />Support your library</a>
      </div>
      <div class="support-home-image"><Image src={resolveImage('watercolor')} alt="Watercolor of Cottonwood Community Library." widths={[500,800]} sizes="(max-width:767px) 100vw, 45vw" class="h-full w-full object-contain" /></div>
    </div>
  </section>

  <section id="services" tabindex="-1" class="container pt-8 pb-4 sm:pt-12 sm:pb-6" aria-labelledby="services-heading">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <Image src={resolveImage('computerLab')} alt="Public computers inside Cottonwood Community Library." widths={[500,800]} sizes="(max-width:1023px) 100vw, 50vw" class="aspect-[1.4] w-full rounded-[4px] object-cover" />
      <div>
        <h2 id="services-heading" class="section-heading">More than books.</h2>
        <p class="mt-3 text-lg text-muted">A place to read, connect and get things done.</p>
        <nav aria-label="Library services" class="mt-5 divide-y divide-line">
          {resources.map(resource => <a href={resource.href} class="group flex items-center gap-4 py-5">
            <Icon name={resource.icon} class="size-6 shrink-0" />
            <span class="flex-1"><span class="block text-lg font-semibold group-hover:underline">{resource.label}</span><span class="block text-sm text-muted">{resource.note}</span></span>
            <Icon name="arrow" class="size-5 shrink-0" />
          </a>)}
        </nav>
      </div>
    </div>
  </section>

  <VisitPanel />
</SiteLayout>
