---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import VisitPanel from '../components/VisitPanel.astro';
import { bookSaleDateLabel } from '../content/editorial';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
import { checkoutAttributes, getDonateLink } from '../content/donate';
const { library, hero, programs } = await contentRepository.getHome();
const { initiatives } = await contentRepository.getSupport();
const donate = getDonateLink();
const bookSale = initiatives.find(item => item.id === 'book-sale')!;
const actions = [
  { label: 'Upcoming events', href: '/librarynews/', tone: 'action-sun' },
  { label: 'Kids & families', href: '/kids/', tone: 'action-meadow' },
  { label: 'Find a book', href: library.catalogUrl, tone: 'action-gold', event: 'catalog_quick' },
  { label: 'Donate', href: donate.href, tone: 'action-forest', event: 'donate_quick', attributes: checkoutAttributes(donate) },
];
const resources = [
  { label: 'Library catalog', note: 'Browse our collection', href: library.catalogUrl, icon: 'book' as const },
  { label: 'Computers & Wi-Fi', note: 'Public computers and Wi-Fi', href: '/visit/#computers', icon: 'computer' as const },
  { label: 'Printing & copying', note: 'Black-and-white prints: 20¢ per page', href: '/visit/#printing', icon: 'printer' as const },
];
---
<SiteLayout>
  <section class="container pt-8 pb-20 sm:pt-10 sm:pb-28" aria-labelledby="welcome-heading">
    <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-4">
      <div>
        <h1 id="welcome-heading" class="page-heading">{hero.heading[0]}<br /><em class="font-normal">{hero.heading[1]}</em></h1>
        <p class="mt-4 text-lg text-muted">Come read, play and connect.</p>
        <a href="#visit" class="button button-primary mt-5"><Icon name="pin" class="size-5" />Get directions</a>
      </div>
      <div class="relative">
        <div class="feature-shape"><Image width={1100} quality={70} src={resolveImage(hero.image.key)} alt={hero.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 50vw" loading="eager" fetchpriority="high" class="aspect-[1.45] w-full object-cover object-left" /></div>
        <a href={library.directionsUrl} data-analytics-event="directions_click" class="address-pill"><Icon name="pin" class="size-4 shrink-0" />{library.address} · Cottonwood</a>
      </div>
    </div>
  
    <nav aria-label="Library quick links" class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {actions.map((action, column) => <a href={action.href} {...('attributes' in action ? action.attributes : {})} data-analytics-event={action.event} class:list={['action-tile', action.tone]}>
        <span class="action-label">{action.label}</span>
        <span aria-hidden="true" class="button-concept-art" style={`--art-column: ${column}`} />
      </a>)}
    </nav>
  </section>

  <section id="programs" tabindex="-1" class="container section pt-0" aria-labelledby="happening-heading">
    <div class="section-header-row">
      <h2 id="happening-heading" class="section-heading">Coming up</h2>
      <a href="/librarynews/" class="text-link">All events<Icon name="arrow" class="size-4" /></a>
    </div>
    <a href="/fundraising-events/book-sale/" class="split group">
      <Image width={1100} quality={70} src={resolveImage(bookSale.image.key)} alt={bookSale.image.alt} widths={[500,800,1100]} sizes="(max-width:1023px) 100vw, 600px" class="feature-shape aspect-[1.6] w-full object-cover" />
      <div>
        <p class="text-lg font-semibold">{bookSaleDateLabel}</p>
        <h3 class="mt-2 font-display text-3xl leading-tight tracking-tight group-hover:underline sm:text-4xl">Quarterly book sale</h3>
        <p class="mt-3 text-lg text-muted">Back-door entry · Cash only.</p>
        <span class="text-link mt-4">Explore the sale<Icon name="arrow" class="size-4" /></span>
      </div>
    </a>
  </section>

  <section class="section section-tint" aria-labelledby="regular-heading">
    <div class="container">
      <div class="section-header-row">
        <h2 id="regular-heading" class="section-heading">Regular programs</h2>
        <a href="/librarynews/#regular" class="text-link">Times & details<Icon name="arrow" class="size-4" /></a>
      </div>
      <div class="card-grid">{programs.map(program => <ProgramCard program={program} />)}</div>
    </div>
  </section>

  <section class="container section" aria-labelledby="independent-heading">
    <div class="giving-banner">
      <div class="giving-copy">
        <h2 id="independent-heading" class="section-heading">Keep your<br /><em class="font-normal">library open.</em></h2>
        <p class="mt-5 max-w-sm text-lg text-paper/85">No county or taxpayer funding. Donations cover day-to-day operations.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={donate.href} {...checkoutAttributes(donate)} class="button bg-gold text-forest hover:bg-paper"><Icon name="heart" class="size-5" />{donate.source === 'fallback' ? 'Ways to give' : donate.label}</a>
          <a href="/fundraising-events/volunteer/" class="text-link text-paper">Volunteer<Icon name="arrow" class="size-4" /></a>
        </div>
      </div>
      <Image width={1100} quality={70} src={resolveImage('readingNook')} alt="A sunny reading nook inside the library, with a large window, wooden chairs, a patterned armchair, a magazine rack and a bookcase." widths={[500,800,1100]} sizes="(max-width:767px) 100vw, 600px" class="giving-photo" />
    </div>
  </section>

  <section id="services" tabindex="-1" class="container section pt-0" aria-labelledby="services-heading">
    <div class="split-equal">
      <div class="split-media"><Image width={800} quality={70} src={resolveImage('computerLab')} alt="Public computers inside Cottonwood Community Library." widths={[500,800]} sizes="(max-width:1023px) 100vw, 600px" class="object-cover" /></div>
      <div class="split-text">
        <h2 id="services-heading" class="section-heading">Library services</h2>
        <nav aria-label="Library services" class="mt-6 divide-y divide-line border-y border-line">
          {resources.map(resource => <a href={resource.href} class="group flex items-center gap-4 py-5">
            <Icon name={resource.icon} class="size-6 shrink-0" />
            <span class="flex-1"><span class="block text-lg font-semibold group-hover:underline">{resource.label}</span><span class="block text-sm text-muted">{resource.note}</span></span>
            <Icon name="arrow" class="size-5 shrink-0" />
          </a>)}
        </nav>
      </div>
    </div>
  </section>

  <div class="border-t border-line"><VisitPanel /></div>
</SiteLayout>
