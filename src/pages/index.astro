---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import VisitPanel from '../components/VisitPanel.astro';
import { bookSaleDateLabel } from '../content/editorial';
import eventsArt from '../assets/actions/action-upcoming-events-foreground.png';
import kidsArt from '../assets/actions/action-kids-families-foreground.png';
import catalogArt from '../assets/actions/action-find-a-book-foreground.png';
import donateArt from '../assets/actions/action-donate-foreground.png';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
const { library, hero, programs } = await contentRepository.getHome();
const { initiatives } = await contentRepository.getSupport();
const bookSale = initiatives.find(item => item.id === 'book-sale')!;
const actions = [
  { label: 'Upcoming events', href: '/librarynews/', art: eventsArt, tone: 'action-sun' },
  { label: 'Kids & families', href: '/kids/', art: kidsArt, tone: 'action-meadow' },
  { label: 'Find a book', href: library.catalogUrl, art: catalogArt, tone: 'action-gold', event: 'catalog_quick' },
  { label: 'Donate', href: '/fundraising-events/', art: donateArt, tone: 'action-forest', event: 'donate_quick' },
];
const resources = [
  { label: 'Library catalog', note: 'Browse our collection', href: library.catalogUrl, icon: 'book' as const },
  { label: 'Computers & Wi-Fi', note: 'Public computers and Wi-Fi', href: '/visit/#computers', icon: 'computer' as const },
  { label: 'Printing & copying', note: 'Black-and-white prints: 20¢ per page', href: '/visit/#printing', icon: 'printer' as const },
];
---
<SiteLayout>
  <section class="container py-8 sm:py-10" aria-labelledby="welcome-heading">
    <div class="grid items-center gap-6 lg:grid-cols-[.85fr_1.15fr] lg:gap-10">
      <div>
        <h1 id="welcome-heading" class="page-heading">{hero.heading[0]}<br /><em class="font-normal">{hero.heading[1]}</em></h1>
        <p class="mt-4 text-lg text-muted">Come read, play and connect.</p>
        <p class="mt-4 text-base text-muted">{library.address} · Cottonwood</p>
        <a href="#visit" class="button button-primary mt-5"><Icon name="pin" class="size-5" />Get directions</a>
      </div>
      <div class="feature-shape"><Image src={resolveImage(hero.image.key)} alt={hero.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 58vw" loading="eager" fetchpriority="high" class="aspect-[1.45] w-full object-cover object-left" /></div>
    </div>
  </section>

  <div class="container pb-10">
    <nav aria-label="Library quick links" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {actions.map(action => <a href={action.href} data-analytics-event={action.event} class:list={['action-tile', action.tone]}>
        <span class="action-label">{action.label}</span>
        <Image src={action.art} alt="" widths={[160, 260, 360]} sizes="150px" class="action-art" />
      </a>)}
    </nav>
  </div>

  <section id="programs" tabindex="-1" class="container-editorial py-5 sm:pt-8 sm:pb-14" aria-labelledby="happening-heading">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <h2 id="happening-heading" class="section-heading">Coming up</h2>
      <a href="/librarynews/" class="text-link">See the calendar<Icon name="arrow" class="size-4" /></a>
    </div>
    <div class="coming-up">
      <a href="/fundraising-events/book-sale/" class="coming-feature group">
        <div class="feature-shape">
          <Image src={resolveImage(bookSale.image.key)} alt={bookSale.image.alt} widths={[500,800,1100]} sizes="(max-width:1023px) 100vw, 530px" class="aspect-[1.9] w-full object-cover" />
        </div>
        <p class="eyebrow mt-5">{bookSaleDateLabel}</p>
        <h3 class="mt-2 font-display text-3xl leading-tight tracking-tight group-hover:underline sm:text-4xl">Quarterly book sale</h3>
        <p class="mt-3 text-base text-muted">Back-door entry · Cash only.</p>
        <span class="text-link mt-2">Explore the sale<Icon name="arrow" class="size-4" /></span>
      </a>
      <div class="program-agenda">
        <p class="eyebrow mb-2 text-muted">Gather at the library</p>
        {programs.map(program => <a href={`/librarynews/${program.id}/`} class="program-row group">
          <Image src={resolveImage(program.image.key)} alt={program.image.alt} widths={[160,260]} sizes="(max-width:639px) 88px, 112px" class:list={['program-thumb',program.image.fit === 'contain' ? 'object-contain p-2' : 'object-cover']} />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-muted">{program.schedule}</p>
            <h3 class="card-heading mt-1 group-hover:underline">{program.title}</h3>
          </div>
          <Icon name="arrow" class="size-5 shrink-0" />
        </a>)}
      </div>
    </div>
  </section>

  <section class="container py-7 sm:py-10" aria-labelledby="independent-heading">
    <div class="giving-banner">
      <div class="giving-copy">
        <p class="eyebrow text-gold">Community-funded library</p>
        <h2 id="independent-heading" class="section-heading mt-4">Keep your<br /><em class="font-normal">library open.</em></h2>
        <p class="mt-5 max-w-sm text-lg text-paper/85">No county or taxpayer funding.<br />Donations help cover day-to-day operations.</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/fundraising-events/library-fund/" class="button bg-gold text-forest hover:bg-paper"><Icon name="heart" class="size-5" />Make a donation</a>
          <a href="/fundraising-events/volunteer/" class="text-link text-paper">Volunteer<Icon name="arrow" class="size-4" /></a>
        </div>
      </div>
      <Image src={resolveImage('interior')} alt="Bookshelves and reading spaces inside Cottonwood Community Library." widths={[500,800,1100]} sizes="(max-width:767px) 100vw, 50vw" class="giving-photo" />
    </div>
  </section>

  <section id="services" tabindex="-1" class="container-narrow pt-8 pb-4 sm:pt-14 sm:pb-8" aria-labelledby="services-heading">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-10">
      <Image src={resolveImage('computerLab')} alt="Public computers inside Cottonwood Community Library." widths={[500,800]} sizes="(max-width:1023px) 100vw, 440px" class="aspect-[1.4] w-full rounded-[4px] object-cover" />
      <div>
        <h2 id="services-heading" class="section-heading">Library services</h2>
        <nav aria-label="Library services" class="mt-5 divide-y divide-line">
          {resources.map(resource => <a href={resource.href} class="group flex items-center gap-4 py-5">
            <Icon name={resource.icon} class="size-6 shrink-0" />
            <span class="flex-1"><span class="block text-lg font-semibold group-hover:underline">{resource.label}</span><span class="block text-sm text-muted">{resource.note}</span></span>
            <Icon name="arrow" class="size-5 shrink-0" />
          </a>)}
        </nav>
      </div>
    </div>
  </section>

  <VisitPanel />
</SiteLayout>
