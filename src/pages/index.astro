---
// Homepage, built only from src/components/site (see docs/design-system.md).
import Image from '../components/OptimizedImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/site/Badge.astro';
import Button from '../components/site/Button.astro';
import CommunitySupport from '../components/site/CommunitySupport.astro';
import HomeEvents from '../components/site/HomeEvents.astro';
import ServiceLinks from '../components/site/ServiceLinks.astro';
import FirstVisit from '../components/site/FirstVisit.astro';
import HeroHeading from '../components/site/HeroHeading.astro';
import HeroContacts from '../components/site/HeroContacts.astro';
import Section from '../components/site/Section.astro';
import Split from '../components/site/Split.astro';
import Stack from '../components/site/Stack.astro';
import Text from '../components/site/Text.astro';
import fundraiserHouse from '../assets/images/fundraiser-house.png';
import { activeCampaign, upcomingEvents } from '../content/feeds';
import { contentRepository } from '../content/repository';
import { DONATE_PAGE_HREF } from '../content/donate';
const [home, support, allEvents] = await Promise.all([contentRepository.getHome(), contentRepository.getSupport(), contentRepository.getEvents()]);
const { library, hero, programs, services } = home;
const events = upcomingEvents(allEvents);
const campaign = activeCampaign(support.campaigns);
// Existing borrowing guidance from Visit Us, surfaced here for first-time visitors.
const firstVisitAnswers = [
  { title: 'Opening an account', text: 'Adults bring photo ID and proof of residence to the front desk.' },
  { title: 'Borrowing books', text: 'Tell a volunteer your account name. We don’t issue physical library cards.' },
];
---
<BaseLayout title="Cottonwood Community Library | Cottonwood, CA" description="Visit your community-supported library in Cottonwood, California. Find hours, books, Story Time, reading groups, and ways to support your local library.">
  <Split media="end" image={hero.image} headingId="welcome-heading" mediaId="visit" first>
    {campaign && <Badge href={DONATE_PAGE_HREF} iconEnd="external" data-campaign-only data-campaign-ends={campaign.endsOn}>
      <Image slot="start" src={campaign.image ? undefined : fundraiserHouse} image={campaign.image} alt="" width={50} height={50} />
      {campaign.badgeLabel ?? campaign.title}
    </Badge>}
    <Stack gap="sm">
      <HeroHeading lines={hero.heading} id="welcome-heading" />
      <Text tone="muted" size="lead">{hero.introduction}</Text>
    </Stack>
    <Stack direction="row" gap="xs" wrap>
      <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
      <Button href={library.catalogUrl} data-analytics-event="catalog_quick" icon="book">Catalog</Button>
    </Stack>
    <HeroContacts slot="caption" address={`${library.address}, Cottonwood`} directionsHref={library.directionsUrl} phone={library.phone} phoneHref={library.phoneHref} />
  </Split>

  <CommunitySupport title={home.support.title} introduction={home.support.introduction} />

  <HomeEvents events={events} programs={programs} />

  <Section title="Library services" headingId="services-heading" align="start" gap="md">
    <ServiceLinks services={services} catalogUrl={library.catalogUrl} />
  </Section>

  <FirstVisit items={firstVisitAnswers} />
</BaseLayout>
