---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { contentRepository } from '../content/repository';
import { resolveImage } from '../content/images';
const { library, hero, programs } = await contentRepository.getHome();
const { initiatives } = await contentRepository.getSupport();
const bookSale = initiatives.find(item => item.id === 'book-sale')!;
const actions = [
  { label: 'Upcoming events', href: '/librarynews/', icon: 'calendar' as const, tone: 'action-meadow' },
  { label: 'Kids & families', href: '/kids/', icon: 'book' as const, tone: 'action-gold' },
  { label: 'Find a book', href: library.catalogUrl, icon: 'book-sale' as const, tone: 'action-paper', event: 'catalog_quick' },
  { label: 'Donate', href: '/fundraising-events/', icon: 'heart' as const, tone: 'action-forest', event: 'donate_quick' },
];
const resources = [
  { label: 'Library catalog', href: library.catalogUrl, icon: 'book' as const },
  { label: 'Computers & Wi-Fi', href: '/visit/#computers', icon: 'computer' as const },
  { label: 'Printing & copying', href: '/visit/#printing', icon: 'printer' as const },
  { label: 'Hours & directions', href: '/visit/', icon: 'pin' as const },
];
---
<SiteLayout>
  <section class="container py-8 sm:py-10" aria-labelledby="welcome-heading">
    <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-12">
      <div>
        <h1 id="welcome-heading" class="page-heading">{hero.heading[0]}<br /><em class="font-normal">{hero.heading[1]}</em></h1>
        <p class="mt-4 text-lg text-muted">Come read, play and connect.</p>
      </div>
      <div class="feature-shape"><Image src={resolveImage(hero.image.key)} alt={hero.image.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 50vw" loading="eager" fetchpriority="high" class="aspect-[2] w-full object-cover object-left lg:aspect-[1.8]" /></div>
    </div>
  </section>

  <div class="container pb-10">
    <nav aria-label="Library quick links" class="grid grid-cols-2 gap-3 lg:grid-cols-4 sm:gap-4">
      {actions.map(action => <a href={action.href} data-analytics-event={action.event} class:list={['action-tile', action.tone]}>
        <Icon name={action.icon} class="size-7 shrink-0 sm:size-8" />
        <span class="text-base font-bold leading-tight sm:text-xl">{action.label}</span>
      </a>)}
    </nav>
  </div>

  <section id="programs" tabindex="-1" class="container pb-10 sm:pb-12" aria-labelledby="happening-heading">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <h2 id="happening-heading" class="section-heading">At your library</h2>
      <a href="/librarynews/" class="text-link">All events & news</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map(program => <ProgramCard program={program} />)}
      <FeatureCard title="Book sales" image={bookSale.image} href="/fundraising-events/book-sale/" note="Shop & support your library" />
    </div>
  </section>

  <section class="bg-forest py-8 text-paper" aria-labelledby="independent-heading">
    <div class="container flex flex-wrap items-center justify-between gap-5">
      <h2 id="independent-heading" class="font-display text-2xl leading-tight sm:text-3xl">Community funded.<br />No county or taxpayer money.</h2>
      <a href="/fundraising-events/" class="button bg-gold text-forest-dark hover:bg-white focus-visible:outline-paper"><Icon name="heart" class="size-5" />Keep your library open</a>
    </div>
  </section>

  <section id="services" tabindex="-1" class="container py-10 sm:py-12" aria-labelledby="services-heading">
    <h2 id="services-heading" class="section-heading">Services and resources</h2>
    <nav aria-label="Services and resources" class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4 sm:gap-4">
      {resources.map(resource => <a href={resource.href} class="resource-link group"><span class="resource-icon"><Icon name={resource.icon} class="size-7" /></span><span class="text-sm font-semibold leading-snug group-hover:underline sm:text-base">{resource.label}</span></a>)}
    </nav>
  </section>

  <section id="visit" tabindex="-1" class="bg-meadow py-8" aria-labelledby="visit-heading">
    <div class="container flex flex-wrap items-center justify-between gap-5">
      <div><h2 id="visit-heading" class="card-heading">Come visit</h2><p class="mt-2 text-base">{library.address} · Cottonwood</p></div>
      <p class="text-sm">Monday–Wednesday · 11 a.m.–5 p.m.<br />Saturday · 11 a.m.–2 p.m.</p>
      <a href={library.directionsUrl} class="button button-outline"><Icon name="pin" class="size-4" />Get directions</a>
    </div>
  </section>
</SiteLayout>
