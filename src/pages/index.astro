---
// Homepage, built only from src/components/site (see docs/design-system.md).
import Image from '../components/OptimizedImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/site/Badge.astro';
import Button from '../components/site/Button.astro';
import Card from '../components/site/Card.astro';
import EventCards from '../components/site/EventCards.astro';
import Grid from '../components/site/Grid.astro';
import Heading from '../components/site/Heading.astro';
import IconLink from '../components/site/IconLink.astro';
import Section from '../components/site/Section.astro';
import Split from '../components/site/Split.astro';
import Stack from '../components/site/Stack.astro';
import Text from '../components/site/Text.astro';
import fundraiserHouse from '../assets/images/fundraiser-house.png';
import { activeCampaign, upcomingEvents } from '../content/feeds';
import { contentRepository } from '../content/repository';
import { checkoutAttributes, DONATE_PAGE_HREF, getDonateLink } from '../content/donate';
import type { LibraryImage } from '../content/types';
const [home, support, allEvents, donate] = await Promise.all([contentRepository.getHome(), contentRepository.getSupport(), contentRepository.getEvents(), getDonateLink()]);
const { library, hero, programs, services, givingImage } = home;
const events = upcomingEvents(allEvents);
const campaign = activeCampaign(support.campaigns);
const featured = events[0]?.image ? events[0] : undefined;
const givingPhoto = givingImage ?? home.support.image;
// Services have no photos in the CMS yet, so each icon maps to a library photo.
const servicePhotos: Record<string, LibraryImage> = {
  book: { key: 'interior', alt: '' },
  computer: { key: 'computerLab', alt: '' },
  printer: { key: 'copyRoom', alt: '' },
};
const serviceLink = (service: typeof services[number]) => service.icon === 'book' ? library.catalogUrl : `/visit/#${service.id}`;
const featuredDate = featured && new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' }).format(new Date(featured.startsAt));
---
<BaseLayout>
  <Split media="end" image={hero.image} headingId="welcome-heading" mediaId="visit" first>
    {campaign && <Badge href={DONATE_PAGE_HREF} iconEnd="external">
      <Image slot="start" src={campaign.image ? undefined : fundraiserHouse} image={campaign.image} alt="" width={50} height={50} />
      {campaign.title}
    </Badge>}
    <Heading level={1} size="display" id="welcome-heading">{hero.heading[0]}<br />{hero.heading[1]}</Heading>
    <Text tone="muted">{hero.introduction}</Text>
    <Stack direction="row" gap="xs" wrap>
      <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
      <Button href={library.catalogUrl} data-analytics-event="catalog_quick" icon="book">Catalog</Button>
    </Stack>
    <Fragment slot="caption">
      <IconLink href={library.directionsUrl} data-analytics-event="directions_click" icon="pin">{library.address}, Cottonwood</IconLink>
      <IconLink href={library.phoneHref} icon="phone">{library.phone}</IconLink>
    </Fragment>
  </Split>

  {featured?.image && <Split media="start" image={featured.image} ratio="16 / 9" headingId="featured-heading" data-event-feature-expires={featured.endsAt}>
    <Text tone="muted"><time datetime={featured.startsAt}>{featuredDate}</time></Text>
    <Heading id="featured-heading">{featured.title}</Heading>
    <Text tone="muted" size="lead">{featured.summary}</Text>
    <Button href={featured.href} variant="accent" iconEnd="arrow">Read more</Button>
  </Split>}

  <Section title="Upcoming events" headingId="events-heading">
    <EventCards events={events} programs={programs} fallbackImage={hero.image} limit={3} emptyMessage="No special events are scheduled right now. Story Time and our reading groups still meet every week." />
    <Button href="/librarynews/" iconEnd="arrow">View all</Button>
  </Section>

  <Section title="Library services" headingId="services-heading">
    <Grid as="ul" columns={3}>
      {services.map(service => <Card as="li" title={service.title} href={serviceLink(service)} image={servicePhotos[service.icon]!}>{service.description}</Card>)}
    </Grid>
    <Button href="/visit/" iconEnd="arrow">Read more</Button>
  </Section>

  <Split media="start" image={givingPhoto} headingId="community-heading">
    <Heading id="community-heading">{home.support.title}</Heading>
    <Text tone="muted">{home.support.introduction}</Text>
    <Stack direction="row" gap="xs" wrap>
      <Button href={donate.href} {...checkoutAttributes(donate)} data-analytics-event="donate_quick" variant="accent" icon="heart">{donate.source === 'fallback' ? 'Ways to give' : 'Donate'}</Button>
      <Button href="/fundraising-events/volunteer/" icon="user">Volunteer</Button>
    </Stack>
  </Split>
</BaseLayout>
