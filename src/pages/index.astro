---
// Homepage, built only from src/components/site (see docs/design-system.md).
import Image from '../components/OptimizedImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/site/Badge.astro';
import Button from '../components/site/Button.astro';
import Card from '../components/site/Card.astro';
import CrayonHighlight from '../components/site/CrayonHighlight.astro';
import EventCards from '../components/site/EventCards.astro';
import Grid from '../components/site/Grid.astro';
import Heading from '../components/site/Heading.astro';
import IconLink from '../components/site/IconLink.astro';
import LibraryIllustration from '../components/site/LibraryIllustration.astro';
import Section from '../components/site/Section.astro';
import Split from '../components/site/Split.astro';
import Stack from '../components/site/Stack.astro';
import Text from '../components/site/Text.astro';
import fundraiserHouse from '../assets/images/fundraiser-house.png';
import { activeCampaign, upcomingEvents } from '../content/feeds';
import { contentRepository } from '../content/repository';
import { servicePhotos } from '../content/service-photos';
import { checkoutAttributes, DONATE_PAGE_HREF, getDonateLink } from '../content/donate';
import { eventPhoto } from './_photos';
const [home, support, allEvents, donate] = await Promise.all([contentRepository.getHome(), contentRepository.getSupport(), contentRepository.getEvents(), getDonateLink()]);
const { library, hero, programs, services, givingImage } = home;
const events = upcomingEvents(allEvents);
const campaign = activeCampaign(support.campaigns);
// Figma's photo-and-text block always shows the next event; with no photo of its own it shows its program's photo,
// or a fitting library photo (the same photo as on Events & News and the event page).
const featured = events[0];
const featuredImage = featured && eventPhoto(featured, programs);
const givingPhoto = givingImage ?? home.support.image;
const serviceLink = (service: typeof services[number]) => service.icon === 'book' ? library.catalogUrl : `/services/#${service.id}`;
const featuredDate = featured && new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' }).format(new Date(featured.startsAt));
---
<BaseLayout title="Cottonwood Community Library | Cottonwood, CA" description="Visit your community-supported library in Cottonwood, California. Find hours, books, Story Time, reading groups, and ways to support your local library.">
  <Split media="end" image={hero.image} headingId="welcome-heading" mediaId="visit" first>
    {campaign && <Badge href={DONATE_PAGE_HREF} iconEnd="external" data-campaign-only data-campaign-ends={campaign.endsOn}>
      <Image slot="start" src={campaign.image ? undefined : fundraiserHouse} image={campaign.image} alt="" width={50} height={50} />
      {campaign.badgeLabel ?? campaign.title}
    </Badge>}
    <Stack gap="sm">
      <Heading level={1} size="display" id="welcome-heading">{hero.heading[0]}<br /><CrayonHighlight text={hero.heading[1]} /></Heading>
      <Text tone="muted" size="lead">{hero.introduction}</Text>
    </Stack>
    <Stack direction="row" gap="xs" wrap>
      <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
      <Button href={library.catalogUrl} data-analytics-event="catalog_quick" icon="book">Catalog</Button>
    </Stack>
    <Fragment slot="caption">
      <IconLink href={library.directionsUrl} data-analytics-event="directions_click" icon="pin">{library.address}, Cottonwood</IconLink>
      <IconLink href={library.phoneHref} icon="phone">{library.phone}</IconLink>
    </Fragment>
  </Split>

  <Split media="start" image={givingPhoto} headingId="community-heading" crayon>
    <Stack gap="sm" align="center">
      <LibraryIllustration scene="community" />
      <Heading id="community-heading"><CrayonHighlight text={home.support.title} /></Heading>
    </Stack>
    <Text tone="muted" balance>{home.support.introduction}</Text>
    <Stack direction="row" gap="xs" wrap>
      <Button href={donate.href} {...checkoutAttributes(donate)} data-analytics-event="donate_quick" variant="accent" icon="heart">{donate.source === 'fallback' ? 'Ways to give' : 'Donate'}</Button>
      <Button href="/donate/volunteer/" icon="user">Volunteer</Button>
    </Stack>
  </Split>

  {featured && featuredImage && <Split media="end" image={featuredImage} ratio="16 / 9" headingId="featured-heading" data-event-feature-expires={featured.endsAt}>
    <Text tone="muted"><time datetime={featured.startsAt}>{featuredDate}</time></Text>
    <Heading id="featured-heading">{featured.title}</Heading>
    <Text tone="muted">{featured.summary}</Text>
    <Button href={featured.href} variant="accent" iconEnd="arrow" screenReaderText={`about ${featured.title}`}>Read more</Button>
  </Split>}

  <Section title="Upcoming events" headingId="events-heading" illustration="reading">
    <EventCards events={featured ? events.filter(event => event !== featured) : events} programs={programs} limit={3} />
    <Button href="/events/" iconEnd="arrow">View all</Button>
  </Section>

  <Section title="Library services" headingId="services-heading" illustration="computers">
    <Grid as="ul" columns={3}>
      {services.map(service => <Card as="li" title={service.title} href={serviceLink(service)} image={servicePhotos[service.icon]!} fullText>{service.description}</Card>)}
    </Grid>
    <Button href="/services/" iconEnd="arrow" screenReaderText="about library services">Read more</Button>
  </Section>
</BaseLayout>
