---
import ContentImage from '../../components/ContentImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { contentRepository } from '../../content/repository';
import { upcomingEvents } from '../../content/feeds';
import { DONATE_INITIATIVE_ID } from '../../content/donate';
import type { SupportInitiative } from '../../content/types';
export async function getStaticPaths() {
  const { initiatives } = await contentRepository.getSupport();
  // The general giving initiative has no page of its own: its old address redirects to the Donate page.
  return initiatives.filter(initiative => initiative.id !== DONATE_INITIATIVE_ID).map(initiative => ({ params: { slug: initiative.id }, props: { initiative } }));
}
interface Props { initiative: SupportInitiative; }
const { initiative } = Astro.props;
const [{ initiatives }, events] = await Promise.all([contentRepository.getSupport(), contentRepository.getEvents()]);
const action = initiative.action;
const details = initiative.paragraphs.filter(text => text !== initiative.summary);
const others = initiatives.filter(item => item.id !== initiative.id && item.id !== DONATE_INITIATIVE_ID && item.category !== 'volunteering').slice(0, 3);
// The book-sale page names the next dated sale from the shared event records, if one is scheduled.
const nextSale = initiative.id === 'book-sale' ? upcomingEvents(events).find(event => /book sale/i.test(event.title)) : undefined;
const saleDate = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' });
---
<SiteLayout title={`${initiative.title} | Cottonwood Community Library`} description={initiative.summary}>
  <PageIntro title={initiative.title} description={initiative.summary} back={{ href: '/fundraising-events/', label: 'Support us' }} />
  <section class="container section pt-0" aria-labelledby="how-heading">
    <div class="split-equal">
      <div class="split-media"><ContentImage image={initiative.image} variant="feature" eager /></div>
      <div class="panel">
        <h2 id="how-heading" class="card-heading">{initiative.id === 'book-sale' ? 'Shop & support' : 'How to help'}</h2>
        {initiative.id === 'book-sale' && (nextSale ? <p class="mt-3 text-base font-semibold">Next sale: <a href={nextSale.href} class="underline"><time datetime={nextSale.startsAt}>{saleDate.format(new Date(nextSale.startsAt))}</time></a></p> : <p class="mt-3 text-base">Larger sales: roughly quarterly, when storage fills up. Next date to be announced.</p>)}
        <ol class="mt-5 list-none space-y-3 p-0">{initiative.steps.map((step, index) => <li class="flex gap-3 text-base"><span class="shrink-0 font-semibold" aria-hidden="true">{index + 1}.</span><span>{step}</span></li>)}</ol>
        <a href={action.href} class="button button-primary mt-7 self-start">{action.label}{'download' in action && action.download && <Icon name="download" class="size-4 shrink-0" />}</a>
      </div>
    </div>
  </section>
  {(details.length > 0 || initiative.gallery) && <section class="container-prose section pt-0" aria-label="More about this">
    {details.length > 0 && <div class="prose-flow">{details.map(text => <p>{text}</p>)}</div>}
    {initiative.gallery && <PhotoGallery images={initiative.gallery} />}
  </section>}
  {others.length > 0 && <section class="section section-tint" aria-labelledby="other-ways">
    <div class="container">
      <h2 id="other-ways" class="section-heading section-header">Other ways to help</h2>
      <div class="card-grid">{others.map(item => <FeatureCard title={item.title} image={item.image} href={`/fundraising-events/${item.id}/`} />)}</div>
    </div>
  </section>}
</SiteLayout>
