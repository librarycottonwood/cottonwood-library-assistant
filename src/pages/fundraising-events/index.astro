---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import GivingPanel from '../../components/GivingPanel.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import ContentImage from '../../components/ContentImage.astro';
import PostFeed from '../../components/PostFeed.astro';
import UpdateFeed from '../../components/UpdateFeed.astro';
import Disclosure from '../../components/Disclosure.astro';
import Icon from '../../components/Icon.astro';
import { contentRepository } from '../../content/repository';
import { activeCampaign } from '../../content/feeds';
const [{ library, support }, { campaigns, updates, initiatives }, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getSupport(), contentRepository.getPosts()]);
const campaign = activeCampaign(campaigns);
const options = [
  { id: 'donate-books', title: 'Donate books & DVDs', note: 'Material donations', image: { key: 'stacks', alt: 'Shelves of books in Cottonwood Community Library.' } },
  { id: 'book-sale', title: 'Shop a book sale', note: 'Every purchase helps', image: initiatives.find(item => item.id === 'book-sale')!.image },
  { id: 'wow-points', title: 'Give WOW points', note: 'Holiday Market rewards', image: initiatives.find(item => item.id === 'wow-points')!.image },
];
---
<SiteLayout title="Donate & support | Cottonwood Community Library" description="Your donations keep Cottonwood’s independent community library open.">
  <PageIntro title="Your gifts keep us open" description="No county funding. No taxpayer funding. Just community." />
  <section class="container grid items-stretch gap-6 pb-10 lg:grid-cols-2" aria-label="Financial donations">
    <ContentImage image={support.image} variant="feature" eager />
    <GivingPanel library={library} campaign={campaign} />
  </section>
  <section class="container pb-12" aria-labelledby="other-support-heading">
    <h2 id="other-support-heading" class="section-heading mb-6">Other ways to help</h2>
    <div class="grid gap-5 sm:grid-cols-3">{options.map(option => <FeatureCard title={option.title} note={option.note} image={option.image} href={`/fundraising-events/${option.id}/`} />)}</div>
  </section>
  <section id="stories" tabindex="-1" class="bg-meadow/50 py-10 sm:py-12" aria-labelledby="support-stories-heading">
    <div class="container-narrow"><h2 id="support-stories-heading" class="section-heading mb-6">Why your support matters</h2><PostFeed posts={posts} />
      <div class="mt-6"><Disclosure title="Community acknowledgments"><UpdateFeed updates={updates} /></Disclosure></div>
    </div>
  </section>
  <section class="container-narrow py-8" aria-label="Helping at the library"><Disclosure title="Interested in helping at the library?"><p>Contact the director about screening and available roles. Applications are reviewed before placement.</p><a href={support.volunteerFileUrl} class="text-link mt-3">Application (PDF)<Icon name="download" class="size-4" /></a></Disclosure></section>
</SiteLayout>
