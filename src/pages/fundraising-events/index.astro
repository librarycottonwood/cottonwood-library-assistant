---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import DonateSection from '../../components/DonateSection.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import PostFeed from '../../components/PostFeed.astro';
import UpdateFeed from '../../components/UpdateFeed.astro';
import Disclosure from '../../components/Disclosure.astro';
import { contentRepository } from '../../content/repository';
import { activeCampaign } from '../../content/feeds';
import { dayAfter } from '../../content/donate';
const [{ library, hero }, { campaigns, updates, initiatives }, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getSupport(), contentRepository.getPosts()]);
const campaign = activeCampaign(campaigns);
// After the fundraiser's end date the visitor's browser swaps in this version (CampaignExpiry.astro).
const ended = campaign?.endsOn ? dayAfter(campaign.endsOn) : undefined;
const options = initiatives.filter(item => item.category === 'community');
---
<SiteLayout title="Donate & support | Cottonwood Community Library" description="Your donations keep Cottonwood’s independent community library open.">
  <PageIntro title="Your gifts keep us open" description="No county or taxpayer funding. Just neighbors." />
  {ended ? <>
    <div data-campaign-only data-campaign-ends={campaign!.endsOn}><DonateSection library={library} campaign={campaign} /></div>
    <div data-campaign-after data-campaign-ends={campaign!.endsOn} hidden><DonateSection library={library} campaign={activeCampaign(campaigns, ended)} now={ended} headingId="donate-heading-after" /></div>
  </> : <DonateSection library={library} campaign={campaign} />}
  <section class="section section-tint" aria-labelledby="other-support-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="other-support-heading" class="section-heading">Other ways to help</h2>
      </div>
      <div class="card-grid">{options.map(option => <FeatureCard title={option.title} note={option.label} image={option.image} href={`/fundraising-events/${option.id}/`} />)}</div>
      <p class="mt-10 text-base">Like to give your time? <a href="/fundraising-events/volunteer/" class="font-semibold underline">Volunteer at the library</a></p>
    </div>
  </section>
  <section id="stories" tabindex="-1" class="container-prose section" aria-labelledby="support-stories-heading">
    <div>
      <h2 id="support-stories-heading" class="section-heading section-header">Why your support matters</h2>
      <PostFeed posts={posts.filter(post => post.id !== 'newsletter')} fallbackImage={hero.image} />
      <div class="mt-8 border-t border-line"><Disclosure title="Community acknowledgments"><UpdateFeed updates={updates} /></Disclosure></div>
    </div>
  </section>
</SiteLayout>
