---
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import { quickReference, reviewed, academyUrl } from './_guide';
---
<AcademyLayout title="One-page desk guide" print>
  <article class="desk-guide">
    <p class="eyebrow">Cottonwood Community Library · Keep beside the computer</p><h1>Your volunteer desk guide</h1><p class="lead">Ask clearly. Check the preview. Verify the result.</p>
    <button class="button primary screen-only" data-print hidden>Print or save a PDF</button>
    <dl>{quickReference.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
    <p><strong>Safe practice:</strong> Begin with “PRACTICE ONLY. Do not create, change, publish, send, schedule or delete anything. Keep this exercise in chat.”</p>
    <p><strong>Immediate danger:</strong> Follow the library’s emergency procedure. Do not wait for ChatGPT.</p>
    <div class="contact-lines"><p>Board contact (fill in privately): __________________________________</p><p>Backup contact: _________________________________________________</p></div>
    <p class="small">Reviewed {reviewed} · Full guide: <a href={academyUrl}>{academyUrl}</a><br />This sheet contains no account credentials. Store access details privately.</p>
  </article>
</AcademyLayout>
