---
import PrintButton from '../../components/academy/PrintButton.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/logos/library-tree.png';
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import ServiceMap from '../../components/academy/ServiceMap.astro';
import LessonBody from '../../components/academy/LessonBody.astro';
import { lessons, reviewed, academyUrl } from './_guide';
---
<AcademyLayout title="Printable handbook" print>
  <header class="handbook-cover"><Image src={logo} alt="Cottonwood Community Library tree emblem" width={72} class="handbook-mark" /><p class="eyebrow">Cottonwood Community Library</p><h1>Volunteer handbook</h1><p class="lead">Getting started with ChatGPT and the library’s tools.</p><p>Reviewed {reviewed}. Latest guide: <a href={academyUrl}>{academyUrl}</a></p><p>Read a lesson, try an example, and come back whenever you need a reminder.</p><PrintButton /><p class="screen-only small">Print on Letter or A4 paper. Turn browser headers/footers off. The lessons and answers are included.</p><ol>{lessons.map(lesson => <li><a href={`#${lesson.slug}`}>{lesson.title}</a></li>)}</ol></header>
  {lessons.map((lesson, index) => <article class="print-lesson" id={lesson.slug}><p class="eyebrow">Lesson {index + 1}</p><h2 class="print-title">{lesson.title}</h2><LessonBody lesson={lesson} print /></article>)}
  <ServiceMap print />
</AcademyLayout>
