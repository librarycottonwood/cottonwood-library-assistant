---
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import LessonBody from '../../components/academy/LessonBody.astro';
import { lessons, reviewed, academyUrl } from './_guide';
---
<AcademyLayout title="Printable handbook" print>
  <header class="handbook-cover"><p class="eyebrow">Cottonwood Community Library</p><h1>Volunteer handbook</h1><p class="lead">Your companion for ChatGPT, library tools and everyday website work.</p><p>Reviewed {reviewed}. Latest guide: <a href={academyUrl}>{academyUrl}</a></p><p>This is public training material. Keep the board’s private account handoff separately.</p><button class="button primary" data-print hidden>Print or save a PDF</button><p class="screen-only small">Print on Letter or A4 paper. Turn browser headers/footers off. All lesson text and answers are included.</p><ol>{lessons.map(lesson => <li><a href={`#${lesson.slug}`}>{lesson.title}</a></li>)}</ol></header>
  {lessons.map((lesson, index) => <article class="print-lesson" id={lesson.slug}><p class="eyebrow">Lesson {index + 1}</p><h2 class="print-title">{lesson.title}</h2><LessonBody lesson={lesson} print /></article>)}
</AcademyLayout>
