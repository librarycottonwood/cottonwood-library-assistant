---
// Service View (Figma 1012:1243): one regular program (Story Time, reading groups) beside its photo, the map and
// borrowing questions. Built only from src/components/site. Programs and questions come from Sanity.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/site/Button.astro';
import DetailList from '../../components/site/DetailList.astro';
import Faq from '../../components/site/Faq.astro';
import MapCard from '../../components/site/MapCard.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import Section from '../../components/site/Section.astro';
import Split from '../../components/site/Split.astro';
import Stack from '../../components/site/Stack.astro';
import Text from '../../components/site/Text.astro';
import { mainNavigation, supportLink } from '../../components/site/navigation';
import { contentRepository } from '../../content/repository';
import type { LibraryImage, Program } from '../../content/types';
export async function getStaticPaths() {
  const { programs } = await contentRepository.getHome();
  return programs.map(program => ({ params: { slug: program.id }, props: { program } }));
}
interface Props { program: Program; }
const { program } = Astro.props;
const { library, borrowing } = await contentRepository.getHome();
const services = mainNavigation.find(link => link.href === '/services/')!;
// Page photos from Figma. Programs without one show their Sanity picture whole (the reading groups' are posters).
const photos: Record<string, LibraryImage> = {
  'story-time': { key: 'storyTimeCorner', alt: 'The Story Time corner: a bright alphabet rug, bookshelves, a reading chair and a globe by the window.' },
};
const photo = photos[program.id] ?? { ...program.image, fit: 'contain' };
// "Wednesdays · 11:30 a.m." reads as Figma's "Wednesdays at 11:30 a.m."
const when = program.schedule.replace(' · ', ' at ') + (/[.!?]$/.test(program.schedule) ? '' : '.');
---
<BaseLayout title={`${program.title} | Cottonwood Community Library`} description={`${program.description} ${program.schedule}`}>
  <PageTitle title={program.title} trail={[services]} />
  {/* Figma leaves this panel empty; it holds the program's details and When/Where. */}
  <Split media="start" panel ratio="16 / 9" image={photo}>
    <DetailList label={`${program.title} schedule`} items={[{ label: 'When', value: program.schedule }, { label: 'Where', value: library.address }]} />
    {program.details && <Text tone="muted">{program.details}</Text>}
  </Split>
  <Section align="start">
    <Text tone="muted" size="lead">{`${program.description} ${when}`}</Text>
    <Stack direction="row" gap="xs" wrap>
      <Button href={library.directionsUrl} data-analytics-event="directions_click" variant="accent" icon="navigate">Get directions</Button>
      <Button href={library.catalogUrl} icon="book">Browse the catalog</Button>
      <Button href={supportLink.href} variant="primary" icon="heart">Donate</Button>
    </Stack>
  </Section>
  <Section title="Find us" headingId="map-heading">
    <MapCard library={library} />
  </Section>
  {borrowing.length > 0 && <Section title="Frequently Asked Questions" headingId="questions-heading" width="text" id="questions">
    <Faq items={borrowing} />
  </Section>}
</BaseLayout>
