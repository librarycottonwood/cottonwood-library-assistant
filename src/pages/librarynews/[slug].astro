---
import ContentImage from '../../components/ContentImage.astro';
import RichText from '../../components/RichText.astro';
import EventAgenda from '../../components/EventAgenda.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { postDate } from '../../content/feeds';
import { checkoutAttributes, getDonateLink } from '../../content/donate';
import { contentRepository } from '../../content/repository';
import type { Program, LibraryPost } from '../../content/types';
export async function getStaticPaths() {
  const [{ programs }, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getPosts()]);
  return [
    ...programs.map(program => ({ params: { slug: program.id }, props: { program, post: undefined } })),
    ...posts.filter(post => post.id !== 'newsletter').map(post => ({ params: { slug: post.id }, props: { post, program: undefined } })),
  ];
}
interface Props { program?: Program; post?: LibraryPost; }
const { program, post } = Astro.props;
const { library, programs, hero } = await contentRepository.getHome();
const relatedEvents = post?.eventIds?.length ? (await contentRepository.getEvents()).filter(event => event.documentId && post.eventIds!.includes(event.documentId)) : [];
const donate = await getDonateLink();
---
{program && <SiteLayout title={`${program.title} | Cottonwood Community Library`} description={program.description}>
  <PageIntro title={program.title} back={{ href: '/librarynews/', label: 'Events & news' }} />
  <section class="container section pt-0" aria-label={`${program.title} details`}>
    <div class="split-equal">
      <div class="split-media"><ContentImage image={program.image} variant="feature" eager /></div>
      <div class="panel">
        <dl class="space-y-5">
          <div><dt class="flex items-center gap-2 text-sm font-semibold"><Icon name="calendar" class="size-5" />When</dt><dd class="m-0 mt-1 text-xl font-semibold">{program.schedule}</dd></div>
          <div><dt class="flex items-center gap-2 text-sm font-semibold"><Icon name="pin" class="size-5" />Where</dt><dd class="m-0 mt-1 text-lg">{library.address}, {library.locality}</dd></div>
        </dl>
        <p class="mt-6 border-t border-forest/15 pt-5 text-base">{program.details}</p>
        <p class="mt-3 text-sm text-muted">Call <a href={library.phoneHref} class="underline">{library.phone}</a> to check for holiday changes or cancellations.</p>
        <a href={library.directionsUrl} class="button button-primary mt-6 self-start">Get directions</a>
      </div>
    </div>
  </section>
  <section class="section section-tint" aria-labelledby="more-programs">
    <div class="container">
      <h2 id="more-programs" class="section-heading section-header">More at the library</h2>
      <div class="card-grid">{programs.filter(other => other.id !== program.id).map(other => <ProgramCard program={other} />)}</div>
    </div>
  </section>
</SiteLayout>}

{post && <SiteLayout title={`${post.title} | Cottonwood Community Library`} description={post.summary}>
  <PageIntro title={post.title} meta={postDate(post)} back={{ href: '/librarynews/#news', label: 'Events & news' }} width="prose" />
  <article class="container-prose section pt-0">
    <ContentImage image={post.image ?? hero.image} variant="feature" eager />
    <div class="prose-flow mt-12 text-lg">{post.body ? <RichText blocks={post.body} /> : post.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
    {post.gallery && <PhotoGallery images={post.gallery} />}
    {relatedEvents.length > 0 && <section class="mt-12" aria-labelledby="related-events-heading"><h2 id="related-events-heading" class="card-heading mb-6">Related events</h2><EventAgenda events={relatedEvents} programs={programs} fallbackImage={hero.image} emptyMessage="These events have ended." /></section>}
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a href={donate.href} {...checkoutAttributes(donate)} class="button button-primary"><Icon name="heart" class="size-5" />Support your library</a>
      {post.externalUrl && <a href={post.externalUrl} class="text-link">Read at {post.sourceLabel ?? 'the source'}<Icon name="external" class="size-4" /></a>}
    </div>
  </article>
</SiteLayout>}
