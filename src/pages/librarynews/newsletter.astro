---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import { contentRepository } from '../../content/repository';
import { resolveImage } from '../../content/images';
const { newsletter } = await contentRepository.getHome();
---
<SiteLayout title={`${newsletter.issue} newsletter | Cottonwood Community Library`} description={newsletter.summary}>
  <PageIntro title={`${newsletter.issue} newsletter`} description={newsletter.summary} back={{ href: '/librarynews/', label: 'Events & news' }} width="prose" />
  <article class="container-prose section pt-0">
    <a href={newsletter.fileUrl} class="button button-primary">Read the newsletter (PDF)<Icon name="download" class="size-4" /></a>
    <div class="mt-12 max-w-sm rounded-[4px] bg-[#e1d9c4] p-6 sm:p-8"><Image width={600} quality={70} src={resolveImage(newsletter.cover.key)} alt={newsletter.cover.alt} widths={[350, 600]} sizes="(max-width: 639px) 80vw, 320px" class="h-auto w-full shadow-md" /></div>
  </article>
</SiteLayout>
