---
import Image from '../../components/OptimizedImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { contentRepository } from '../../content/repository';
const { newsletter } = await contentRepository.getHome();
const archives = (await contentRepository.getNewsletters()).filter(issue => issue.id !== newsletter?.id);
---
<SiteLayout title={`${newsletter?.issue ?? 'Library'} newsletter | Cottonwood Community Library`} description={newsletter?.summary}>
  <PageIntro title={newsletter ? `${newsletter.issue} newsletter` : 'Library newsletter'} description={newsletter?.summary} back={{ href: '/librarynews/', label: 'Events & news' }} width="prose" />
  <article class="container-prose section pt-0">
    {newsletter ? <>
      <a href={newsletter.fileUrl} class="button button-primary">Read the newsletter (PDF)<Icon name="download" class="size-4" /></a>
      <div class="mt-12 max-w-sm rounded-[4px] bg-[#e1d9c4] p-6 sm:p-8"><Image width={600} quality={70} image={newsletter.cover} alt={newsletter.cover.alt} widths={[350, 600]} sizes="(max-width: 639px) 80vw, 320px" class="h-auto w-full shadow-md" /></div>
    </> : <p class="text-base text-muted">No newsletter has been published yet.</p>}
    <NewsletterSignup />
    {archives.length > 0 && <section class="mt-16" aria-labelledby="archive-heading"><h2 id="archive-heading" class="card-heading">Earlier newsletters</h2><ul class="mt-4 space-y-3">{archives.map(issue => <li><a href={`/newsletters/${issue.id}/`} class="text-link">{issue.issue}</a></li>)}</ul></section>}
  </article>
</SiteLayout>
