---
import Image from '../../components/OptimizedImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventAgenda from '../../components/EventAgenda.astro';
import PostFeed from '../../components/PostFeed.astro';
import { contentRepository } from '../../content/repository';
const [{ programs, hero }, events, posts] = await Promise.all([contentRepository.getHome(), contentRepository.getEvents(), contentRepository.getPosts()]);
// "Wednesdays · 11:30 a.m." → day and time, so each regular program states both plainly.
const when = (schedule: string) => { const [day, ...time] = schedule.split(' · '); return { day, time: time.join(' · ') }; };
---
<SiteLayout title="Events & news | Cottonwood Community Library">
  <PageIntro title="Events & news" width="prose" />
  <section class="container-prose section pt-0" aria-labelledby="events-heading">
    <h2 id="events-heading" class="section-heading section-header">Upcoming events</h2>
    <EventAgenda events={events} programs={programs} fallbackImage={hero.image} />
  </section>
  <section id="regular" tabindex="-1" class="section section-tint" aria-labelledby="regular-heading">
    <div class="container-prose">
      <h2 id="regular-heading" class="section-heading section-header">Regular programs</h2>
      <ul class="m-0 list-none border-b border-line p-0">
        {programs.map(program => { const { day, time } = when(program.schedule); return <li class="agenda-day">
          <p class="agenda-date"><span class="font-semibold">{day}</span>{time && <span class="mt-1 block font-sans text-base tracking-normal">{time}</span>}</p>
          <div class="agenda-item">
            <Image width={208} quality={70} image={program.image} alt="" widths={[144, 208]} sizes="(max-width: 639px) 72px, 104px" class:list={['thumb', program.image.fit === 'contain' && 'object-contain p-1.5']} loading="lazy" />
            <div>
              <h3 class="text-xl font-semibold leading-snug"><a href={`/librarynews/${program.id}/`} class="underline decoration-1 underline-offset-4 hover:decoration-2">{program.title}</a></h3>
              <p class="mt-1 text-base text-muted">{program.description}</p>
            </div>
          </div>
        </li>; })}
      </ul>
    </div>
  </section>
  <section id="news" tabindex="-1" class="container-prose section" aria-labelledby="news-heading">
    <h2 id="news-heading" class="section-heading section-header">News</h2>
    <PostFeed posts={posts} fallbackImage={hero.image} />
  </section>
</SiteLayout>
