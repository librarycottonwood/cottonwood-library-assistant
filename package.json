{
  "name": "cottonwood-library-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/design-system.mjs check && node --test scripts/design-system.test.mjs scripts/newsletter.test.mjs scripts/photography.test.mjs scripts/seo.test.mjs scripts/accessibility.test.mjs && astro check",
    "design:docs": "node scripts/design-system.mjs docs",
    "release:capture": "node scripts/capture.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "image:prepare": "node scripts/images.mjs prepare",
    "cms:seed": "node scripts/cms.mjs seed",
    "cms:snapshot": "node scripts/cms.mjs snapshot",
    "cms:verify": "node scripts/cms.mjs verify",
    "cms:import": "node scripts/cms.mjs import",
    "cms:doctor": "node scripts/cms.mjs doctor",
    "cms:test": "node --test scripts/cms*.test.mjs",
    "studio:dev": "pnpm --dir studio dev"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/bree-serif": "5.3.0",
    "@lucide/astro": "1.47.0",
    "astro": "7.3.3",
    "maplibre-gl": "6.6.0",
    "motion": "14.9.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@types/node": "24.10.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
