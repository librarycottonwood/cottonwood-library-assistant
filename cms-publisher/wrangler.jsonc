{
  "name": "cottonwood-library-cms-publisher",
  "account_id": "e05729fd6b6fad329e31896d8b1c2da9",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {"enabled": false},
  // Library-owned trial service. No custom/public library domain or paid resource.
  "vars": {
    "PUBLIC_ORIGIN": "https://cottonwood-library-cms-publisher.librarycottonwood.workers.dev",
    "SANITY_PROJECT_ID": "2ou0xy2r",
    "SANITY_DATASET": "production",
    "PREVIEW_HOST_SUFFIX": "cottonwood-library-trial-preview.pages.dev"
  },
  "secrets": {"required": ["SANITY_WEBHOOK_SECRET", "GITHUB_DISPATCH_TOKEN", "CMS_WORKFLOW_TOKEN", "CMS_STATUS_TOKEN", "REVIEW_GITHUB_CLIENT_ID", "REVIEW_GITHUB_CLIENT_SECRET", "REVIEW_SESSION_SECRET"]},
  "durable_objects": {
    "bindings": [{"name": "CMS_LEDGER", "class_name": "CmsLedger"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CmsLedger"]}]
}
